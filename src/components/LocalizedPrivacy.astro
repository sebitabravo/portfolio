      heading: "6. Your ARCO Rights (Chile)",
      introLead: "Chilean law protects your personal data. Under ",
      law1: "Law 19.628",
      law1Note: " (currently in force)",
      mid: " and ",
      law2: "Law 21.719",
      law2Note: " (effective December 1, 2026), you have the following ARCO rights:",
      bullets: [
        {
          term: "Access",
          detail: "request information about what personal data we are processing",
        },
        {
          term: "Rectification",
          detail: "request correction of inaccurate or incomplete data",
        },
        {
          term: "Cancellation",
          detail: "request deletion of your personal data",
        },
        {
          term: "Opposition",
          detail: "object to the processing of your personal data",
        },
      ],
      outro:
        "Since this site does not actively collect personal data, we do not maintain visitor records that can be associated with an identified or identifiable person. If you believe your data has been processed in a manner contrary to law, please contact us at the email address in Section 1 and we will resolve your request promptly.",
    },
    gdpr: {
      heading: "5. Your GDPR Rights (European Visitors)",
      introLead: "If you are located in the European Economic Area (EEA), the ",
      introStrong: "General Data Protection Regulation (GDPR)",
