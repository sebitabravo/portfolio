---
import SectionContainer from "@/components/SectionContainer.astro"

interface Props {
  id: string
  headingId: string
  tone?: "base" | "tinted" | "inverted"
  class?: string
}

const { id, headingId, tone = "base", class: className, ...attributes } = Astro.props
---

<div
  class:list={[
    "section-band relative isolate w-full",
    { "section-band-tinted bg-surface-soft": tone === "tinted", "section-band-inverted": tone === "inverted" },
    className,
  ]}
  data-section-band={tone}
>
  <div class="frame section-frame">
    <span class="frame-node frame-node-tl" aria-hidden="true"></span>
    <span class="frame-node frame-node-tr" aria-hidden="true"></span>
    <SectionContainer id={id} headingId={headingId} {...attributes}>
      <slot />
    </SectionContainer>
  </div>
</div>
