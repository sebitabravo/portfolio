---
// Fondo vectorial del escritorio: cielo, sol a franjas y crestas generadas en build.
import { createRandom, createRidgelines } from "@/lib/ridgelines"

const width = 1600
const height = 1000
const horizon = 585
const ridgelines = createRidgelines({ width, height, horizon, rows: 22, samples: 72, seed: 2026 })
const random = createRandom(86)
const stars = Array.from({ length: 46 }, () => ({
  x: Math.round(random() * width),
  y: Math.round(random() * (horizon - 140)),
  r: (0.6 + random() * 1.3).toFixed(1),
  delay: (random() * 4).toFixed(1),
}))
// El sol se corta con franjas cada vez más gruesas hacia el horizonte, como en un póster de 1986.
const sunStripes = [0, 1, 2, 3, 4, 5, 6].map((index) => ({ y: 432 + index * 23, h: 2 + index * 2.6 }))
---

<svg
  class="os-wallpaper-svg"
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="wp-sky" x1="0" y1="0" x2="0" y2={horizon} gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#05050a"></stop>
      <stop offset="0.45" stop-color="#140c2e"></stop>
      <stop offset="0.8" stop-color="#3a1458"></stop>
      <stop offset="1" stop-color="#b23a8a"></stop>
    </linearGradient>
    <linearGradient id="wp-sun" x1="0" y1="350" x2="0" y2={horizon} gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#f2c12e"></stop>
      <stop offset="0.55" stop-color="#f08a2b"></stop>
      <stop offset="1" stop-color="#ff4fd8"></stop>
    </linearGradient>
    <linearGradient id="wp-ridge" x1="0" y1={horizon - 60} x2="0" y2={height} gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#ffb38a"></stop>
      <stop offset="0.35" stop-color="#ff4fd8"></stop>
      <stop offset="1" stop-color="#8e62e8"></stop>
    </linearGradient>
    <radialGradient id="wp-glow" cx="800" cy={horizon} r="620" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#ff4fd8" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#ff4fd8" stop-opacity="0"></stop>
    </radialGradient>
    <mask id="wp-sun-mask">
      <rect x="0" y="0" width={width} height={height} fill="#fff"></rect>
      {sunStripes.map((stripe) => <rect x="500" y={stripe.y} width="600" height={stripe.h} fill="#000" />)}
    </mask>
  </defs>
  <rect width={width} height={horizon + 4} fill="url(#wp-sky)"></rect>
  <g class="os-wallpaper-stars" fill="#f3efe6">
    {stars.map((star) => <circle cx={star.x} cy={star.y} r={star.r} style={`--twinkle:${star.delay}s`} />)}
  </g>
  <ellipse cx="800" cy={horizon} rx="760" ry="230" fill="url(#wp-glow)"></ellipse>
  <circle class="os-wallpaper-sun" cx="800" cy="440" r="190" fill="url(#wp-sun)" mask="url(#wp-sun-mask)"></circle>
  <g fill="#07060d" stroke="url(#wp-ridge)" stroke-linejoin="round">
    {ridgelines.map((line) => <path d={line.d} stroke-width={(0.7 + line.depth * 1.1).toFixed(2)} />)}
  </g>
</svg>
