---
import { getAboutMe } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import { homeSectionFragment } from "@/lib/home-sections"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const aboutMe = getAboutMe(locale)
const t = getTranslations(locale)
const contactId = homeSectionFragment(locale, "contact")
---

<div
  class="about-layout grid grid-cols-1 items-start gap-[clamp(2rem,6vw,5rem)] md:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)]"
>
  <article
    data-animate
    data-animate-delay="1"
    class="about-copy flex max-w-[45rem] flex-col gap-4 text-base leading-[1.65] text-foreground/86"
  >
    <p class="about-lede text-[clamp(1.08rem,2vw,1.3rem)] leading-[1.5] text-foreground">{aboutMe.intro}</p>
    <p>{aboutMe.personal}</p>
    <p class="about-signature font-code text-[0.92rem] font-semibold tracking-[-0.01em] text-hero-accent-strong">
      {aboutMe.signature}
    </p>

    <div class="about-interests mt-4 border-t border-hero-line pt-5">
      <h3 class="mb-[0.8rem] text-xl leading-[1.1] tracking-[-0.04em]">{aboutMe.interestsTitle}</h3>
      <ul class="grid grid-cols-1 gap-x-4 gap-y-[0.55rem] md:grid-cols-2">
        {
          aboutMe.interests.map((interest) => (
            <li class="flex items-baseline gap-[0.55rem] text-[0.9rem] text-foreground/78">
              <span
                aria-hidden="true"
                class="size-[0.38rem] flex-none rounded-full bg-hero-accent shadow-interest-dot"
              />
              {interest}
            </li>
          ))
        }
      </ul>
    </div>
  </article>

  <div
    data-animate
    data-animate-delay="2"
    class="about-focus section-card flex flex-col gap-[0.8rem] p-[clamp(1.35rem,3vw,2rem)]"
  >
    <p class="about-focus-index font-code text-[0.68rem] tracking-[0.12em] text-hero-accent uppercase">
      ABOUT / {locale.toUpperCase()}
    </p>
    <h3 class="mb-[0.8rem] text-xl leading-[1.1] tracking-[-0.04em]">{t.about.focusTitle}</h3>
    <p class="text-[0.95rem] leading-[1.6] text-foreground/82">{aboutMe.lookingFor}</p>
    <a
      href={contactId}
      class="about-cta inline-flex min-h-[2.75rem] w-fit items-center gap-[0.55rem] rounded-[0.55rem] border border-primary/55 bg-primary px-[0.85rem] py-[0.6rem] text-[0.78rem] font-bold text-primary-foreground shadow-cta focus-ring transition-all duration-[180ms] ease-[ease] hover:-translate-y-0.5 hover:bg-primary/90 hover:shadow-cta-hover"
    >
      <span>{t.about.contactCta}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</div>
