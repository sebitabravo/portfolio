---
import { Picture } from "astro:assets"
import type { CarouselCertification } from "@/types"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  certifications: CarouselCertification[]
  locale?: Locale
}

const { certifications, locale = "es" } = Astro.props
const t = getTranslations(locale)

// La segunda copia permite el desplazamiento continuo sin saltos.
const duplicatedCerts = [...certifications, ...certifications]
---

<div
  class="cert-carousel-container relative w-full overflow-hidden py-8"
  id="certCarouselContainer"
  role="region"
  aria-label={t.certifications.carouselLabel}
>
  <button
    class="cert-nav-btn cert-nav-prev absolute top-1/2 left-2 z-10 flex h-11 w-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-transparent text-foreground"
    id="certNavPrev"
    aria-label={t.certifications.previous}
    type="button"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg
    >
  </button>

  <div class="cert-carousel-wrapper mx-14 scrollbar-hidden overflow-x-auto" id="certCarouselWrapper">
    <div class="cert-carousel flex w-fit gap-6 md:gap-8" id="certCarousel">
      {
        duplicatedCerts.map((cert, index) => {
          const { name, organization, logo, pdfUrl, category } = cert.data
          const isDuplicate = index >= certifications.length

          return (
            <a
              href={pdfUrl ?? undefined}
              target="_blank"
              rel="noopener noreferrer"
              class="cert-item flex w-[240px] shrink-0 flex-col items-start gap-3 py-4 font-text no-underline outline-none md:w-[280px]"
              title={pdfUrl ? `${name} - ${organization}` : name}
              aria-hidden={isDuplicate ? "true" : undefined}
              tabindex={isDuplicate ? "-1" : pdfUrl ? undefined : "-1"}
              data-duplicate={isDuplicate ? "true" : undefined}
              role={pdfUrl ? undefined : "presentation"}
            >
              {logo && (
                <Picture
                  src={logo}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  alt={organization}
                  class="cert-logo h-10 w-10 object-contain grayscale"
                  width={40}
                  height={40}
                  densities={[1, 2]}
                  fit="contain"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="cert-name text-base leading-[1.4] font-semibold text-foreground">{name}</span>
              <span class="cert-org text-sm leading-[1.5] text-muted-foreground">{organization}</span>
              {category === "professional" && (
                <span class="cert-category text-sm text-muted-foreground">{t.certifications.professional}</span>
              )}
              {category === "academic" && (
                <span class="cert-category text-sm text-muted-foreground">{t.certifications.academic}</span>
              )}
            </a>
          )
        })
      }
    </div>
  </div>

  <button
    class="cert-nav-btn cert-nav-next absolute top-1/2 right-2 z-10 flex h-11 w-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-transparent text-foreground"
    id="certNavNext"
    aria-label={t.certifications.next}
    type="button"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg
    >
  </button>
</div>

<style>
  .cert-item,
  .cert-nav-btn {
    transition: color 180ms ease;
  }

  .cert-item:hover .cert-name,
  .cert-nav-btn:hover {
    color: hsl(var(--signal));
  }

  .cert-item:focus-visible {
    outline: 2px solid hsl(var(--signal));
    outline-offset: 2px;
  }

  .cert-nav-btn:focus-visible {
    outline: 1px solid hsl(var(--hairline));
    outline-offset: 2px;
  }

  /* Sin movimiento se muestran todos los títulos sin repetir enlaces. */
  @media (prefers-reduced-motion: reduce) {
    .cert-carousel-container,
    .cert-carousel-wrapper {
      overflow: visible;
    }

    .cert-carousel-wrapper {
      margin-inline: 0;
    }

    .cert-carousel-wrapper,
    .cert-carousel {
      width: 100%;
    }

    .cert-carousel {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }

    .cert-item {
      width: min(100%, 280px);
    }

    .cert-item[data-duplicate="true"],
    .cert-nav-btn {
      display: none;
    }
  }
</style>

<script>
  import { initCertCarousel } from "@/scripts/cert-carousel"

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCertCarousel, { once: true })
  } else {
    initCertCarousel()
  }
  document.addEventListener("astro:page-load", initCertCarousel)
</script>
