      },
    ],
    linksOutro:
      "No tenemos control sobre el contenido ni las prácticas de privacidad de estos sitios. Te recomendamos revisar sus respectivas políticas de privacidad al visitarlos.",
    arco: {
      heading: "5. Derechos ARCO (Chile)",
      introLead: "La legislación chilena protege tus datos personales. De acuerdo a la ",
      law1: "Ley 19.628",
      law1Note: " (vigente)",
      mid: " y la ",
      law2: "Ley 21.719",
      law2Note: " (vigente a partir del 1 de diciembre de 2026), tienes los siguientes derechos ARCO:",
      bullets: [
        {
          term: "Acceso",
          detail: "solicitar que te informemos qué datos personales nuestros estamos tratando",
        },
        {
          term: "Rectificación",
