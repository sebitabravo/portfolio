---
import { Picture } from "astro:assets"
import { formatDate } from "@/lib/utils"
import { getTranslations, type Locale } from "@/lib/i18n"
import type { ExperienceLogo } from "@/lib/data"

interface Props {
  company: string
  position: string
  description: string
  startDate: Date
  endDate?: Date | null
  current: boolean
  location?: string
  employmentType?: string
  skills: string[]
  logos?: ExperienceLogo[]
  url?: string
  highlights?: { label: string; value: string }[]
  locale?: Locale
  index?: number
}

const {
  company,
  position,
  description,
  startDate,
  endDate,
  current,
  location,
  employmentType,
  skills,
  logos,
  url,
  highlights = [],
  locale = "es",
  index = 0,
} = Astro.props
const t = getTranslations(locale)
const externalUrl = url?.startsWith("http")

const dateText = current
  ? t.work.currently
  : endDate
    ? `${formatDate(startDate, locale)} — ${formatDate(endDate, locale)}`
    : formatDate(startDate, locale)
---

<div
  data-animate
  data-animate-delay={String(index + 1)}
  class:list={["experience-item grid gap-6 pb-12 md:grid-cols-[minmax(10rem,1fr)_3fr] md:gap-12", { "experience-item-secondary": index > 0 }]}
>
  <div class="experience-meta text-sm leading-[1.6] text-muted-foreground">
    <time class="block">{dateText}</time>
    {location && <p>{location}</p>}
    {employmentType && <p class="experience-employment-type mt-2">{employmentType}</p>}
  </div>

  <div class="experience-description flex min-w-0 flex-col items-start gap-4">
    <div>
      <h3 class="experience-role text-[clamp(1.25rem,2vw,1.5rem)] leading-tight text-foreground">{position}</h3>
      <h4 class="mt-2 text-xl leading-6 text-primary">{company}</h4>
    </div>
    <p class="max-w-[60ch] text-[1.0625rem] leading-relaxed text-muted-foreground">{description}</p>

    {
      highlights.length > 0 && (
        <div class="experience-highlights flex flex-wrap gap-x-8 gap-y-4" aria-label={t.work.evidenceLabel}>
          {highlights.map((highlight) => (
            <div class="experience-highlight flex min-w-0 flex-col gap-1">
              <span>{highlight.label}</span>
              <strong class="text-base font-medium text-primary">{highlight.value}</strong>
            </div>
          ))}
        </div>
      )
    }

    {
      skills.length > 0 && (
        <div class="experience-skills flex flex-wrap gap-x-2 text-sm text-muted-foreground">
          {skills.map((skill, skillIndex) => (
            <>
              {skillIndex > 0 && <span aria-hidden="true">·</span>}
              <span>{skill}</span>
            </>
          ))}
        </div>
      )
    }

    {
      logos && logos.length > 0 && (
        <div class="flex flex-wrap items-center gap-4">
          {logos.map((logo) => (
            <a
              href={logo.url}
              target="_blank"
              rel="noopener noreferrer"
              title={logo.alt}
              aria-label={logo.alt}
              class="focus-ring flex size-12 items-center justify-center opacity-75 transition-opacity duration-200 hover:opacity-100"
            >
              <Picture
                src={logo.src}
                formats={["avif"]}
                fallbackFormat="webp"
                alt={logo.alt}
                width={48}
                height={48}
                densities={[1, 2]}
                fit="contain"
                loading="lazy"
                decoding="async"
                class="size-full object-contain grayscale"
              />
            </a>
          ))}
        </div>
      )
    }

    {
      url && (
        <a
          href={url}
          target={externalUrl ? "_blank" : undefined}
          rel={externalUrl ? "noopener noreferrer" : undefined}
          class="focus-ring inline-flex min-h-11 items-center gap-2 text-sm text-primary underline underline-offset-4"
        >
          {t.work.viewCaseStudy}
          <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      )
    }
  </div>
</div>

<style>
  .experience-item {
    font-family: var(--font-switzer);
  }

  .experience-role {
    font-family: var(--font-boska);
    font-weight: 500;
  }

  .experience-highlight span {
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
  }
</style>
