---
// Section Container — Superhuman generous spacing
// Max-width 1200px, clean sections
const { class: className, headingId, ...rest } = Astro.props
---

<section {...rest} aria-labelledby={headingId} class:list={["w-full mx-auto max-w-[1200px] scroll-mt-24 md:scroll-mt-28", className]}>
  <slot />
</section>
