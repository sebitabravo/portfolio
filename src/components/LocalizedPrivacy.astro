    analyticsIntro:
      "Este sitio no utiliza herramientas de analítica ni seguimiento. No hay píxeles de rastreo, scripts de medición de terceros ni experimentos A/B: las páginas son HTML estático servido sin instrumentación del lado del cliente.",
    analyticsListLead: "En concreto:",
    analyticsBullets: [
      {
        term: "Sin analítica",
        detail: "no se registran páginas vistas, eventos ni métricas de uso.",
      },
      {
        term: "Sin identificadores",
        detail: "no se generan ni almacenan identificadores de visitante.",
      },
      {
        term: "Sin terceros de medición",
        detail: "ningún script de analítica se carga en el navegador.",
      },
    ],
    analyticsNote:
      "Si en el futuro se incorporara alguna medición, será sin cookies y con datos agregados, y esta política se actualizará antes de activarla.",
    linksHeading: "4. Enlaces a Sitios Externos",
    linksLead: "Este sitio contiene enlaces a plataformas de terceros:",
    links: [
      {
        href: "https://github.com/sebitabravo",
        label: "GitHub",
        note: "— repositorios de código",
      },
      {
        href: "https://linkedin.com/in/sebitabravo",
        label: "LinkedIn",
