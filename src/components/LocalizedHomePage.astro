---
import Layout from "@/layouts/Layout.astro"
import { personalInfo } from "@/lib/data"
import { createStaticAlternates, getTranslations, type Locale } from "@/lib/i18n"
import { homeSectionIds } from "@/lib/home-sections"
import Hero from "@/components/Hero.astro"
import Projects from "@/components/Projects.astro"
import Experience from "@/components/Experience.astro"
import AboutMe from "@/components/AboutMe.astro"
import Education from "@/components/Education.astro"
import Certifications from "@/components/Certifications.astro"
import Contact from "@/components/Contact.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
const canonicalUrl = locale === "es" ? "https://sebita.dev" : "https://sebita.dev/en/"
const alternates = createStaticAlternates(locale, "https://sebita.dev", "https://sebita.dev/en/")
const ids = homeSectionIds[locale]
---

<Layout
  title={`${personalInfo.name} — ${personalInfo.title}`}
  locale={locale}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
>
  <main id="main-content">
    <Hero locale={locale} />

    <section id={ids.work} aria-labelledby={`h-${ids.work}`}>
      <h2 id={`h-${ids.work}`}>{t.nav.projects}</h2>
      <Projects locale={locale} />
    </section>

    <section id={ids.experience} aria-labelledby={`h-${ids.experience}`}>
      <h2 id={`h-${ids.experience}`}>{t.work.title}</h2>
      <Experience locale={locale} />
    </section>

    <section id={ids.about} aria-labelledby={`h-${ids.about}`}>
      <h2 id={`h-${ids.about}`}>{t.about.title}</h2>
      <AboutMe locale={locale} />
    </section>

    <section id={ids.formation} aria-labelledby={`h-${ids.formation}`}>
      <h2 id={`h-${ids.formation}`}>{t.nav.formation}</h2>
      <Education locale={locale} />
      <Certifications locale={locale} />
    </section>

    <section id={ids.contact} aria-labelledby={`h-${ids.contact}`}>
      <h2 id={`h-${ids.contact}`}>{t.nav.contact}</h2>
      <Contact locale={locale} />
    </section>
  </main>
</Layout>
