---
import { render, type CollectionEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import { personalInfo } from "@/lib/data"
import { getBlogImageUrl } from "@/lib/blog-image"
import { getProjectSocialImage } from "@/lib/portfolio-images"
import { createBlogAlternates } from "@/lib/blog-alternates"
import { getTranslations, type Locale } from "@/lib/i18n"
import { formatDate } from "@/lib/utils"
import { articleTitleTransitionName } from "@/scripts/transitions"

interface Props {
  locale: Locale
  post: CollectionEntry<"blog">
  isFallback?: boolean
  translationId?: string
}

const { locale, post, isFallback = false, translationId } = Astro.props
const { Content } = await render(post)
const isEnglish = locale === "en"
const t = getTranslations(locale)
const spanishUrl = `https://sebita.dev/blog/${post.id}`
const englishUrl = `https://sebita.dev/en/blog/${post.id}`
const canonicalUrl = isEnglish && !isFallback ? englishUrl : spanishUrl
const alternates = createBlogAlternates({ locale, postId: post.id, translationId, isFallback })
const optimizedImageUrl = await getBlogImageUrl(post.data.image)
const heroImage = getProjectSocialImage(post.data.image)
const heroImageWidth = heroImage && Math.min(heroImage.width, 1200)
const heroImageHeight = heroImage && heroImageWidth && Math.round((heroImage.height * heroImageWidth) / heroImage.width)
const imageUrl = optimizedImageUrl && new URL(optimizedImageUrl, "https://sebita.dev").toString()
const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  ...(imageUrl && { image: imageUrl }),
  datePublished: post.data.publishDate.toISOString(),
  author: {
    "@type": "Person",
    name: personalInfo.name,
    url: "https://sebita.dev",
  },
  publisher: {
    "@type": "Organization",
    name: personalInfo.name,
  },
}).replace(/</g, "\\u003c")
const homePath = isEnglish ? "/en" : "/"
const blogPath = isEnglish ? "/en/blog" : "/blog"
// Lectura estimada a 220 palabras por minuto sobre el MDX crudo.
const readingMinutes = Math.max(1, Math.round((post.body ?? "").split(/\s+/).filter(Boolean).length / 220))
---

<Layout
  title={`${post.data.title} - ${personalInfo.name}`}
  description={post.data.description}
  image={imageUrl}
  locale={locale}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
>
  <main id="main-content" class="blog-post frame">
    <nav class="blog-post-breadcrumb" aria-label={t.nav.breadcrumb}>
      <ol class="mono-label flex flex-wrap items-center gap-2 text-muted-foreground">
        <li><a href={homePath} class="transition-colors hover:text-foreground">{t.nav.home}</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={blogPath} class="transition-colors hover:text-foreground">{t.blog.title}</a></li>
        <li aria-hidden="true">/</li>
        <li lang={isFallback ? "es" : undefined} class="blog-post-crumb text-foreground" aria-current="page">
          {post.data.title}
        </li>
      </ol>
    </nav>

    <article lang={isEnglish ? (isFallback ? "es" : "en") : undefined}>
      <header class="blog-post-header" data-animate>
        {
          isEnglish && isFallback && (
            <aside lang={locale} class="blog-post-note mono-label" role="note">
              {t.blog.fallbackNotice}
            </aside>
          )
        }
        <p class="blog-post-meta mono-label">
          <span class="section-index">[{t.blog.kicker}]</span>
          <time lang={locale} datetime={post.data.publishDate.toISOString()} class="text-muted-foreground">
            {formatDate(post.data.publishDate, locale)}
          </time>
          <span aria-hidden="true">·</span>
          <span lang={locale}>{readingMinutes} {t.blog.readingTime}</span>
        </p>
        <h1 transition:name={articleTitleTransitionName(post.id)} class="blog-post-title">
          {post.data.title}
        </h1>
        <p class="blog-post-description">
          {post.data.description}
        </p>
        <p class="blog-post-tags">{post.data.tags.map((tag) => <span class="chip">{tag}</span>)}</p>
      </header>

      {
        optimizedImageUrl && heroImage && (
          <figure class="blog-post-figure os-window" data-animate>
            <span class="os-window-bar" aria-hidden="true">
              <span class="os-window-lights">
                <>
                  <span />
                  <span />
                  <span />
                </>
              </span>
              <span class="os-window-title">{post.id}.mdx</span>
            </span>
            <img
              src={optimizedImageUrl}
              alt={post.data.title}
              width={heroImageWidth}
              height={heroImageHeight}
              loading="eager"
              fetchpriority="high"
              class="aspect-video w-full object-cover object-top"
            />
          </figure>
        )
      }

      <div class="prose-custom blog-post-body">
        <Content />
      </div>
    </article>

    <footer class="blog-post-footer" data-animate>
      <nav class="flex flex-wrap items-center justify-between gap-4" aria-label={t.blog.postNavigation}>
        <a href={blogPath} class="btn btn-ghost focus-ring">
          {`← ${t.blog.back}`}
        </a>
        <a href={homePath} class="btn btn-solid focus-ring">
          {`${t.nav.home} →`}
        </a>
      </nav>
    </footer>
  </main>

  <script is:inline type="application/ld+json" set:html={articleJsonLd} />
</Layout>

<style>
  .blog-post {
    padding: 6.5rem clamp(1rem, 4vw, 3.5rem) clamp(4rem, 8vw, 7rem);
  }

  .blog-post-breadcrumb {
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .blog-post-crumb {
    max-width: 40ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .blog-post-header {
    max-width: 62rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .blog-post-note {
    margin: 0 0 1.5rem;
    line-height: 1.6;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .blog-post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0 0 1.5rem;
  }

  .blog-post-title {
    margin: 0 0 1.5rem;
    font-size: clamp(2.75rem, 6.5vw, 5.75rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .blog-post-description {
    max-width: 60ch;
    margin: 0 0 1.5rem;
    color: hsl(var(--muted-foreground));
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.55;
  }

  .blog-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }

  .blog-post-figure {
    max-width: 62rem;
    margin: 0 0 clamp(3rem, 6vw, 4.5rem);
  }

  .blog-post-body {
    max-width: 44rem;
  }

  .blog-post-footer {
    max-width: 44rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid hsl(var(--border));
  }

  @media (min-width: 1100px) {
    .blog-post-body,
    .blog-post-footer {
      margin-left: clamp(0rem, 8vw, 9rem);
    }
  }
</style>
