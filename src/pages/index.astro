---
/**
 * Portfolio de Sebastian Bravo - Frontend Developer
 *
 * Landing de conversión con estética Superhuman:
 * Hero → Proyectos → Experiencia → Educación → Certs → Sobre mí → Contacto
 */
import Layout from "@/layouts/Layout.astro"
import { personalInfo } from "@/lib/data"
import { getTranslations } from "@/lib/i18n"

const t = getTranslations('es')

// Components
import Hero from "@/components/Hero.astro"
import SignalStrip from "@/components/SignalStrip.astro"
import Experience from "@/components/Experience.astro"
import Projects from "@/components/Projects.astro"
import Education from "@/components/Education.astro"
import Certifications from "@/components/Certifications.astro"
import AboutMe from "@/components/AboutMe.astro"
import Contact from "@/components/Contact.astro"
import SectionBand from "@/components/SectionBand.astro"
import TitleSection from "@/components/TitleSection.astro"

// Icons
import BriefcaseIcon from "@/components/icons/Briefcase.astro"
import CodeIcon from "@/components/icons/Code.astro"
import GraduationCapIcon from "@/components/icons/GraduationCap.astro"
import CertificateIcon from "@/components/icons/Certificate.astro"
import ProfileCheckIcon from "@/components/icons/ProfileCheck.astro"
import MailIcon from "@/components/icons/Mail.astro"
---

<Layout
  title={`${personalInfo.name} — ${personalInfo.title}`}
  locale="es"
  canonicalUrl="https://sebita.dev"
  alternates={[
    { hreflang: 'es', href: 'https://sebita.dev' },
    { hreflang: 'en', href: 'https://sebita.dev/en/' },
    { hreflang: 'x-default', href: 'https://sebita.dev' },
  ]}
>
  <main id="main-content">
  <!-- Hero: midnight gradient, full-width -->
  <Hero locale="es" />

  <div class="home-sections">
      <!-- Proyectos -->
      <SectionBand id="proyectos" headingId="proyectos-heading">
        <TitleSection id="proyectos-heading" index={1} total={6}>
          <CodeIcon class="size-6" />
          {t.projects.title}
        </TitleSection>
        <Projects locale="es" />
      </SectionBand>

      <!-- Stack como textura después de la evidencia de proyectos -->
      <SignalStrip locale="es" />

      <!-- Experiencia -->
      <SectionBand id="experiencia" headingId="experiencia-heading" tone="tinted">
        <TitleSection id="experiencia-heading" index={2} total={6}>
          <BriefcaseIcon class="size-6" />
          {t.work.title}
        </TitleSection>
        <Experience locale="es" />
      </SectionBand>

      <!-- Educacion -->
      <SectionBand id="educacion" headingId="educacion-heading">
        <TitleSection id="educacion-heading" index={3} total={6}>
          <GraduationCapIcon class="size-6" />
          {t.education.title}
        </TitleSection>
        <Education locale="es" />
      </SectionBand>

      <!-- Certificaciones -->
      <SectionBand id="certificaciones" headingId="certificaciones-heading" tone="tinted" data-animate>
        <TitleSection id="certificaciones-heading" index={4} total={6}>
          <CertificateIcon class="size-6" />
          {t.certifications.title}
        </TitleSection>
        <Certifications locale="es" />
      </SectionBand>

      <!-- Sobre mi -->
      <SectionBand id="sobre-mi" headingId="sobre-mi-heading">
        <TitleSection id="sobre-mi-heading" index={5} total={6}>
          <ProfileCheckIcon class="size-6" />
          {t.about.title}
        </TitleSection>
        <AboutMe locale="es" />
      </SectionBand>

      <!-- Contacto -->
      <SectionBand id="contacto" headingId="contacto-heading">
        <TitleSection id="contacto-heading" index={6} total={6}>
          <MailIcon class="size-6" />
          {t.nav.contact}
        </TitleSection>
        <Contact locale="es" />
      </SectionBand>
  </div>
  </main>
</Layout>
