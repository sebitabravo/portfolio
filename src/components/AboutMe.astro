---
// Resolución — sobre mí (§3): perfil, stack como chips planos con logo monocromo (kv) y busco. El retrato ASCII fue
// cortado por el diseño (§10); el stack sale del data layer, no de strings sueltas.
import TechList from "@/components/TechList.astro"
import { getAboutMe, skills } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const about = getAboutMe(locale)

const stackRows: Array<{ label: string; items: string[] }> = [
  { label: t.about.stackFrontend, items: skills.frontend },
  { label: t.about.stackBackend, items: skills.backend },
  { label: t.about.stackData, items: skills.databases },
  { label: t.about.stackTools, items: skills.tools },
]
---

<div class="reveal">
  <div class="row">
    <div class="label">{t.about.profileLabel}</div>
    <div class="main">
      <p>{about.intro}</p>
      <p class="desc">{about.personal}</p>
    </div>
  </div>
  <div class="row">
    <div class="label">{t.about.stackLabel}</div>
    <div class="main">
      <dl class="kv">
        {
          stackRows.map(({ label, items }) => (
            <>
              <dt>{label}</dt>
              <dd>
                <TechList items={items} />
              </dd>
            </>
          ))
        }
      </dl>
    </div>
  </div>
  <div class="row">
    <div class="label">{t.about.seekingLabel}</div>
    <div class="main">
      <p>{about.lookingFor}</p>
    </div>
  </div>
</div>
