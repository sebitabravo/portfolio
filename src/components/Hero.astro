---
// El título permanece estático para proteger la pintura del LCP.
import { Image } from "astro:assets"
import { personalInfo } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import { homeSectionFragment } from "@/lib/home-sections"
import profileImage from "@/assets/perfil.jpeg"
import MailIcon from "./icons/Mail.astro"

interface Props {
  locale?: Locale
}

const { locale = 'es' } = Astro.props
const t = getTranslations(locale)
const contactUrl = homeSectionFragment(locale, 'contact')
const heroTitleId = `hero-title-${locale}`
---

<section
  class="hero-gradient group relative isolate w-full overflow-hidden text-hero-ink"
  aria-labelledby={heroTitleId}
  data-portfolio-motion
>
  <canvas class="hero-webgl" data-hero-webgl aria-hidden="true"></canvas>
  <div class="hero-stage-glow" aria-hidden="true"></div>
  <div class="hero-stage-grid" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-layout">
      <div class="hero-copy">
        <h1 id={heroTitleId} class="hero-title" aria-label="Sebastian Bravo">
          <span class="hero-title-name block">Sebastian</span>
          <span class="hero-title-name hero-title-accent block" data-text="Bravo">Bravo</span>
        </h1>
        <p class="hero-role hero-title-role">
          {t.hero.role}<span aria-hidden="true"> · </span>{t.hero.roleLocation}
        </p>
        <p class="hero-lede">{t.hero.intro}</p>
        <div class="hero-actions">
          <a href={contactUrl} class="hero-btn-primary focus-ring" aria-label={t.hero.contact}>
            <MailIcon class="size-4" />
            <span>{t.hero.contact}</span>
            <span class="hero-btn-arrow" aria-hidden="true">↗</span>
          </a>
          <a
            href="/cv/Sebastian_Bravo_CV.pdf"
            target="_blank"
            rel="noopener noreferrer"
            data-track-cv={locale}
            class="hero-cv-link focus-ring"
          >{t.hero.downloadCv}<span aria-hidden="true"> ↗</span></a>
        </div>
        <ul class="hero-meta" aria-label={t.hero.metaLabel}>
          {personalInfo.available && (
            <li class="hero-meta-status">
              <span class="hero-meta-pulse" aria-hidden="true"></span>
              {t.hero.available}
            </li>
          )}
          <li class="hero-meta-item">{t.hero.language}</li>
        </ul>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-art-frame group-data-[motion-status=active]:will-change-transform">
          <div class="hero-art-crosshair"></div>
          <div class="hero-orbit hero-orbit-one"></div>
          <div class="hero-portrait-shell">
            <Image
              src={profileImage}
              alt=""
              width={480}
              height={600}
              sizes="(max-width: 767px) 70vw, 32vw"
              format="webp"
              quality={90}
              loading="eager"
              fetchpriority="high"
              class="hero-portrait"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="hero-scroll-cue" aria-hidden="true"><span>{t.hero.scroll}</span><span>↓</span></div>
</section>

<script is:inline>
  // Bound startup even if the motion module claims the hero but never activates.
  // Keep this independent of dynamic imports and optional browser APIs.
  ;(() => {
    const root = document.querySelector("[data-portfolio-motion]")
    const canvas = root?.querySelector("[data-hero-webgl]")
    if (!root) return
    if (!root.dataset.motionStatus) root.dataset.motionStatus = "loading"
    if (canvas && !canvas.dataset.webglStatus) canvas.dataset.webglStatus = "pending"
    const timer = window.setTimeout(() => {
      if (root.dataset.motionStatus === "loading") root.dataset.motionStatus = "fallback"
      if (canvas?.dataset.webglStatus === "pending") canvas.dataset.webglStatus = "fallback"
    }, 3000)
    root.addEventListener("portfolio-motion:started", () => {
      window.clearTimeout(timer)
    }, { once: true })
  })()
</script>

<script>
  import { setupPortfolioMotion } from "@/scripts/portfolio-motion"

  const STARTUP_BOUND_MS = 3000

  // The claim resets status to loading, possibly after the inline bound already fired; bound it again.
  const claimMotion = () => {
    setupPortfolioMotion()
    const root = document.querySelector<HTMLElement>("[data-portfolio-motion]")
    if (root?.dataset.motionStatus !== "loading") return
    const canvas = root.querySelector<HTMLElement>("[data-hero-webgl]")
    const timer = setTimeout(() => {
      if (root.dataset.motionStatus === "loading") root.dataset.motionStatus = "fallback"
      if (canvas?.dataset.webglStatus === "pending") canvas.dataset.webglStatus = "fallback"
    }, STARTUP_BOUND_MS)
    root.addEventListener("portfolio-motion:started", () => clearTimeout(timer), { once: true })
  }

  // Motion is an enhancement: requesting its chunks before first paint competes with the LCP heading.
  const startWhenIdle = () => {
    // Two frames guarantee a paint has happened; the load event alone can precede the LCP paint.
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        if (typeof requestIdleCallback === "function") requestIdleCallback(claimMotion, { timeout: 1500 })
        else setTimeout(claimMotion, 200)
      }),
    )
  }
  if (document.readyState === "complete") startWhenIdle()
  else window.addEventListener("load", startWhenIdle, { once: true })
</script>
