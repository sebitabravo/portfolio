---
// LanguageToggle Component - Toggle between ES and EN
import LanguagesIcon from "./icons/Languages.astro"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = 'es' } = Astro.props
const currentLangCode = locale === 'es' ? 'ES' : 'EN'
const labels = {
  es: getTranslations('es').language.toggleLabel,
  en: getTranslations('en').language.toggleLabel,
}
const toggleLabel = labels[locale].replace('{code}', currentLangCode)
---

<div class="relative inline-block" id="language-toggle-wrapper" data-label-template-es={labels.es} data-label-template-en={labels.en}>
  <button
    id="language-toggle"
    type="button"
    class="inline-flex h-11 min-w-11 items-center justify-center gap-2 rounded-md px-2.5 py-2 text-sm font-medium text-current transition-colors hover:bg-[hsl(var(--muted))] dark:hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--primary))]"
    aria-label={toggleLabel}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="language-menu"
  >
    <LanguagesIcon class="size-4" />
    <span id="current-language">{locale === 'en' ? 'EN' : 'ES'}</span>
  </button>

  <div
    id="language-menu"
    class="hidden absolute left-1/2 -translate-x-1/2 mt-2 w-32 rounded-md shadow-lg bg-[hsl(var(--card))] ring-1 ring-black/5 dark:ring-white/10 z-[9999]"
    role="menu"
  >
    <div class="py-1">
      <button
        type="button"
        role="menuitemradio"
        aria-checked={locale === 'es' ? 'true' : 'false'}
        tabindex={locale === 'es' ? 0 : -1}
        data-lang="es"
        class="language-option flex items-center justify-between w-full px-4 py-2 text-sm text-[hsl(var(--foreground)/0.8)] hover:bg-[hsl(var(--muted)/0.5)] text-left"
      >
        <span>Español</span>
        <span class="check-es hidden" aria-hidden="true">✓</span>
      </button>
      <button
        type="button"
        role="menuitemradio"
        aria-checked={locale === 'en' ? 'true' : 'false'}
        tabindex={locale === 'en' ? 0 : -1}
        data-lang="en"
        class="language-option flex items-center justify-between w-full px-4 py-2 text-sm text-[hsl(var(--foreground)/0.8)] hover:bg-[hsl(var(--muted)/0.5)] text-left"
      >
        <span>English</span>
        <span class="check-en hidden" aria-hidden="true">✓</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { initLanguageToggle } from '@/scripts/language-toggle'

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLanguageToggle, { once: true })
  } else {
    initLanguageToggle()
  }
  document.addEventListener('astro:after-swap', initLanguageToggle)
</script>
