---
// ThemeToggle Component - Toggle between light, dark, and system theme
import { getTranslations, type Locale } from "@/lib/i18n"
import SunIcon from "./icons/Sun.astro"
import MoonIcon from "./icons/Moon.astro"
import MonitorIcon from "./icons/Monitor.astro"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
---

<div
  class="relative inline-block"
  id="theme-toggle-wrapper"
  data-i18n-light={t.theme.light}
  data-i18n-dark={t.theme.dark}
  data-i18n-system={t.theme.system}
>
  <button
    id="theme-toggle"
    type="button"
    class="inline-flex h-11 min-w-11 items-center justify-center gap-2 rounded-md px-2.5 py-2 text-sm font-medium text-current transition-colors hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:group-[:not(.scrolled)]:text-nav-glass-text-dark dark:hover:bg-white/10"
    aria-label={t.theme.toggle}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="theme-menu"
  >
    <SunIcon class="theme-icon-light hidden size-4" />
    <MoonIcon class="theme-icon-dark hidden size-4" />
    <MonitorIcon class="theme-icon-system size-4" />
    <span id="current-theme" class="hidden xl:inline">{t.theme.system}</span>
  </button>

  <div
    id="theme-menu"
    class="absolute left-1/2 z-[9999] mt-2 hidden w-48 min-w-max -translate-x-1/2 rounded-md bg-card shadow-lg ring-1 ring-black/5 dark:ring-white/10"
    role="menu"
  >
    <div class="py-1">
      <button
        type="button"
        role="menuitemradio"
        aria-checked="false"
        data-theme="light"
        class="theme-option flex w-full items-center justify-between px-4 py-2 text-left text-sm text-foreground/80 hover:bg-muted/50"
      >
        <span class="flex items-center gap-3">
          <SunIcon class="size-4" />
          {t.theme.light}
        </span>
        <span class="check-light hidden" aria-hidden="true">✓</span>
      </button>
      <button
        type="button"
        role="menuitemradio"
        aria-checked="false"
        data-theme="dark"
        class="theme-option flex w-full items-center justify-between px-4 py-2 text-left text-sm text-foreground/80 hover:bg-muted/50"
      >
        <span class="flex items-center gap-3">
          <MoonIcon class="size-4" />
          {t.theme.dark}
        </span>
        <span class="check-dark hidden" aria-hidden="true">✓</span>
      </button>
      <button
        type="button"
        role="menuitemradio"
        aria-checked="true"
        data-theme="system"
        class="theme-option flex w-full items-center justify-between px-4 py-2 text-left text-sm text-foreground/80 hover:bg-muted/50"
      >
        <span class="flex items-center gap-3">
          <MonitorIcon class="size-4" />
          {t.theme.system}
        </span>
        <span class="check-system hidden" aria-hidden="true">✓</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { initThemeToggle } from "@/scripts/theme-toggle"

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initThemeToggle, { once: true })
  } else {
    initThemeToggle()
  }

  document.addEventListener("astro:after-swap", initThemeToggle)
</script>
