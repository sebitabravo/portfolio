---
import { getEducation } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import { formatDate } from "@/lib/utils"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const education = getEducation(locale)
---

<div class="mt-8 flex flex-col gap-6">
  {
    education.map(({ institution, degree, description, startDate, endDate, current, location, grade, skills }, i) => (
      <article
        data-animate
        data-animate-delay={String(i + 1)}
        class="section-card rounded-2xl border border-parchment bg-card p-6 transition-all duration-300 hover:-translate-y-[2px] hover:shadow-card-hover"
      >
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h3 class="font-semibold text-foreground">{degree}</h3>
            <p class="mt-0.5 text-sm text-caption-color">{institution}</p>
          </div>
          <div class="shrink-0 text-left text-xs text-caption-color sm:text-right">
            <time>{formatDate(startDate, locale)}</time>
            <span> — </span>
            <time>{current ? t.education.present : endDate ? formatDate(endDate, locale) : ""}</time>
            {location && <p class="mt-0.5">{location}</p>}
            {grade && (
              <p class="mt-0.5 font-medium text-foreground/70">
                {t.education.grade}: {grade}
              </p>
            )}
          </div>
        </div>

        {description && <p class="mt-4 text-[0.95rem] leading-[1.60] text-foreground/85">{description}</p>}

        {skills && skills.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {skills.map((skill) => (
              <span class="tech-badge">{skill}</span>
            ))}
          </div>
        )}
      </article>
    ))
  }
</div>
