---
import { getEducation } from "@/lib/data"
import type { Locale } from "@/lib/i18n"
import type { Education } from "@/lib/data"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const entries: Education[] = getEducation(locale)

const year = (date: Date): string => String(date.getUTCFullYear())
---

<ul>
  {
    entries.map((entry) => (
      <li>
        <h3>{entry.institution}</h3>
        <p>
          <time datetime={year(entry.startDate)}>{year(entry.startDate)}</time> –{" "}
          <time datetime={year(entry.endDate ?? entry.startDate)}>{year(entry.endDate ?? entry.startDate)}</time>
        </p>
        <p>{entry.degree}</p>
        <p>{entry.description}</p>
      </li>
    ))
  }
</ul>
