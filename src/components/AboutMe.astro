---
import { getAboutMe } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = 'es' } = Astro.props
const aboutMe = getAboutMe(locale)
const t = getTranslations(locale)
const contactId = locale === 'es' ? '#contacto' : '#contact'
---

<div class="about-layout">
  <article data-animate data-animate-delay="1" class="about-copy">
    <p class="about-lede">{aboutMe.intro}</p>
    <p>{aboutMe.personal}</p>
    <p class="about-signature">{aboutMe.signature}</p>

    <div class="about-interests">
      <h3>{aboutMe.interestsTitle}</h3>
      <ul>
        {aboutMe.interests.map((interest) => (
          <li>
            <span aria-hidden="true"></span>
            {interest}
          </li>
        ))}
      </ul>
    </div>
  </article>

  <div data-animate data-animate-delay="2" class="about-focus section-card">
    <p class="about-focus-index">ABOUT / {locale.toUpperCase()}</p>
    <h3>{t.about.focusTitle}</h3>
    <p>{aboutMe.lookingFor}</p>
    <a href={contactId} class="about-cta focus-ring">
      <span>{t.about.contactCta}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</div>
