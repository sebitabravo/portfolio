---
import ArrowUpRight from "@/components/icons/ArrowUpRight.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import ProjectTile from "@/components/ProjectTile.astro"
import { getProjects } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import { homeSectionFragment } from "@/lib/home-sections"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const contactUrl = homeSectionFragment(locale, "contact")
const projects = getProjects(locale)
  .slice()
  .sort((projectA, projectB) => projectA.order - projectB.order)
const archiveNumber = String(projects.length + 1).padStart(2, "0")
---

<div class="projects-shell">
  <div class="project-outcomes" data-project-outcomes aria-labelledby={`project-outcomes-title-${locale}`}>
    <h3 id={`project-outcomes-title-${locale}`} class="project-outcomes-title mono-label">{t.projects.outcomesTitle}</h3>
    <ul class="project-outcomes-list">
      {
        t.projects.stats.map((stat) => (
          <li class="project-stat">
            <strong class="project-stat-value" data-count-to={stat.value}>{stat.value}</strong>
            <span class="project-stat-label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="project-grid" data-projects-list>
    {projects.map((project, index) => <ProjectTile project={project} index={index} locale={locale} />)}

    <a
      href="https://github.com/sebitabravo?tab=repositories"
      target="_blank"
      rel="noopener noreferrer"
      class="project-archive projects-github-link focus-ring"
      data-cursor-label="GitHub"
    >
      <span class="project-archive-head mono-label">
        <span class="section-index">[{archiveNumber}]</span>
        <span>~/repos</span>
      </span>
      <span class="project-archive-icon" aria-hidden="true"><GitHubIcon class="size-10" /></span>
      <span class="project-archive-title">{t.projects.archiveTitle}</span>
      <span class="project-archive-text">{t.projects.archiveText}</span>
      <span class="project-archive-cta">{t.projects.viewMoreGithub}<ArrowUpRight class="size-4 shrink-0" /></span>
    </a>
  </div>

  <div class="projects-contact-cta">
    <p>{t.projects.contactPrompt}</p>
    <a href={contactUrl} class="projects-contact-link focus-ring">
      <span>{t.projects.contactCta}</span><ArrowUpRight class="size-4 shrink-0" />
    </a>
  </div>
</div>

<script>
  import { setupProjects, teardownProjects } from "@/scripts/projects"

  setupProjects()
  document.addEventListener("astro:page-load", setupProjects)
  document.addEventListener("astro:before-swap", teardownProjects)
</script>
