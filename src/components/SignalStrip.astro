---
// Banda del stack: franjas arcoíris arriba y abajo, marquesina con pausa accesible.
import type { Locale } from "@/lib/i18n"
import { getTranslations } from "@/lib/i18n"
import { canonicalTechnologies } from "@/lib/data"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const label = t.signal.label
---

<div class="signal-strip" role="region" aria-label={label} data-marquee>
  <span class="rainbow-band rainbow-band-thin" aria-hidden="true"></span>
  <div class="signal-strip-inner">
    <p class="signal-strip-label meta-label">
      <span class="status-dot" aria-hidden="true"></span>
      <span>{label}</span>
    </p>
    <div class="signal-viewport">
      <div class="signal-track" data-marquee-track>
        <ul class="signal-technologies" role="list">
          {canonicalTechnologies.map((technology) => <li class="signal-tech">{technology}</li>)}
        </ul>
        <ul class="signal-technologies signal-technologies-clone" aria-hidden="true">
          {canonicalTechnologies.map((technology) => <li class="signal-tech">{technology}</li>)}
        </ul>
      </div>
    </div>
    <button
      type="button"
      class="signal-toggle focus-ring"
      data-marquee-toggle
      aria-label={t.signal.pause}
      data-label-pause={t.signal.pause}
      data-label-resume={t.signal.resume}
    >
      <span class="signal-toggle-icon" aria-hidden="true"></span>
    </button>
  </div>
  <span class="rainbow-band rainbow-band-thin signal-strip-band-bottom" aria-hidden="true"></span>
</div>

<style>
  .signal-strip {
    position: relative;
    overflow: hidden;
    background: hsl(var(--background));
  }

  .signal-strip-band-bottom {
    transform: scaleY(-1);
  }

  .signal-strip-inner {
    position: relative;
    display: grid;
    max-width: 90rem;
    min-height: 7.5rem;
    margin: 0 auto;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 1.25rem clamp(1rem, 4vw, 3.5rem);
  }

  .signal-strip-label {
    display: inline-flex;
    grid-column: 1 / -1;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
  }

  .signal-viewport {
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .signal-track {
    display: flex;
    width: max-content;
  }

  .signal-technologies {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .signal-tech {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    color: hsl(var(--foreground));
    font-family: var(--font-instrument), Georgia, serif;
    font-size: clamp(2rem, 4.2vw, 3.75rem);
    font-style: italic;
    line-height: 1.1;
    white-space: nowrap;
  }

  .signal-tech::after {
    width: 0.55rem;
    height: 0.55rem;
    background: hsl(var(--signal));
    transform: rotate(45deg);
    content: "";
  }

  .signal-toggle {
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid hsl(var(--line-strong));
    border-radius: 0.375rem;
    color: hsl(var(--foreground));
    transition: border-color 200ms ease;
  }

  .signal-toggle:hover {
    border-color: hsl(var(--foreground));
  }

  .signal-toggle-icon {
    width: 0.7rem;
    height: 0.8rem;
    border-inline: 3px solid currentColor;
  }

  .signal-strip[data-paused="true"] .signal-toggle-icon {
    width: 0;
    height: 0;
    border-block: 0.45rem solid transparent;
    border-inline: 0.75rem solid currentColor;
    border-inline-end: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .signal-track {
      animation: signal-marquee 48s linear infinite;
    }

    /* Leer el texto lo detiene; el botón queda fuera para que su hover o foco nunca anule "reanudar". */
    .signal-viewport:hover .signal-track,
    .signal-strip[data-paused="true"] .signal-track {
      animation-play-state: paused;
    }
  }

  /* Sin movimiento, el stack se ordena en filas y la copia desaparece. */
  @media (prefers-reduced-motion: reduce) {
    .signal-viewport {
      mask-image: none;
    }

    .signal-track,
    .signal-technologies {
      width: auto;
      flex-wrap: wrap;
    }

    .signal-technologies {
      gap: 0.4rem 0;
    }

    .signal-technologies-clone,
    .signal-toggle {
      display: none;
    }

    .signal-tech {
      font-size: clamp(1.5rem, 3vw, 2.25rem);
    }
  }

  @keyframes signal-marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>

<script>
  import { setupMarquee, teardownMarquee } from "@/scripts/marquee"

  setupMarquee()
  document.addEventListener("astro:page-load", () => setupMarquee())
  document.addEventListener("astro:before-swap", teardownMarquee)
</script>
