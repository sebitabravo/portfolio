---
import { getProjects, type Project } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import { getTechStyle } from "@/lib/tech-colors"
import { getTechIcon } from "@/lib/tech-icons-map"
import { projectGradient } from "@/lib/visual-gradients"
import GitHubIcon from "./icons/GitHub.astro"
import LinkIcon from "./icons/Link.astro"
import BookOpen from "./icons/BookOpen.astro"
import MailIcon from "./icons/Mail.astro"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const contactUrl = locale === "es" ? "#contacto" : "#contact"

const projects = getProjects(locale)
  .slice()
  .sort((projectA, projectB) => projectA.order - projectB.order)
const projectCount = String(projects.length).padStart(2, '0')

const statusLabels: Record<Project["status"], string> = {
  production: t.projects.statusProduction,
  development: t.projects.statusDevelopment,
  demo: t.projects.statusDemo,
}

const statusColors: Record<Project["status"], string> = {
  production: "project-status-production",
  development: "project-status-development",
  demo: "project-status-demo",
}
---

<div class="projects-shell">
  <div class="project-scroll-meter" data-project-scroll-meter aria-hidden="true">
    <span></span>
  </div>
  <div
    class="project-outcomes"
    data-project-outcomes
    aria-labelledby={`project-outcomes-title-${locale}`}
  >
    <div class="project-outcomes-heading">
      <p class="project-outcomes-kicker">{t.projects.outcomesLabel}</p>
      <h3 id={`project-outcomes-title-${locale}`}>{t.projects.outcomesTitle}</h3>
    </div>
    <ul class="project-outcomes-list">
      {t.projects.outcomes.map((outcome: string, index: number) => (
        <li>
          <span class="project-outcome-index" aria-hidden="true">0{index + 1}</span>
          <span>{outcome}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="project-grid" data-projects-list>
    {projects.map(({ slug, title, description, tags, liveUrl, githubUrl, featured, status, metrics, blogSlug }, i) => {
      const statusLabel = status ? statusLabels[status] : undefined
      const publicStatusLabel = !liveUrl && githubUrl ? t.projects.statusCodeAvailable : statusLabel
      const statusColor = status ? statusColors[status] : ""
      const publicStatusColor = !liveUrl && githubUrl ? "project-status-code" : statusColor
      const gradient = projectGradient(slug)
      const resolvedBlogSlug = blogSlug || slug
      const projectUrl = locale === 'en' ? `/en/blog/${resolvedBlogSlug}` : `/blog/${resolvedBlogSlug}`
      const visibleTags = tags.slice(0, 5)
      const visualStats = metrics?.slice(0, 2) ?? []
      const projectNumber = String(i + 1).padStart(2, '0')

      return (
        <article
          data-animate
          data-animate-delay={String((i % 4) + 1)}
          class:list={["project-card group", { "project-card-featured": featured }]}
          data-project-card
          data-project={slug}
          data-project-tags={tags.join(",")}
        >
          <div class="project-media" style={`background:${gradient};`}>
            <img
              src={`/screenshots/${slug}-800.webp`}
              srcset={`/screenshots/${slug}-800.webp 800w, /screenshots/${slug}-1600.webp 1600w`}
              sizes="(max-width: 767px) 100vw, (max-width: 1280px) 50vw, 800px"
              alt={`${title} screenshot`}
              width="800"
              height="500"
              class="project-image"
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
              data-img-fallback
            />
            <div class="project-media-shade" aria-hidden="true"></div>
            <div class="project-media-grid" aria-hidden="true"></div>
            <div class="project-media-topline">
              <span>{projectNumber} / {projectCount}</span>
              <span class:list={["project-media-status", publicStatusColor]}>{publicStatusLabel}</span>
            </div>
            <a href={projectUrl} class="project-media-link focus-ring" aria-label={`${title} — ${t.projects.readMore}`}>
              <span class="project-media-link-label">{t.projects.readMore} <span aria-hidden="true">↗</span></span>
            </a>
            <div class="project-media-title" aria-hidden="true">
              <span class="project-media-kicker">{featured ? t.projects.featured : 'PROJECT'}</span>
              <span class="project-media-name">{title}</span>
            </div>
          </div>

          <div class="project-body">
            <div class="project-heading-row">
              <div>
                <p class="project-eyebrow">{projectNumber} — {publicStatusLabel}</p>
                <h3>{title}</h3>
              </div>
              {featured && <span class="project-featured-mark" aria-hidden="true">✳</span>}
            </div>

            <p class="project-description">{description}</p>

            {visualStats.length > 0 && (
              <div class="project-metrics" aria-label={locale === 'es' ? 'Evidencia del proyecto' : 'Project evidence'}>
                {visualStats.map((metric) => (
                  <div class="project-metric">
                    <span>{metric.label}</span>
                    <strong>{metric.value}</strong>
                  </div>
                ))}
              </div>
            )}

            <div class="project-tags" aria-label={locale === 'es' ? 'Tecnologías' : 'Technologies'}>
              {visibleTags.map((tag) => {
                const style = getTechStyle(tag)
                const Icon = getTechIcon(tag)

                return (
                  <span class:list={["tech-badge project-tech-badge flex items-center gap-1.5", style.bg, style.border, style.text]}>
                    {Icon && <Icon class="size-3.5" />}
                    {tag}
                  </span>
                )
              })}
            </div>

            <footer class="project-actions">
              {githubUrl && (
                <a
                  href={githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track-project={slug}
                  data-track-action="code"
                  class="project-action project-action-secondary focus-ring"
                >
                  <GitHubIcon class="size-4" />
                  {t.projects.viewCode}
                </a>
              )}

              {liveUrl && (
                <a
                  href={liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track-project={slug}
                  data-track-action="live"
                  class="project-action project-action-secondary focus-ring"
                >
                  <LinkIcon class="size-4" />
                  {t.projects.viewProject}
                </a>
              )}

              <a
                href={projectUrl}
                data-track-project={slug}
                data-track-action="casestudy"
                class="project-action project-action-primary focus-ring"
              >
                <BookOpen class="size-4" />
                {t.projects.readMore}
              </a>
            </footer>
          </div>
        </article>
      )
    })}
  </div>

  <div class="projects-contact-cta">
    <p>{t.projects.contactPrompt}</p>
    <a href={contactUrl} class="projects-contact-link focus-ring">
      <MailIcon class="size-4" />
      <span>{t.projects.contactCta}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="projects-endcap">
    <span class="projects-endcap-line" aria-hidden="true"></span>
    <a
      href="https://github.com/sebitabravo?tab=repositories"
      target="_blank"
      rel="noopener noreferrer"
      class="projects-github-link focus-ring"
    >
      <GitHubIcon class="size-4" />
      {t.projects.viewMoreGithub}
      <span aria-hidden="true">↗</span>
    </a>
    <span class="projects-endcap-line" aria-hidden="true"></span>
  </div>
</div>

<script>
  import { setupProjects, teardownProjects } from "@/scripts/projects"

  setupProjects()
  document.addEventListener("astro:page-load", setupProjects)
  document.addEventListener("astro:before-swap", teardownProjects)
</script>
