---
// ThemeToggle Component - Toggle between light, dark, and system theme
import { getTranslations, type Locale } from "@/lib/i18n"
import SunIcon from "./icons/Sun.astro"
import MoonIcon from "./icons/Moon.astro"
import MonitorIcon from "./icons/Monitor.astro"

interface Props {
  locale?: Locale
}

const { locale = 'es' } = Astro.props
const t = getTranslations(locale)
---

<div
  class="relative inline-block"
  id="theme-toggle-wrapper"
  data-i18n-light={t.theme.light}
  data-i18n-dark={t.theme.dark}
  data-i18n-system={t.theme.system}
>
  <button
    id="theme-toggle"
    type="button"
    class="inline-flex h-11 min-w-11 items-center justify-center gap-2 rounded-md px-2.5 py-2 text-sm font-medium text-current transition-colors hover:bg-[hsl(var(--muted))] dark:hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--primary))]"
    aria-label={t.theme.toggle}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="theme-menu"
  >
    <SunIcon class="size-4 theme-icon-light hidden" />
    <MoonIcon class="size-4 theme-icon-dark hidden" />
    <MonitorIcon class="size-4 theme-icon-system" />
    <span id="current-theme" class="hidden xl:inline">{t.theme.system}</span>
  </button>

  <div
    id="theme-menu"
    class="hidden absolute left-1/2 -translate-x-1/2 mt-2 w-48 rounded-md shadow-lg bg-[hsl(var(--card))] ring-1 ring-black/5 dark:ring-white/10 z-[9999]"
    role="menu"
  >
    <div class="py-1">
      <button
        type="button"
        role="menuitemradio"
        aria-checked="false"
        data-theme="light"
        class="theme-option flex items-center justify-between w-full px-4 py-2 text-sm text-[hsl(var(--foreground)/0.8)] hover:bg-[hsl(var(--muted)/0.5)] text-left"
      >
        <span class="flex items-center gap-3">
          <SunIcon class="size-4" />
          {t.theme.light}
        </span>
        <span class="check-light hidden" aria-hidden="true">✓</span>
      </button>
      <button
        type="button"
        role="menuitemradio"
        aria-checked="false"
        data-theme="dark"
        class="theme-option flex items-center justify-between w-full px-4 py-2 text-sm text-[hsl(var(--foreground)/0.8)] hover:bg-[hsl(var(--muted)/0.5)] text-left"
      >
        <span class="flex items-center gap-3">
          <MoonIcon class="size-4" />
          {t.theme.dark}
        </span>
        <span class="check-dark hidden" aria-hidden="true">✓</span>
      </button>
      <button
        type="button"
        role="menuitemradio"
        aria-checked="true"
        data-theme="system"
        class="theme-option flex items-center justify-between w-full px-4 py-2 text-sm text-[hsl(var(--foreground)/0.8)] hover:bg-[hsl(var(--muted)/0.5)] text-left"
      >
        <span class="flex items-center gap-3">
          <MonitorIcon class="size-4" />
          {t.theme.system}
        </span>
        <span class="check-system hidden" aria-hidden="true">✓</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { initThemeToggle } from "@/scripts/theme-toggle"

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggle, { once: true })
  } else {
    initThemeToggle()
  }

  document.addEventListener('astro:after-swap', initThemeToggle)
</script>
