---
// Contact — Direct links (no form)
import { personalInfo, social } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import MailIcon from "./icons/Mail.astro"
import LinkedInIcon from "./icons/LinkedIn.astro"
import GitHubIcon from "./icons/GitHub.astro"
import DownloadIcon from "./icons/Download.astro"
import cvPdf from "@/assets/Sebastian_Bravo_CV.pdf"

interface Props {
  locale?: Locale
}

const { locale = 'es' } = Astro.props
const t = getTranslations(locale)

const contactLinks = [
  {
    href: `mailto:${personalInfo.email}?subject=${encodeURIComponent(t.contact.mailSubject)}`,
    label: personalInfo.email,
    icon: 'mail',
    description: t.contact.responseTime,
  },
  {
    href: social.linkedin,
    label: 'LinkedIn',
    icon: 'linkedin',
    description: t.contact.linkedinDescription,
  },
  {
    href: social.github,
    label: 'GitHub',
    icon: 'github',
    description: t.contact.githubDescription,
  },
]
---

<div class="space-y-8">
  <div class="mx-auto grid max-w-xl gap-4 sm:grid-cols-3">
    {contactLinks.map(({ href, label, icon, description }, i) => (
      <a
        href={href}
        data-animate
        data-animate-delay={String(i + 1)}
        target={icon !== 'mail' ? '_blank' : undefined}
        rel={icon !== 'mail' ? 'noopener noreferrer' : undefined}
        class="section-card group flex min-w-0 flex-col items-center gap-3 rounded-2xl border border-parchment bg-card p-6 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover focus-ring"
      >
        <div class="flex size-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-transform duration-200 group-hover:scale-110">
          {icon === 'mail' && <MailIcon class="size-5" />}
          {icon === 'linkedin' && <LinkedInIcon class="size-5" />}
          {icon === 'github' && <GitHubIcon class="size-5" />}
        </div>
        <span class="w-full break-words text-sm font-semibold text-foreground">{label}</span>
        <span class="text-xs text-caption-color">{description}</span>
      </a>
    ))}
  </div>

  <div class="contact-resume-row">
    <a
      href={cvPdf}
      target="_blank"
      rel="noopener noreferrer"
      data-track-cv={locale}
      class="contact-resume-action focus-ring"
    >
      <DownloadIcon class="size-4" />
      <span>{t.hero.downloadCv}</span>
      <span aria-hidden="true">↗</span>
    </a>
    <p>{t.contact.cvHelper}</p>
  </div>
</div>
