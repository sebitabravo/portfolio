---
import { ClientRouter } from "astro:transitions"

import "@/styles/resolucion.css"

import Footer from "@/components/Footer.astro"
import Header from "@/components/Header.astro"
import SeoTags from "@/components/SeoTags.astro"
import { siteConfig } from "@/lib/config"
import { personalInfo, social } from "@/lib/data"
import type { Locale } from "@/lib/i18n"
import { buildLayoutJsonLd } from "@/lib/seo-structured-data"
import perfilImage from "@/assets/perfil.jpeg"

interface Props {
  title?: string
  description?: string
  image?: string
  locale?: Locale
  noindex?: boolean
  canonicalUrl?: string
  alternates?: Array<{ hreflang: string; href: string }>
}

const {
  title = siteConfig.title,
  description: pageDescription,
  image,
  locale = "es",
  noindex = false,
  canonicalUrl,
  alternates = [],
} = Astro.props

const description = pageDescription ?? (locale === "en" ? personalInfo.descriptionEn : personalInfo.description)

const profileUrl = locale === "es" ? "https://sebita.dev/" : "https://sebita.dev/en/"
const canonical = canonicalUrl ?? profileUrl
// Static PNG fallback: social crawlers (X/Facebook/LinkedIn/WhatsApp) do
// not render SVG og:images, so the default card is the checked-in
// public/og/<locale>.png (1200x630, regenerated with bun run generate:og).
// Pages with their own photography (blog posts) keep passing `image`.
const staticOgImage = new URL(`/og/${locale}.png`, "https://sebita.dev").toString()
const seoImage = image ?? staticOgImage
const sameAsProfiles = [social.github, social.linkedin].filter((url): url is string => Boolean(url))

const jsonLdString = buildLayoutJsonLd({
  title,
  siteName: siteConfig.title,
  description,
  canonical,
  locale,
  profileUrl,
  personName: personalInfo.name,
  jobTitle: personalInfo.title,
  email: personalInfo.email,
  imageUrl: new URL(perfilImage.src, "https://sebita.dev").toString(),
  sameAs: sameAsProfiles,
  noindex,
})
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}

    <SeoTags
      title={title}
      description={description}
      canonical={canonical}
      image={seoImage}
      locale={locale}
      author={personalInfo.name}
      twitterHandle="@sebitabravo"
      noindex={noindex}
    />

    <!-- LCP: el h1 va en Geist Pixel Square y el cuerpo en Geist Mono; solo
      esas dos fuentes van al camino crítico (§8 de DESIGN.md). -->
    <link rel="preload" href="/fonts/GeistPixel-Square.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline type="application/ld+json" set:html={jsonLdString} />

    <!-- Theme bootstrap stays inline by design: it must run synchronously in
      <head> before first paint to avoid a flash of the wrong theme. An
      external or bundled (deferred) script runs after parsing, too late.
      Puerto verbatim de design/resolucion/boot.js: data-theme desde
      localStorage ("sb-theme") y las clases motion/ambient gated por
      prefers-reduced-motion, Save-Data y puntero fino. -->
    <script is:inline>
      ;(function () {
        var d = document.documentElement
        try {
          var t = localStorage.getItem("sb-theme")
          if (t === "light" || t === "dark") d.dataset.theme = t
        } catch (e) {}
        /* S4: matchMedia no existe en motores muy viejos y una query inválida
           lanza en algunos; sin media queries el default es motion + ambient off. */
        var mq = function (q) {
          try {
            return typeof matchMedia === "function" ? matchMedia(q).matches : false
          } catch (e) {
            return false
          }
        }
        var reduce = mq("(prefers-reduced-motion: reduce)")
        var saveData = navigator.connection && navigator.connection.saveData
        if (!reduce) d.classList.add("motion")
        if (!reduce && !saveData && mq("(hover: hover) and (pointer: fine)")) d.classList.add("ambient")
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#main-content">
      {locale === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>
    <Header locale={locale} />
    <slot />
    <Footer locale={locale} />
    <script>
      import "@/scripts/language-links"
    </script>
  </body>
</html>
