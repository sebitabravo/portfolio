---
// Par de enlaces reales (no un menú); aria-current="true" marca el idioma activo.
// language-links.ts localiza los enlaces por `hreflang` y ajusta el destino en el navegador.
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)

const currentPath = Astro.url.pathname || "/"
// Cada idioma enlaza a la misma ruta en su locale; el activo apunta a la
// página actual (el par vive en ambas rutas, estáticas).
const esHref = locale === "es" ? currentPath : currentPath.replace(/^\/en(?=\/|$)/, "") || "/"
const enHref = locale === "en" ? currentPath : `/en${currentPath === "/" ? "/" : currentPath}`
---

<div role="group" aria-label={t.language.groupLabel}>
  <a href={esHref} hreflang="es" aria-current={locale === "es" ? "true" : undefined}>es</a>
  <a href={enHref} hreflang="en" aria-current={locale === "en" ? "true" : undefined}>en</a>
</div>
