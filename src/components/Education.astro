---
// Formación: una ficha por etapa, sin párrafos largos.
import { getEducation } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import { formatPeriod } from "@/lib/utils"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const education = getEducation(locale)
---

<div class="education-grid">
  {
    education.map(({ institution, degree, description, startDate, endDate, current, location, grade, skills }, i) => (
      <article data-animate data-animate-delay={String(i + 1)} class="education-row">
        <p class="education-meta meta-label">
          <time>{formatPeriod(startDate, endDate, current, locale)}</time>
        </p>
        <h3 class="education-degree">{degree}</h3>
        <p class="education-institution meta-label">
          <span>{institution}</span>
          {location && <span>· {location}</span>}
          {grade && (
            <span>
              · {t.education.grade}: {grade}
            </span>
          )}
        </p>
        {description && <p class="education-copy">{description}</p>}
        {skills && skills.length > 0 && (
          <p class="education-skills">
            {skills.map((skill) => (
              <span class="chip">{skill}</span>
            ))}
          </p>
        )}
      </article>
    ))
  }
</div>
