---
// Hub de enlaces (espejo en inglés). Toda la copy vive en src/lib/data/links.ts.
import Layout from "@/layouts/Layout.astro"
import { personalInfo } from "@/lib/data"
import { createStaticAlternates, getTranslations } from "@/lib/i18n"
import { hubContent } from "@/lib/data/links"

const t = getTranslations("en")
const c = hubContent.en
const canonicalUrl = "https://sebita.dev/en/links"
const alternates = createStaticAlternates("en", "https://sebita.dev/links", "https://sebita.dev/en/links")
---

<Layout
  title={c.metaTitle}
  description={c.metaDescription}
  locale="en"
  canonicalUrl={canonicalUrl}
  alternates={alternates}
>
  <main id="main-content">
    <section aria-labelledby="h-links">
      <p>{c.role}</p>
      <h1 id="h-links">Sebastián Bravo</h1>
      <p>{c.lead}</p>
      <p>{t.hero.available} · {t.hero.timezone}</p>
      <ul>
        {
          c.links.map((link) => (
            <li>
              <a
                href={link.href}
                download={link.download ? true : undefined}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "me noopener noreferrer" : undefined}
              >
                {link.title}: {link.display}
              </a>
            </li>
          ))
        }
        <li>
          <a href={`mailto:${personalInfo.email}`}>{c.emailTitle}: {personalInfo.email}</a>
        </li>
      </ul>
    </section>
    <section aria-labelledby="h-youtube">
      <h2 id="h-youtube">{c.youtubeHeading}</h2>
      <p>{c.youtubeNote}</p>
      {
        c.blocks.map((block) => (
          <>
            <h3>{block.label}</h3>
            <pre id={block.id} tabindex="0">
              {block.content}
            </pre>
          </>
        ))
      }
    </section>
    <section aria-label={c.previewHeading}>
      <h3>{c.previewHeading}</h3>
      <img src="/og/en/links.svg" width="1200" height="630" alt={c.previewAlt} loading="lazy" />
    </section>
  </main>
</Layout>
