---
// Resolución — control de idioma: par de enlaces reales (no un menú), con
// aria-current="true" en el idioma activo. Puerto de design/resolucion/index.html.
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)

const currentPath = Astro.url.pathname || "/"
// Cada idioma enlaza a la misma ruta en su locale; el activo apunta a la
// página actual (el par vive en ambas rutas, estáticas).
const esHref = locale === "es" ? currentPath : currentPath.replace(/^\/en(?=\/|$)/, "") || "/"
const enHref = locale === "en" ? currentPath : `/en${currentPath === "/" ? "/" : currentPath}`
---

<span class="lang" role="group" aria-label={t.language.groupLabel}>
  <a href={esHref} aria-current={locale === "es" ? "true" : undefined}>es</a>
  <span aria-hidden="true">/</span>
  <a href={enHref} aria-current={locale === "en" ? "true" : undefined}>en</a>
</span>
