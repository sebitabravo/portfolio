---
import { getCollection } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import LocalizedBlogPost from "@/components/blog/LocalizedBlogPost.astro"
import { getBlogTranslationId } from '@/lib/blog-alternates'

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog')
  return posts
    .filter((p) => (p.data.locale ?? 'es') === 'es')
    .map((p) => ({
      params: { slug: p.id },
      props: { post: p, translationId: getBlogTranslationId(p, posts) },
    }))
}) satisfies GetStaticPaths

const { post, translationId } = Astro.props
---

<LocalizedBlogPost locale="es" post={post} translationId={translationId} />
