---
import { getCollection } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import BlogCard from "@/components/BlogCard.astro"
import { personalInfo } from "@/lib/data"
import { createStaticAlternates, getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
const isEnglish = locale === "en"
const posts = (await getCollection("blog"))
  .filter((p) => (isEnglish ? ["en", "es"].includes(p.data.locale ?? "es") : (p.data.locale ?? "es") === "es"))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
const hasFallbackPosts = isEnglish && posts.some((post) => (post.data.locale ?? "es") !== "en")
const spanishUrl = "https://sebita.dev/blog"
const englishUrl = "https://sebita.dev/en/blog"
const canonicalUrl = isEnglish ? englishUrl : spanishUrl
const alternates = createStaticAlternates(locale, spanishUrl, englishUrl)
---

<Layout
  title={`${t.blog.title} - ${personalInfo.name}`}
  description={t.blog.description}
  locale={locale}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
>
  <main id="main-content" class="mx-auto max-w-[900px] px-4 pt-24 pb-12 sm:pb-16 md:pt-28 lg:pb-20">
    <nav class="mb-6" aria-label={t.nav.breadcrumb}>
      <ol class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
        <li><a href={isEnglish ? "/en" : "/"} class="transition-colors hover:text-foreground">{t.nav.home}</a></li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-foreground/80" aria-current="page">{t.blog.title}</li>
      </ol>
    </nav>
    <h1 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl">{t.blog.title}</h1>
    <p class="mb-12 max-w-xl text-base text-muted-foreground sm:text-lg dark:text-foreground/70">
      {t.blog.intro}
    </p>

    {
      hasFallbackPosts && (
        <aside
          class="mb-8 rounded-xl border border-primary/25 bg-primary/6 px-4 py-3 text-sm text-muted-foreground dark:text-foreground/75"
          role="note"
        >
          {t.blog.fallbackNotice}
        </aside>
      )
    }

    {
      posts.length === 0 ? (
        <p class="text-sm text-muted-foreground dark:text-foreground/55">{t.blog.empty}</p>
      ) : (
        <div class="space-y-8">
          {posts.map((post) => (
            <BlogCard
              id={post.id}
              title={post.data.title}
              description={post.data.description}
              publishDate={post.data.publishDate}
              tags={post.data.tags}
              locale={locale}
              contentLocale={post.data.locale === "en" ? "en" : "es"}
              fallbackLabel={isEnglish && (post.data.locale ?? "es") !== "en" ? t.blog.fallbackCardLabel : undefined}
            />
          ))}
        </div>
      )
    }
  </main>
</Layout>
