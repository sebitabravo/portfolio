---
import { getWorkExperience } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import ExperienceItem from "@/components/ExperienceItem.astro"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const workExperience = getWorkExperience(locale)
---

{
  workExperience.length > 0 ? (
    <>
      <p class="experience-timeline-note mt-5 max-w-[60ch] text-[1.125rem] leading-relaxed text-muted-foreground" data-experience-timeline>
        {t.work.timeline}
      </p>
      <div class="relative mt-8">
        <span class="experience-progress" data-experience-progress aria-hidden="true" />
        <ol class="relative pl-6" data-experience-list>
          {workExperience.map((experience, i) => (
            <li data-experience-item>
              <ExperienceItem {...experience} locale={locale} index={i} />
            </li>
          ))}
        </ol>
      </div>
    </>
  ) : (
    <div class="mt-8 text-center text-foreground/80">
      <p>{t.work.noExperience}</p>
    </div>
  )
}
