---
// Los enlaces directos evitan recopilar datos mediante un formulario.
import { personalInfo, social } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const cvHref = "/cv/Sebastian_Bravo_CV.pdf"

const contactLinks = [
  {
    href: `mailto:${personalInfo.email}?subject=${encodeURIComponent(t.contact.mailSubject)}`,
    label: personalInfo.email,
    icon: "mail",
    description: t.contact.responseTime,
  },
  {
    href: social.linkedin,
    label: "LinkedIn",
    icon: "linkedin",
    description: t.contact.linkedinDescription,
  },
  {
    href: social.github,
    label: "GitHub",
    icon: "github",
    description: t.contact.githubDescription,
  },
]
---

<div class="space-y-10">
  <h3
    data-animate
    class="font-display text-[clamp(3rem,8vw,7rem)] leading-[0.95] font-medium tracking-[-0.03em] italic"
  >
    {t.about.contactCta}
  </h3>
  <div class="grid max-w-4xl gap-8">
    {
      contactLinks.map(({ href, label, icon, description }, i) => (
        <a
          href={href}
          data-animate
          data-animate-delay={String(i + 1)}
          target={icon !== "mail" ? "_blank" : undefined}
          rel={icon !== "mail" ? "noopener noreferrer" : undefined}
          class="group grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-center gap-x-6 gap-y-2 py-2 focus-ring"
        >
          <span class="font-text text-[clamp(1rem,2vw,1.5rem)] font-semibold break-words text-foreground group-hover:text-signal">
            {label}
          </span>
          <span aria-hidden="true" class="row-span-2 text-xl text-signal">
            ↗
          </span>
          <span class="text-sm text-muted-foreground">{description}</span>
        </a>
      ))
    }
  </div>

  <div class="contact-resume-row flex flex-wrap items-center gap-x-4 gap-y-[0.8rem] pt-2">
    <a
      href={cvHref}
      target="_blank"
      rel="noopener noreferrer"
      data-track-cv={locale}
      class="contact-resume-action inline-flex min-h-11 w-fit items-center gap-2 text-base text-signal underline underline-offset-4 focus-ring"
    >
      <span>{t.hero.downloadCv}</span>
      <span aria-hidden="true">↗</span>
    </a>
    <p>{t.contact.cvHelper}</p>
  </div>
</div>

<style>
  .contact-resume-row p {
    color: hsl(var(--caption-color));
    font-size: 0.875rem;
  }
</style>
