---
// Resolución — botón de tema: cuadro medio lleno (16px SVG), alterna
// claro/oscuro y persiste en "sb-theme". Puerto de design/resolucion/index.html.
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
---

<button id="theme" class="theme-btn" type="button" aria-label={t.theme.toggle}>
  <svg viewBox="0 0 16 16" aria-hidden="true"
    ><rect x="1.5" y="1.5" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1"></rect><path
      d="M8 1.5h6.5v13H8z"
      fill="currentColor"></path></svg
  >
</button>
