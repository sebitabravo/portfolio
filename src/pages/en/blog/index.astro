---
import { getCollection } from 'astro:content'
import Layout from "@/layouts/Layout.astro"
import { personalInfo } from "@/lib/data"
import BlogCard from "@/components/BlogCard.astro"
import { getTranslations } from "@/lib/i18n"

const locale = 'en'
const t = getTranslations(locale)
const posts = (await getCollection('blog'))
  .filter((p) => ['en', 'es'].includes(p.data.locale ?? 'es'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
const hasFallbackPosts = posts.some((post) => (post.data.locale ?? 'es') !== 'en')

const canonicalUrl = 'https://sebita.dev/en/blog'
---

<Layout
  title={`${t.blog.title} - ${personalInfo.name}`}
  description={t.blog.description}
  locale={locale}
  canonicalUrl={canonicalUrl}
  alternates={[
    { hreflang: 'en', href: canonicalUrl },
    { hreflang: 'es', href: 'https://sebita.dev/blog' },
    { hreflang: 'x-default', href: 'https://sebita.dev/blog' },
  ]}
>
  <main id="main-content" class="mx-auto max-w-[900px] px-4 py-12 sm:py-16 lg:py-20">
    <nav class="mb-6" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-foreground/55">
        <li><a href="/en" class="hover:text-foreground transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-foreground/80 font-medium" aria-current="page">Blog</li>
      </ol>
    </nav>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">{t.blog.title}</h1>
    <p class="text-foreground/70 text-base sm:text-lg mb-12 max-w-xl">
      {t.blog.intro}
    </p>

    {hasFallbackPosts && (
      <aside class="mb-8 rounded-xl border border-[hsl(var(--primary)/0.25)] bg-[hsl(var(--primary)/0.06)] px-4 py-3 text-sm text-foreground/75" role="note">
        {t.blog.fallbackNotice}
      </aside>
    )}

    {posts.length === 0 ? (
      <p class="text-foreground/55 text-sm">{t.blog.empty}</p>
    ) : (
      <div class="space-y-8">
        {posts.map((post) => (
          <BlogCard
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            tags={post.data.tags}
            locale={locale}
            fallbackLabel={(post.data.locale ?? 'es') === 'en' ? undefined : t.blog.fallbackCardLabel}
          />
        ))}
      </div>
    )}
  </main>
</Layout>
