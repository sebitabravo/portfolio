{
  "ci": {
    "collect": {
      "url": [
        "https://sebita.dev",
        "https://sebita.dev/en"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.90
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.90
          }
        ]
      }
    },
    "settings": {
      "skipAudits": [
        "canonical",
        "robots-txt"
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
