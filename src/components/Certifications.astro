---
// Una credencial sin PDF se muestra como texto estático, nunca como enlace vacío
// (tests/certifications-render.test.ts).
import { getCertifications } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const entries = getCertifications(locale)
---

<h3>{t.certifications.title}</h3>
<ul>
  {
    entries.map((entry) => (
      <li>
        {entry.pdfUrl ? (
          <a href={entry.pdfUrl} target="_blank" rel="noopener noreferrer">
            <span>{t.certifications.viewCertificate}: </span>
            {entry.name}
          </a>
        ) : (
          entry.name
        )}{" "}
        <small>{entry.organization}</small>
      </li>
    ))
  }
</ul>
