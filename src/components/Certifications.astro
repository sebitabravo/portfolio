---
import ArrowUpRight from "@/components/icons/ArrowUpRight.astro"
import { getCertifications } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const certifications = [...getCertifications(locale)].sort((a, b) => a.order - b.order)
---

<ul class="grid grid-cols-1 gap-x-12 gap-y-10 font-text md:grid-cols-2">
  {
    certifications.map((cert) => (
      <li class="flex flex-col items-start gap-2">
        <p class="cert-category text-xs text-muted-foreground">{t.certifications[cert.category]}</p>
        <h3 class="text-base leading-snug font-semibold">{cert.name}</h3>
        <p class="text-xs text-muted-foreground">{cert.organization}</p>
        {cert.pdfUrl && (
          <a
            href={cert.pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-flex min-h-11 items-center gap-2 text-xs text-signal underline underline-offset-4 focus-ring"
          >
            {t.certifications.viewCertificate}
            <ArrowUpRight class="size-4 shrink-0" />
          </a>
        )}
      </li>
    ))
  }
</ul>
