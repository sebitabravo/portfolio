---
// Barra del sistema: marca a rayas, navegación mono y acciones a la derecha.
import { getTranslations, type Locale } from "@/lib/i18n"
import { homeSectionFragment, homeSectionIds } from "@/lib/home-sections"
import { social } from "@/lib/data"
import BrandMark from "./BrandMark.astro"
import ThemeToggle from "./ThemeToggle.astro"
import LanguageToggle from "./LanguageToggle.astro"
import DropdownMenu from "./ui/DropdownMenu.astro"
import DownloadIcon from "./icons/Download.astro"
import LinkedInIcon from "./icons/LinkedIn.astro"
import ArrowUpRight from "./icons/ArrowUpRight.astro"

interface Props {
  locale?: Locale
  home?: boolean
}

const { locale = "es", home = false } = Astro.props
const t = getTranslations(locale)
const prefix = locale === "es" ? "" : "/en"

const ids = homeSectionIds[locale]
const mobileMenuId = `mobile-nav-${locale}`
const homeUrl = prefix || "/"
const contactUrl = `${homeUrl}${homeSectionFragment(locale, "contact")}`
const cvHref = "/cv/Sebastian_Bravo_CV.pdf"

const desktopNavItems = [
  { title: t.nav.projects, label: ids.projects, url: `${homeUrl}${homeSectionFragment(locale, "projects")}` },
  { title: t.nav.experience, label: ids.experience, url: `${homeUrl}${homeSectionFragment(locale, "experience")}` },
  { title: t.nav.formation, label: ids.education, url: `${homeUrl}${homeSectionFragment(locale, "education")}` },
  { title: t.nav.blog, label: "blog", url: `${prefix}/blog` },
]

const mobileNavItems = [
  { title: t.nav.home, label: "home", url: homeUrl },
  ...desktopNavItems,
  { title: t.nav.contact, label: ids.contact, url: contactUrl },
]
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/"
const isCurrentRoute = (url: string) => {
  if (url.includes("#")) return false
  const routePath = url.replace(/\/$/, "") || "/"
  return routePath === currentPath
}
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-home={home ? "true" : "false"}>
  <div class="frame site-header-frame">
    <nav
      aria-label={t.nav.mainNavigation}
      class:list={[
        "site-nav flex min-h-14 items-center justify-between gap-3 px-3 text-xs text-foreground sm:px-5",
        { "site-nav-home": home },
      ]}
    >
      <a
        href={homeUrl}
        class="brand-mark-link inline-flex shrink-0 items-center gap-2.5 focus-ring"
        aria-label={t.nav.brandHome}
      >
        <BrandMark class="brand-mark h-[1.15rem] w-auto" />
        <span class="brand-word hidden whitespace-nowrap sm:inline" aria-hidden="true">
          Sebastian <em class="brand-lastname">Bravo</em>
        </span>
      </a>

      <div class="desktop-nav relative hidden items-center gap-1 lg:flex" data-nav-list>
        <span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>
        {
          desktopNavItems.map((link, index) => (
            <a
              class="nav-link relative px-3 py-2 focus-ring"
              data-section={link.label}
              href={link.url}
              aria-current={isCurrentRoute(link.url) ? "page" : undefined}
            >
              <span class="nav-link-index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              {link.title}
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-1.5 sm:gap-2">
        <a
          href={social.linkedin}
          target="_blank"
          rel="me noopener noreferrer"
          data-track-social="linkedin"
          class="header-social hidden items-center gap-1.5 px-2.5 py-2 focus-ring xl:inline-flex"
          aria-label={t.nav.linkedin}
        >
          <LinkedInIcon class="size-3.5" />
          <span>{t.nav.linkedin}</span>
        </a>

        <a
          href={cvHref}
          target="_blank"
          rel="noopener noreferrer"
          data-track-cv={locale}
          class="header-resume hidden items-center gap-1.5 px-2.5 py-2 focus-ring sm:inline-flex"
          aria-label={t.hero.downloadCv}
        >
          <DownloadIcon class="size-3.5" />
          <span>CV</span>
        </a>

        <div class="header-toggles flex items-center gap-0.5 sm:gap-1">
          <ThemeToggle locale={locale} />
          <LanguageToggle locale={locale} />
        </div>

        <a href={contactUrl} class="header-cta btn btn-solid hidden focus-ring sm:inline-flex">
          <span class="header-cta-dot status-dot" aria-hidden="true"></span>
          {t.nav.cta}
          <ArrowUpRight class="btn-arrow size-3.5" />
        </a>

        <div class="lg:hidden">
          <DropdownMenu id={mobileMenuId} triggerLabel={t.nav.menu}>
            <div class="flex min-w-56 flex-col gap-0.5 p-1">
              {
                mobileNavItems.map((link) => (
                  <a
                    href={link.url}
                    class="mobile-nav-link px-3 py-2.5 focus-ring"
                    aria-current={isCurrentRoute(link.url) ? "page" : undefined}
                  >
                    {link.title}
                  </a>
                ))
              }
              <a
                href={social.linkedin}
                target="_blank"
                rel="me noopener noreferrer"
                data-track-social="linkedin"
                class="mobile-nav-link px-3 py-2.5 focus-ring"
              >
                {t.nav.linkedin}
              </a>
              <a
                href={cvHref}
                target="_blank"
                rel="noopener noreferrer"
                data-track-cv={locale}
                class="mobile-nav-link px-3 py-2.5 focus-ring"
              >
                {t.hero.downloadCv}
              </a>
            </div>
          </DropdownMenu>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  import { setupHeaderNav, teardownHeaderNav } from "@/scripts/header-nav"
  import { setupNavIndicator, teardownNavIndicator } from "@/scripts/motion/nav-indicator"

  const startNavigation = () => {
    setupHeaderNav()
    setupNavIndicator()
  }
  const stopNavigation = () => {
    teardownHeaderNav()
    teardownNavIndicator()
  }

  startNavigation()
  document.addEventListener("astro:page-load", startNavigation)
  document.addEventListener("astro:before-swap", stopNavigation)
</script>
