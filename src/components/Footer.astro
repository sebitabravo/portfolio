---
import { personalInfo, social } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import { homeSectionFragment } from "@/lib/home-sections"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const currentYear = new Date().getFullYear()
const homeUrl = locale === "es" ? "/" : "/en/"
const aboutUrl = `${homeUrl}${homeSectionFragment(locale, "about")}`
const contactUrl = `${homeUrl}${homeSectionFragment(locale, "contact")}`
const blogUrl = locale === "es" ? "/blog" : "/en/blog"
const privacyUrl = locale === "es" ? "/privacy" : "/en/privacy"
---

<footer class="mx-auto mt-16 w-full max-w-[1200px] px-4">
  <div class="flex flex-col gap-8 py-12 font-text text-xs">
    <div>
      <a
        href={locale === "en" ? "/en" : "/"}
        class="inline-block font-display text-[clamp(2.5rem,6vw,5.375rem)] leading-[0.95] font-medium tracking-[-0.03em] text-foreground focus-ring transition-colors hover:text-primary"
        >{personalInfo.name}</a
      >
    </div>

    <div class="flex flex-wrap items-center gap-x-8 gap-y-6">
      <span class="text-caption-color">&copy; {currentYear}</span>
      <nav aria-label={t.footer.professionalProfiles}>
        <ul class="footer-socials flex items-center gap-4">
          <li>
            <a
              href={social.linkedin}
              target="_blank"
              rel="me noopener noreferrer"
              data-track-social="linkedin"
              class="inline-flex min-h-11 items-center text-caption-color focus-ring transition-colors hover:text-foreground"
            >
              <span>LinkedIn</span>
            </a>
          </li>
          <li>
            <a
              href={social.github}
              target="_blank"
              rel="me noopener noreferrer"
              data-track-social="github"
              class="inline-flex min-h-11 items-center text-caption-color focus-ring transition-colors hover:text-foreground"
            >
              <span>GitHub</span>
            </a>
          </li>
        </ul>
      </nav>

      <span class="text-xs text-caption-color">
        {t.footer.madeWith}
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary focus-ring hover:underline">Astro</a
        >
        +
        <a
          href="https://tailwindcss.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary focus-ring hover:underline">Tailwind</a
        >
      </span>

      <span class="text-caption-color/30" aria-hidden="true">&middot;</span>

      <nav aria-label={t.footer.links}>
        <ul class="flex flex-wrap items-center gap-4">
          <li>
            <a href={blogUrl} class="text-caption-color focus-ring transition-colors hover:text-foreground"
              >{t.nav.blog}</a
            >
          </li>
          <li>
            <a href={aboutUrl} class="text-caption-color focus-ring transition-colors hover:text-foreground"
              >{t.nav.about}</a
            >
          </li>
          <li>
            <a href={contactUrl} class="text-caption-color focus-ring transition-colors hover:text-foreground"
              >{t.nav.contact}</a
            >
          </li>
          <li>
            <a href={privacyUrl} class="text-caption-color focus-ring transition-colors hover:text-foreground"
              >{t.footer.privacy}</a
            >
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
