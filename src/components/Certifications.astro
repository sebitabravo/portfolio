---
// Credenciales como sellos certificados: el anillo gira y el centro muestra la sigla.
import ArrowUpRight from "@/components/icons/ArrowUpRight.astro"
import RoundSeal from "@/components/RoundSeal.astro"
import { getCertifications } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const certifications = [...getCertifications(locale)].sort((a, b) => a.order - b.order)
---

<ul class="cert-grid">
  {
    certifications.map((cert, index) => (
      <li class="cert-item" style={`--seal-tone: var(--r${(index % 6) + 1})`}>
        <a href={cert.pdfUrl} target="_blank" rel="noopener noreferrer" class="cert-link focus-ring">
          <span class="cert-seal">
            <RoundSeal
              text={`${cert.organization} · ${t.certifications[cert.category]} · `}
              center={cert.monogram}
              size={128}
              locale={locale}
            />
          </span>
          <h3 class="cert-name">{cert.name}</h3>
          <span class="cert-org">
            {cert.organization} · <span class="cert-category meta-label">{t.certifications[cert.category]}</span>
          </span>
          <span class="cert-view meta-label">
            {t.certifications.viewCertificate}
            <ArrowUpRight class="size-3.5 shrink-0" />
          </span>
        </a>
      </li>
    ))
  }
</ul>
