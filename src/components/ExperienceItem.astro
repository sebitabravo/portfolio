---
// Fila de trayectoria: el resumen se lee de un vistazo y el detalle se despliega nativo.
import { Picture } from "astro:assets"
import ArrowUpRight from "@/components/icons/ArrowUpRight.astro"
import { formatPeriod } from "@/lib/utils"
import { getTranslations, type Locale } from "@/lib/i18n"
import type { ExperienceLogo } from "@/lib/data"

interface Props {
  company: string
  position: string
  description: string
  startDate: Date
  endDate?: Date | null
  current: boolean
  location?: string
  employmentType?: string
  skills: string[]
  logos?: ExperienceLogo[]
  url?: string
  highlights?: { label: string; value: string }[]
  locale?: Locale
  index?: number
}

const {
  company,
  position,
  description,
  startDate,
  endDate,
  current,
  location,
  employmentType,
  skills,
  logos,
  url,
  highlights = [],
  locale = "es",
  index = 0,
} = Astro.props
const t = getTranslations(locale)
const externalUrl = url?.startsWith("http")
const period = current ? t.work.currently : formatPeriod(startDate, endDate, current, locale)
const number = String(index + 1).padStart(2, "0")
---

<details
  data-animate
  data-animate-delay={String(index + 1)}
  class:list={["experience-item", { "experience-item-secondary": index > 0 }]}
  name={`experience-${locale}`}
  open={index === 0}
>
  <summary class="experience-summary focus-ring">
    <span class="experience-index mono-label" aria-hidden="true">[{number}]</span>
    <span class="experience-meta mono-label"><time datetime={startDate.toISOString().slice(0, 7)}>{period}</time></span>
    <h3 class="experience-role">{position}</h3>
    <span class="experience-company">{company}</span>
    <span class="experience-employment-type mono-label">{employmentType}</span>
    <span class="experience-toggle" aria-hidden="true"></span>
  </summary>

  <div class="experience-description">
    {location && <p class="experience-location mono-label">{location}</p>}
    <p class="experience-copy">{description}</p>

    {
      highlights.length > 0 && (
        <div class="experience-highlights" aria-label={t.work.evidenceLabel}>
          {highlights.map((highlight) => (
            <div class="experience-highlight">
              <span>{highlight.label}</span>
              <strong>{highlight.value}</strong>
            </div>
          ))}
        </div>
      )
    }

    {
      skills.length > 0 && (
        <div class="experience-skills">
          {skills.map((skill) => (
            <span class="chip">{skill}</span>
          ))}
        </div>
      )
    }

    <div class="experience-footer">
      {
        logos && logos.length > 0 && (
          <div class="experience-logos">
            {logos.map((logo) => (
              <a
                href={logo.url}
                target="_blank"
                rel="noopener noreferrer"
                title={logo.alt}
                aria-label={logo.alt}
                class="experience-logo focus-ring"
              >
                <Picture
                  src={logo.src}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  alt={logo.alt}
                  width={48}
                  height={48}
                  densities={[1, 2]}
                  fit="contain"
                  loading="lazy"
                  decoding="async"
                  class="size-full object-contain"
                />
              </a>
            ))}
          </div>
        )
      }
      {
        url && (
          <a
            href={url}
            target={externalUrl ? "_blank" : undefined}
            rel={externalUrl ? "noopener noreferrer" : undefined}
            class="experience-case project-action project-action-primary focus-ring"
          >
            {t.work.viewCaseStudy}
            <ArrowUpRight class="size-3.5 shrink-0" />
          </a>
        )
      }
    </div>
  </div>
</details>
