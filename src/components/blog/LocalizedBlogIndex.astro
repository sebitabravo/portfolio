---
import { getCollection } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import BlogCard from "@/components/BlogCard.astro"
import { personalInfo } from "@/lib/data"
import { getProjectScreenshot } from "@/lib/portfolio-images"
import { createStaticAlternates, getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
const isEnglish = locale === "en"
const posts = (await getCollection("blog"))
  .filter((p) => (isEnglish ? ["en", "es"].includes(p.data.locale ?? "es") : (p.data.locale ?? "es") === "es"))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
const hasFallbackPosts = isEnglish && posts.some((post) => (post.data.locale ?? "es") !== "en")
const spanishUrl = "https://sebita.dev/blog"
const englishUrl = "https://sebita.dev/en/blog"
const canonicalUrl = isEnglish ? englishUrl : spanishUrl
const alternates = createStaticAlternates(locale, spanishUrl, englishUrl)
const postCount = String(posts.length).padStart(2, "0")
---

<Layout
  title={`${t.blog.title} - ${personalInfo.name}`}
  description={t.blog.description}
  locale={locale}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
>
  <main id="main-content" class="blog-index frame">
    <nav class="blog-breadcrumb" aria-label={t.nav.breadcrumb}>
      <ol class="mono-label flex flex-wrap items-center gap-2 text-muted-foreground">
        <li><a href={isEnglish ? "/en" : "/"} class="transition-colors hover:text-foreground">{t.nav.home}</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-foreground" aria-current="page">{t.blog.title}</li>
      </ol>
    </nav>
    <header class="blog-index-hero" data-animate>
      <div class="blog-index-meta mono-label">
        <span class="section-index">[BLOG]</span>
        <span>{t.blog.kicker}</span>
        <span class="section-head-rule" aria-hidden="true"></span>
        <span>{postCount}</span>
      </div>
      <h1>{t.blog.title}</h1>
      <p class="blog-index-intro">{t.blog.intro}</p>
    </header>

    {
      hasFallbackPosts && (
        <aside class="blog-index-note mono-label" role="note">
          {t.blog.fallbackNotice}
        </aside>
      )
    }

    {
      posts.length === 0 ? (
        <p class="text-base text-muted-foreground">{t.blog.empty}</p>
      ) : (
        <div class="blog-grid">
          {posts.map((post, index) => (
            <BlogCard
              id={post.id}
              title={post.data.title}
              description={post.data.description}
              publishDate={post.data.publishDate}
              tags={post.data.tags}
              image={post.data.image ? getProjectScreenshot(post.data.image) : undefined}
              animateDelay={(index % 3) + 1}
              locale={locale}
              contentLocale={post.data.locale === "en" ? "en" : "es"}
              fallbackLabel={isEnglish && (post.data.locale ?? "es") !== "en" ? t.blog.fallbackCardLabel : undefined}
            />
          ))}
        </div>
      )
    }
  </main>
</Layout>

<style>
  .blog-index {
    padding: 6.5rem clamp(1rem, 4vw, 3.5rem) clamp(4rem, 8vw, 7rem);
  }

  .blog-breadcrumb {
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .blog-index-hero {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .blog-index-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.25rem;
  }

  .blog-index-hero h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(4.5rem, 14vw, 12rem);
    line-height: 0.82;
    letter-spacing: -0.035em;
  }

  .blog-index-intro {
    max-width: 46ch;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.5;
  }

  .blog-index-note {
    max-width: 70ch;
    margin: -1.5rem 0 3rem;
    line-height: 1.6;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .blog-grid {
    display: grid;
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(1.25rem, 2.4vw, 2rem);
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .blog-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
