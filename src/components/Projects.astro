---
import { Picture } from "astro:assets"
import { getStageProjects } from "@/lib/data/projects"
import { getProjectScreenshot } from "@/lib/portfolio-images"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)

const projects = getStageProjects(locale)

const blogUrl = (blogSlug: string): string => (locale === "en" ? `/en/blog/${blogSlug}` : `/blog/${blogSlug}`)

const statusLabel = (status: string, liveUrl?: string, githubUrl?: string): string => {
  if (status === "development") return t.projects.statusDevelopment
  if (status === "demo") return t.projects.statusDemo
  return !liveUrl && githubUrl ? t.projects.statusCodeAvailable : t.projects.statusProduction
}

// `code` entre backticks del trade-off se marca como <code>.
// split con grupo de captura: los índices impares son código.
const codeSegments = (text: string): Array<{ code: boolean; text: string }> =>
  text
    .split(/`([^`]+)`/g)
    .map((segment, i) => ({ code: i % 2 === 1, text: segment }))
    .filter((segment) => segment.text !== "")
---

<ul>
  {
    projects.map((project) => {
      const { title, status, tagline, tags, decision, tradeoff, metrics, blogSlug, githubUrl, liveUrl, slug } = project
      const screenshot = getProjectScreenshot(slug)
      return (
        <li>
          <article aria-labelledby={`project-${slug}`}>
            {screenshot && (
              <Picture
                src={screenshot}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[800, 1600]}
                quality={90}
                width={1600}
                height={1000}
                sizes="(min-width: 960px) 60vw, 100vw"
                alt={t.projects.screenshotAlt.replace("{title}", title)}
                decoding="async"
              />
            )}
            <h3 id={`project-${slug}`}>{title}</h3>
            <p>{statusLabel(status, liveUrl, githubUrl)}</p>
            <p>{tagline}</p>
            <p aria-label={t.projects.technologiesLabel}>{tags.join(", ")}</p>
            {decision && (
              <>
                <h4>{t.stage.decision}</h4>
                <p>{decision}</p>
              </>
            )}
            {tradeoff && (
              <>
                <h4>{t.stage.tradeoff}</h4>
                <p>
                  {codeSegments(tradeoff).map((segment) => (segment.code ? <code>{segment.text}</code> : segment.text))}
                </p>
              </>
            )}
            {(metrics ?? []).length > 0 && (
              <dl aria-label={t.projects.evidenceLabel}>
                {(metrics ?? []).map((metric) => (
                  <>
                    <dt>{metric.label}</dt>
                    <dd>{metric.value}</dd>
                  </>
                ))}
              </dl>
            )}
            <p>
              {blogSlug && <a href={blogUrl(blogSlug)}>{t.projects.readMore}</a>}
              {githubUrl && (
                <a href={githubUrl} target="_blank" rel="noopener noreferrer">
                  {t.projects.viewCode}
                </a>
              )}
              {liveUrl && (
                <a href={liveUrl} target="_blank" rel="noopener noreferrer">
                  {t.projects.viewProject}
                </a>
              )}
            </p>
          </article>
        </li>
      )
    })
  }
</ul>
