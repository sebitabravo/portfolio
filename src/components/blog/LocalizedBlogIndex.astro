---
import { getCollection } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import BlogCard from "@/components/BlogCard.astro"
import { personalInfo } from "@/lib/data"
import { getProjectScreenshot } from "@/lib/portfolio-images"
import { createStaticAlternates, getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
const isEnglish = locale === "en"
const posts = (await getCollection("blog"))
  .filter((p) => (isEnglish ? ["en", "es"].includes(p.data.locale ?? "es") : (p.data.locale ?? "es") === "es"))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
const hasFallbackPosts = isEnglish && posts.some((post) => (post.data.locale ?? "es") !== "en")
const spanishUrl = "https://sebita.dev/blog"
const englishUrl = "https://sebita.dev/en/blog"
const canonicalUrl = isEnglish ? englishUrl : spanishUrl
const alternates = createStaticAlternates(locale, spanishUrl, englishUrl)
---

<Layout
  title={`${t.blog.title} - ${personalInfo.name}`}
  description={t.blog.description}
  locale={locale}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
>
  <main id="main-content" class="mx-auto max-w-[900px] px-4 pt-24 pb-12 sm:pb-16 md:pt-28 lg:pb-20">
    <nav class="mb-6" aria-label={t.nav.breadcrumb}>
      <ol class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
        <li><a href={isEnglish ? "/en" : "/"} class="transition-colors hover:text-foreground">{t.nav.home}</a></li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-foreground/80" aria-current="page">{t.blog.title}</li>
      </ol>
    </nav>
    <header class="blog-index-hero mb-12 py-12 sm:py-20" data-animate>
      <h1>{t.blog.title}</h1>
      <p class="max-w-xl text-lg leading-relaxed text-muted-foreground">
        {t.blog.intro}
      </p>
    </header>

    {
      hasFallbackPosts && (
        <aside class="mb-10 text-base leading-relaxed text-muted-foreground" role="note">
          {t.blog.fallbackNotice}
        </aside>
      )
    }

    {
      posts.length === 0 ? (
        <p class="text-base text-muted-foreground dark:text-foreground/55">{t.blog.empty}</p>
      ) : (
        <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
          {posts.map((post, index) => (
            <BlogCard
              id={post.id}
              title={post.data.title}
              description={post.data.description}
              publishDate={post.data.publishDate}
              tags={post.data.tags}
              image={post.data.image ? getProjectScreenshot(post.data.image) : undefined}
              animateDelay={(index % 2) + 1}
              locale={locale}
              contentLocale={post.data.locale === "en" ? "en" : "es"}
              fallbackLabel={isEnglish && (post.data.locale ?? "es") !== "en" ? t.blog.fallbackCardLabel : undefined}
            />
          ))}
        </div>
      )
    }
  </main>
</Layout>

<style>
  .blog-index-hero h1 {
    margin-bottom: 1.5rem;
    font-family: var(--font-boska), Georgia, serif;
    font-size: clamp(2.75rem, 6vw, 5.375rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
</style>
