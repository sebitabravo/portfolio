---
// Resolución — fila de certificaciones (§6): lista plana con enlace al PDF; una credencial sin
// PDF se muestra como texto estático, nunca como enlace vacío (tests/certifications-render).
import Icon from "@/components/Icon.astro"
import { getCertifications } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const entries = getCertifications(locale)
---

<div class="reveal">
  <div class="row">
    <div class="label">{t.certifications.title.toLowerCase()}</div>
    <div class="main">
      <ul>
        {
          entries.map((entry) => (
            <li class="cert-item">
              {entry.pdfUrl ? (
                <a class="cert-link focus-ring" href={entry.pdfUrl} target="_blank" rel="noopener noreferrer">
                  <Icon name="file-type-pdf" />
                  <span>
                    <span class="sr">{t.certifications.viewCertificate}: </span>
                    {entry.name}
                  </span>
                </a>
              ) : (
                entry.name
              )}{" "}
              <span class="faint">{entry.organization}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>
