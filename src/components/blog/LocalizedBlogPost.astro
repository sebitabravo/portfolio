---
import { render, type CollectionEntry } from 'astro:content'
import Layout from "@/layouts/Layout.astro"
import { personalInfo } from "@/lib/data"
import { getBlogImageUrl } from "@/lib/blog-image"
import { createBlogAlternates } from "@/lib/blog-alternates"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale: Locale
  post: CollectionEntry<'blog'>
  isFallback?: boolean
  translationId?: string
}

const { locale, post, isFallback = false, translationId } = Astro.props
const { Content } = await render(post)
const isEnglish = locale === 'en'
const t = getTranslations(locale)
const spanishUrl = `https://sebita.dev/blog/${post.id}`
const englishUrl = `https://sebita.dev/en/blog/${post.id}`
const canonicalUrl = isEnglish && !isFallback ? englishUrl : spanishUrl
const alternates = createBlogAlternates({ locale, postId: post.id, translationId, isFallback })
const optimizedImageUrl = await getBlogImageUrl(post.data.image)
const imageUrl = optimizedImageUrl && new URL(optimizedImageUrl, "https://sebita.dev").toString()
const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  ...(imageUrl && { image: imageUrl }),
  datePublished: post.data.publishDate.toISOString(),
  author: {
    "@type": "Person",
    name: personalInfo.name,
    url: "https://sebita.dev",
  },
  publisher: {
    "@type": "Organization",
    name: personalInfo.name,
  },
}).replace(/</g, "\\u003c")
const homePath = isEnglish ? '/en' : '/'
const blogPath = isEnglish ? '/en/blog' : '/blog'
---

<Layout
  title={`${post.data.title} - ${personalInfo.name}`}
  description={post.data.description}
  image={imageUrl}
  locale={locale}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
>
  <main id="main-content" class="mx-auto max-w-[780px] px-4 pt-24 pb-12 sm:pb-16 md:pt-28 lg:pb-20">
    <!-- Breadcrumb -->
    <nav class="mb-8" aria-label={t.nav.breadcrumb}>
      <ol class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
        <li><a href={homePath} class="hover:text-foreground transition-colors">{t.nav.home}</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={blogPath} class="hover:text-foreground transition-colors">{t.blog.title}</a></li>
        <li aria-hidden="true">/</li>
        <li lang={isFallback ? 'es' : undefined} class="text-foreground/80 font-medium" aria-current="page">{post.data.title}</li>
      </ol>
    </nav>

    <article lang={isEnglish ? (isFallback ? 'es' : 'en') : undefined}>
      <header class="mb-10">
        {isEnglish && isFallback && (
          <aside lang={locale} class="mb-6 rounded-xl border border-primary/25 bg-primary/6 px-4 py-3 text-sm text-muted-foreground dark:text-foreground/75" role="note">
            {t.blog.fallbackNotice}
          </aside>
        )}
        <div class="flex flex-wrap gap-2 mb-4">
          {post.data.tags.map((tag) => (
            <span class="rounded-md border border-parchment bg-muted px-2 py-0.5 text-xs font-mono text-muted-foreground dark:text-foreground/60">{tag}</span>
          ))}
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4 leading-tight">{post.data.title}</h1>
        <p class="text-muted-foreground dark:text-foreground/65 text-base sm:text-lg leading-relaxed max-w-2xl">{post.data.description}</p>
        <time lang={locale} datetime={post.data.publishDate.toISOString()} class="mt-4 inline-block text-sm text-muted-foreground font-mono">
          {new Intl.DateTimeFormat(isEnglish ? 'en-US' : 'es-CL', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.publishDate)}
        </time>
      </header>

      <div class="prose-custom">
        <Content />
      </div>
    </article>

    <footer class="mt-16 pt-8 border-t border-parchment">
      <nav class="flex flex-wrap items-center justify-between gap-4" aria-label={t.blog.postNavigation}>
        <a href={blogPath} class="text-sm text-primary hover:underline">
          {`← ${t.blog.back}`}
        </a>
        <a href={homePath} class="text-sm text-muted-foreground hover:text-foreground dark:text-foreground/55 transition-colors">
          {`${t.nav.home} →`}
        </a>
      </nav>
    </footer>
  </main>

  <script is:inline type="application/ld+json" set:html={articleJsonLd}></script>
</Layout>
