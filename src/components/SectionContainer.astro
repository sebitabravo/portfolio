---
// Shared reading column for the public portfolio sections.
const { class: className, headingId, ...rest } = Astro.props
---

<section {...rest} aria-labelledby={headingId} class:list={["portfolio-section w-full mx-auto max-w-[1200px] scroll-mt-24 md:scroll-mt-28", className]}>
  <slot />
</section>
