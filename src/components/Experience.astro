---
import { getWorkExperience } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import ExperienceItem from "./ExperienceItem.astro"

interface Props {
  locale?: Locale
}

const { locale = 'es' } = Astro.props
const t = getTranslations(locale)
const workExperience = getWorkExperience(locale)
---

{workExperience.length > 0 ? (
  <>
    <div
      class="experience-timeline-note flex items-baseline gap-[0.65rem] mt-5 -mb-3 py-3 px-[0.9rem] border-l-2 border-hero-accent text-foreground/78 bg-primary/5 text-[0.86rem] leading-normal"
      data-experience-timeline
    >
      <span class="experience-timeline-note-mark flex-none text-hero-accent font-code" aria-hidden="true">↳</span>
      <p>{t.work.timeline}</p>
    </div>
    <ol class="relative mt-8 pl-4">
      {workExperience.map((experience, i) => (
        <li>
          <ExperienceItem {...experience} locale={locale} index={i} />
        </li>
      ))}
    </ol>
  </>
) : (
  <div class="text-center text-foreground/80 mt-8">
    <p>{t.work.noExperience}</p>
  </div>
)}
