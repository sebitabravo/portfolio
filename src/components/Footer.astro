---
// Resolución — pie (§3): © año nombre + enlaces. Se conservan los dos nav con rótulo del
// diccionario (perfiles y enlaces del pie) que la capa i18n fija para todo el sitio.
import { personalInfo, social } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const currentYear = new Date().getFullYear()
const prefix = locale === "es" ? "" : "/en"
---

<footer>
  <div class="wrap">
    <span>© {currentYear} {personalInfo.displayName.toLowerCase()}</span>
    <nav aria-label={t.footer.professionalProfiles}>
      <a href={social.github} target="_blank" rel="me noopener noreferrer">GitHub</a>
      <a href={social.linkedin} target="_blank" rel="me noopener noreferrer">LinkedIn</a>
    </nav>
    <nav aria-label={t.footer.links}>
      <a href={`${prefix}/blog`}>{t.nav.blog}</a>
      <a href={`${prefix}/privacy`}>{t.footer.privacy}</a>
    </nav>
  </div>
</footer>
