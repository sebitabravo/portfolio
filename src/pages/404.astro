---
import Layout from "@/layouts/Layout.astro"
import Button from "@/components/ui/Button.astro"
import { personalInfo } from "@/lib/data"
import type { Locale } from "@/lib/i18n"

const isEn = Astro.url.pathname.startsWith("/en")
const locale: Locale = isEn ? "en" : "es"
const pageTitle = locale === "es"
  ? `404 | ${personalInfo.name}`
  : `404 | ${personalInfo.name}`
const pageDescription = locale === "es"
  ? "La página que buscás no existe."
  : "The page you're looking for doesn't exist."
const backHome = locale === "es" ? "Volver al inicio" : "Back home"
const errorMsg = locale === "es"
  ? "Esta página se perdió en el deploy"
  : "This page got lost in the deploy"
const errorDesc = locale === "es"
  ? "No encontramos lo que buscabas. Volvé al inicio y seguimos desde ahí."
  : "We couldn't find what you were looking for. Head back home and we'll go from there."
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  noindex
>
  <main class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center gap-6 px-4 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted-foreground">Error 404</p>
    <h1 class="text-4xl font-bold text-foreground md:text-5xl">{errorMsg}</h1>
    <p class="max-w-xl text-foreground/80">{errorDesc}</p>
    <Button href={isEn ? "/en" : "/"} variant="default" size="lg">{backHome}</Button>
  </main>
</Layout>
