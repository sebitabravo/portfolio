---
// Header Component - Navigation (Superhuman-inspired)
import { getTranslations, type Locale } from "@/lib/i18n"
import ThemeToggle from "./ThemeToggle.astro"
import LanguageToggle from "./LanguageToggle.astro"
import DropdownMenu from "./ui/DropdownMenu.astro"

interface Props {
  locale?: Locale
}

const { locale = 'es' } = Astro.props
const t = getTranslations(locale)
const prefix = locale === 'es' ? '' : '/en'

const sectionIds = {
  es: { experience: 'experiencia', projects: 'proyectos', education: 'educacion', certifications: 'certificaciones', about: 'sobre-mi', contact: 'contacto' },
  en: { experience: 'experience', projects: 'projects', education: 'education', certifications: 'certifications', about: 'about', contact: 'contact' },
} as const

const ids = sectionIds[locale]
const mobileMenuId = `mobile-nav-${locale}`

const desktopNavItems = [
  { title: t.nav.blog, label: 'blog', url: `${prefix}/blog` },
  { title: t.nav.projects, label: ids.projects, url: `${prefix || '/'}#${ids.projects}` },
  { title: t.nav.experience, label: ids.experience, url: `${prefix || '/'}#${ids.experience}` },
  { title: t.nav.formation, label: ids.education, url: `${prefix || '/'}#${ids.education}` },
]

// Mobile: agrega "Inicio" como primer item — el logo solo no basta como affordance en mobile
const mobileNavItems = [
  { title: t.nav.home, label: 'home', url: prefix || '/' },
  ...desktopNavItems,
]

---

<header class="fixed inset-x-0 top-0 z-50 bg-[hsl(var(--background))]">
  <div class="mx-auto max-w-[1200px] px-4">
    <nav
      aria-label={locale === 'es' ? 'Navegación principal' : 'Main navigation'}
      class="site-nav mx-auto flex h-14 items-center justify-between gap-6 px-4 text-sm font-medium transition-colors duration-300"
    >
      <div class="flex items-center gap-4">
        <a href={prefix || '/'} class="text-base font-semibold tracking-tight whitespace-nowrap">
          Sebastian<span class="hidden sm:inline"> Bravo</span>
        </a>
      </div>

      <div class="hidden md:flex items-center gap-1">
        {desktopNavItems.map((link) => (
          <a
            class="nav-link relative px-3 py-2 rounded-[8px] transition-colors duration-150 focus-ring"
            data-section={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2 border-l border-transparent pl-3">
          <ThemeToggle locale={locale} />
          <LanguageToggle locale={locale} />
        </div>

        <div class="md:hidden">
          <DropdownMenu id={mobileMenuId} triggerLabel={t.nav.menu}>
            <div class="flex flex-col gap-1 p-2">
              {mobileNavItems.map((link) => (
                <a
                  href={link.url}
                  class="rounded-[8px] px-3 py-2 text-sm text-foreground/90 transition-colors hover:bg-muted/50 focus-ring"
                >
                  {link.title}
                </a>
              ))}
            </div>
          </DropdownMenu>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  let io: IntersectionObserver | null = null
  let onScroll: (() => void) | null = null
  let onVisibilityChange: (() => void) | null = null

  document.addEventListener("astro:page-load", () => {
    const sections = Array.from(document.querySelectorAll("section[id]"))
    const navLinks = Array.from(document.querySelectorAll(".site-nav .nav-link"))
    const siteNav = document.querySelector('.site-nav')

    if (io) io.disconnect()
    if (onScroll) window.removeEventListener('scroll', onScroll)
    if (onVisibilityChange) document.removeEventListener('visibilitychange', onVisibilityChange)

    io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((link) => {
              const section = link.getAttribute('data-section')
              if (section === entry.target.id) link.classList.add('nav-active')
              else link.classList.remove('nav-active')
            })
          }
        })
      },
      { threshold: 0.35 }
    )

    sections.forEach((s) => io!.observe(s))

    onScroll = () => {
      if (!siteNav) return
      if (window.scrollY > 40) siteNav.classList.add('scrolled')
      else siteNav.classList.remove('scrolled')
    }

    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })

    onVisibilityChange = () => {
      if (document.visibilityState === 'hidden') {
        io?.disconnect()
      } else {
        document.querySelectorAll("section[id]").forEach((s) => io!.observe(s))
      }
    }
    document.addEventListener('visibilitychange', onVisibilityChange)
  })
</script>

<style>
  .nav-link {
    color: inherit;
  }

  .nav-link.nav-active::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: -6px;
    width: 36%;
    height: 3px;
    border-radius: 8px;
    background: hsl(var(--primary));
    box-shadow: 0 4px 18px hsl(var(--primary) / 0.35);
  }

  /* Default: semi-transparent nav with blur */
  .site-nav {
    background: rgb(var(--nav-bg));
    border-bottom: 1px solid rgb(var(--nav-border-color) / 0.5);
    color: hsl(var(--foreground));
    backdrop-filter: saturate(1.25) blur(12px);
    -webkit-backdrop-filter: saturate(1.25) blur(12px);
  }

  :global(.dark) .site-nav {
    background: rgb(var(--nav-bg) / 0.96);
    border-bottom: 1px solid rgb(var(--nav-border-color) / 0.4);
    color: rgba(255, 255, 255, 0.9);
  }

  .site-nav .nav-link:hover {
    background: hsl(var(--muted));
  }

  :global(.dark) .site-nav .nav-link:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  /* Scrolled: more opaque background */
  .site-nav.scrolled {
    background: rgb(var(--nav-bg-scrolled) / 0.96);
    border-bottom: 1px solid hsl(var(--border));
    color: hsl(var(--foreground));
  }

  .site-nav.scrolled .nav-link:hover {
    background: hsl(var(--muted));
  }

  .site-nav.scrolled :global(#theme-toggle),
  .site-nav.scrolled :global(#language-toggle) {
    color: hsl(var(--foreground));
  }

  .site-nav.scrolled :global(#theme-toggle:hover),
  .site-nav.scrolled :global(#language-toggle:hover) {
    background: hsl(var(--muted));
  }

  /* Dark scrolled */
  :global(.dark) .site-nav.scrolled {
    background: rgb(var(--nav-bg-scrolled) / 0.92);
    border-bottom: 1px solid rgb(var(--nav-border-color) / 0.7);
    color: hsl(var(--foreground));
  }

  :global(.dark) .site-nav.scrolled .nav-link:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .dropdown:focus {
    outline: none;
  }
</style>
