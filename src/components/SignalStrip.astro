---
import type { Locale } from "@/lib/i18n"
import { getTranslations } from "@/lib/i18n"
import { canonicalTechnologies } from "@/lib/data"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const label = t.signal.label
---

<div class="signal-strip" role="region" aria-label={label}>
  <div class="signal-strip-inner">
    <div class="signal-strip-label">
      <span class="signal-strip-dot" aria-hidden="true"></span>
      <span>{label}</span>
    </div>
    <ul class="signal-technologies" role="list">
      {canonicalTechnologies.map((technology) => <li class="signal-tech">{technology}</li>)}
    </ul>
  </div>
</div>

<style>
  .signal-strip {
    position: relative;
    overflow: hidden;
    background: hsl(var(--surface-soft));
    font-family: var(--font-switzer);
    font-size: var(--text-xs);
  }

  .signal-strip-inner {
    display: flex;
    max-width: 1280px;
    min-height: 4.25rem;
    margin: 0 auto;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding: 1rem 1.25rem;
  }

  .signal-strip-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: hsl(var(--muted-foreground));
  }

  .signal-strip-dot {
    width: 0.42rem;
    height: 0.42rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: hsl(var(--primary));
  }

  .signal-technologies {
    display: flex;
    min-width: 0;
    flex: 1 1 40rem;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .signal-tech {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
  }

  .signal-tech + .signal-tech::before {
    content: "";
    width: 0.2rem;
    height: 0.2rem;
    border-radius: 50%;
    background: hsl(var(--muted-foreground) / 0.5);
  }

  @media (max-width: 767px) {
    .signal-strip-inner {
      padding-inline: 1rem;
    }
  }
</style>
