---
import type { Locale } from "@/lib/i18n"
import { getTranslations } from "@/lib/i18n"
import { canonicalTechnologies } from "@/lib/data"

interface Props {
  locale?: Locale
}

const { locale = 'es' } = Astro.props
const t = getTranslations(locale)
const technologies = [...canonicalTechnologies]
const repeatedTechnologies = [...technologies, ...technologies]
const label = t.signal.label
const technologyCount = String(technologies.length).padStart(2, '0')
---

<div
  class="signal-strip relative overflow-hidden bg-surface-soft/76 backdrop-blur-[12px] backdrop-saturate-[108%]"
  data-animate
  role="region"
  aria-label={label}
  data-signal-pause={t.signal.pause}
  data-signal-resume={t.signal.resume}
>
  <div class="signal-strip-inner mx-auto grid max-w-7xl min-h-[3.7rem] md:min-h-[4.25rem] grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-[0.65rem] md:gap-5 px-4 md:px-5">
    <div class="signal-strip-label inline-flex items-center gap-[0.55rem] text-muted-foreground text-[0.68rem] uppercase tracking-[0.12em] whitespace-normal md:whitespace-nowrap">
      <span class="signal-strip-dot size-[0.42rem] rounded-full bg-primary" aria-hidden="true"></span>
      <span>{label}</span>
    </div>
    <div class="signal-marquee-window overflow-hidden" aria-hidden="true">
      <div class="signal-marquee flex w-max items-center gap-4 md:gap-[1.7rem]">
        {repeatedTechnologies.map((technology, index) => (
          <span
            class="signal-tech inline-flex items-center gap-[0.45rem] text-foreground/78 text-[0.68rem] md:text-[0.7rem] uppercase tracking-[0.12em] whitespace-nowrap"
            data-duplicate={index >= technologies.length ? 'true' : undefined}
          >
            <span class="signal-tech-mark text-primary text-xs">✳</span>
            {technology}
          </span>
        ))}
      </div>
    </div>
    <div class="signal-strip-actions inline-flex items-center gap-[0.65rem]">
      <span class="signal-strip-index hidden md:inline text-[0.68rem] uppercase tracking-[0.12em] whitespace-nowrap" aria-hidden="true">{technologyCount} / {technologyCount}</span>
      <button
        type="button"
        class="signal-marquee-toggle focus-ring inline-flex size-8 items-center justify-center rounded-[0.45rem] border border-border bg-card/50 text-muted-foreground text-[0.68rem] cursor-pointer transition-colors duration-[180ms] hover:border-primary/55 hover:bg-muted hover:text-primary"
        data-signal-toggle
        aria-pressed="false"
        aria-label={t.signal.pause}
      >
        <span aria-hidden="true">Ⅱ</span>
        <span class="sr-only">{t.signal.pause}</span>
      </button>
    </div>
  </div>
</div>

<style>
  .signal-strip {
    /* hero-line is a runtime token outside @theme inline; promoting it needs portfolio-base.css */
    border-top: 1px solid var(--hero-line);
    border-bottom: 1px solid var(--hero-line);
    /* one-off ambient shadow, no matching card-shadow token */
    box-shadow: 0 12px 30px rgb(45 42 105 / 0.04);
  }

  .signal-strip-dot {
    /* Tailwind's ring opacity modifier compiles to color-mix(), which shifts this hairline halo's color */
    box-shadow: 0 0 0 4px hsl(var(--primary) / 0.12);
  }

  .signal-strip-label,
  .signal-strip-index,
  .signal-tech {
    font-family: var(--font-jetbrains-mono), ui-monospace, monospace;
  }

  .signal-marquee-toggle {
    font-family: var(--font-jetbrains-mono), monospace;
  }

  .signal-strip-index {
    /* hero-faint is a runtime token outside @theme inline; promoting it needs portfolio-base.css */
    color: var(--hero-faint);
  }

  .signal-marquee-window {
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .signal-marquee {
    animation: signal-marquee 32s linear infinite;
  }

  .signal-marquee-window:hover .signal-marquee,
  .signal-marquee-window:focus-within .signal-marquee,
  .signal-strip.is-paused .signal-marquee {
    animation-play-state: paused;
  }

  @keyframes signal-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-marquee {
      animation: none;
      flex-wrap: nowrap;
      transform: none;
    }

    .signal-marquee-window {
      overflow-x: auto;
      mask-image: none;
    }
  }
</style>

<script>
  const setupSignalStrip = () => {
    const strip = document.querySelector<HTMLElement>('.signal-strip')
    const toggle = strip?.querySelector<HTMLButtonElement>('[data-signal-toggle]')
    if (!strip || !toggle || toggle.dataset.bound === 'true') return

    toggle.dataset.bound = 'true'
    toggle.addEventListener('click', () => {
      const paused = strip.classList.toggle('is-paused')
      const label = paused ? strip.dataset.signalResume : strip.dataset.signalPause
      toggle.setAttribute('aria-pressed', String(paused))
      if (label) toggle.setAttribute('aria-label', label)
      const srText = toggle.querySelector('.sr-only')
      if (srText && label) srText.textContent = label
      const icon = toggle.querySelector('[aria-hidden="true"]')
      if (icon) icon.textContent = paused ? '▶' : 'Ⅱ'
    })
  }

  setupSignalStrip()
  document.addEventListener('astro:page-load', setupSignalStrip)
</script>
