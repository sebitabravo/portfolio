---
// Título de capítulo: el encabezado carga su propio peso, sin etiquetas encima.
interface Props {
  id: string
  // Cuando el capítulo abre con su propio titular, el h2 queda solo para el árbol accesible.
  srOnly?: boolean
}

const { id, srOnly = false } = Astro.props
---

<header class:list={["section-head", { "sr-only": srOnly }]}>
  <h2 id={id} class="section-heading">
    <slot />
  </h2>
</header>
