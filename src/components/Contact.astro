---
// Los enlaces directos evitan recopilar datos mediante un formulario.
import { personalInfo, social } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)
const cvHref = "/cv/Sebastian_Bravo_CV.pdf"

const contactLinks = [
  {
    href: `mailto:${personalInfo.email}?subject=${encodeURIComponent(t.contact.mailSubject)}`,
    label: personalInfo.email,
    icon: "mail",
    description: t.contact.responseTime,
  },
  {
    href: social.linkedin,
    label: "LinkedIn",
    icon: "linkedin",
    description: t.contact.linkedinDescription,
  },
  {
    href: social.github,
    label: "GitHub",
    icon: "github",
    description: t.contact.githubDescription,
  },
]
---

<div class="contact-chapter grid min-h-[70svh] grid-cols-1 content-between items-start gap-12 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
  <div class="space-y-6">
    <h3
      data-animate
      class="font-display text-[clamp(2.75rem,8vw,5.375rem)] leading-[0.95] font-medium tracking-[-0.03em] italic"
    >
      {t.about.contactCta}
    </h3>
    <p data-animate class="flex items-center gap-3 text-base">
      <span aria-hidden="true" class="size-2 rounded-full bg-inverted-accent"></span>
      {t.hero.available}
    </p>
  </div>
  <div class="grid w-full min-w-0 gap-8 md:gap-12 md:pt-20">
    {
      contactLinks.map(({ href, label, icon, description }, i) => (
        <a
          href={href}
          data-animate
          data-animate-delay={String(i + 1)}
          target={icon !== "mail" ? "_blank" : undefined}
          rel={icon !== "mail" ? "noopener noreferrer" : undefined}
          class="group grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-center gap-x-6 gap-y-3 py-3 focus-ring"
        >
          <span class="font-text text-2xl font-semibold break-words text-inverted-accent underline decoration-transparent underline-offset-8 transition-colors group-hover:decoration-current md:text-3xl">
            {label}
          </span>
          <span aria-hidden="true" class="row-span-2 text-2xl text-inverted-accent md:text-3xl">
            ↗
          </span>
          <span class="text-base">{description}</span>
        </a>
      ))
    }
  </div>

  <div class="contact-resume-row flex flex-wrap items-center gap-x-4 gap-y-[0.8rem] pt-2 md:col-span-2">
    <a
      href={cvHref}
      target="_blank"
      rel="noopener noreferrer"
      data-track-cv={locale}
      class="contact-resume-action inline-flex min-h-11 w-fit items-center gap-2 text-base text-inverted-accent underline underline-offset-4 focus-ring"
    >
      <span>{t.hero.downloadCv}</span>
      <span aria-hidden="true">↗</span>
    </a>
    <p>{t.contact.cvHelper}</p>
  </div>
</div>

<style>
  .contact-resume-row p {
    font-size: var(--text-xs);
  }

  .contact-chapter h3 {
    color: inherit;
  }

  .contact-chapter :global(.focus-ring:focus-visible) {
    outline-color: hsl(var(--inverted-accent));
  }
</style>
