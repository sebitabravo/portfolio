---
import SectionContainer from "@/components/SectionContainer.astro"

interface Props {
  id: string
  headingId: string
  tone?: "base" | "tinted"
  class?: string
}

const { id, headingId, tone = "base", class: className, ...attributes } = Astro.props
---

<div
  class:list={[
    "section-band relative isolate w-full px-4 py-[clamp(4.25rem,7vw,7rem)]",
    { "section-band-tinted bg-surface-soft": tone === "tinted" },
    className,
  ]}
  data-section-band={tone}
>
  <SectionContainer id={id} headingId={headingId} {...attributes}>
    <slot />
  </SectionContainer>
</div>
