const { locale } = Astro.props
const isEnglish = locale === "en"
const c = PRIVACY_COPY[locale]
const spanishUrl = "https://sebita.dev/privacy/"
const englishUrl = "https://sebita.dev/en/privacy/"
const canonicalUrl = isEnglish ? englishUrl : spanishUrl
const alternates = createStaticAlternates(locale, spanishUrl, englishUrl)
---

<Layout title={c.title} description={c.description} locale={locale} canonicalUrl={canonicalUrl} alternates={alternates}>
  <main id="main-content">
    <div class="px-4 md:px-6">
      <div class="mx-auto max-w-[720px] pt-24 pb-16 md:pt-28 md:pb-24">
        <h1 class="text-2xl font-bold tracking-tight md:text-3xl">
          {c.heading}
        </h1>
        <p class="mt-2 text-sm text-caption-color">
          {`${c.updatedLabel} ${c.lastUpdate}`}
        </p>

        <div class="mt-10 space-y-10 text-muted-foreground">
          <section>
            <h2 class="text-lg font-semibold text-foreground">
              {c.controllerHeading}
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>
                <strong class="text-foreground">Sebastian Bravo</strong>
                <br />
                {c.controllerCountry}
              </p>
              <p>
                {c.emailLead}{" "}
                <a
                  href={`mailto:${personalInfo.email}`}
                  class="text-primary underline decoration-primary/30 underline-offset-[3px] hover:decoration-primary"
                >
                  {personalInfo.email}
                </a>
              </p>
              <p>
                {c.siteLead}<a
                  href="https://sebita.dev"
                  class="text-primary underline decoration-primary/30 underline-offset-[3px] hover:decoration-primary"
                  >sebita.dev</a
                >{c.siteRest}
              </p>
            </div>
          </section>

          <section>
            <h2 class="text-lg font-semibold text-foreground">
              {c.noCollectHeading}
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>
                {c.noCollectLeadA}<strong class="text-foreground">{c.noCollectLeadStrong}</strong>{c.noCollectLeadB}
              </p>
              <p>{c.noCollectListLead}</p>
              <ul class="list-disc space-y-1 pl-6">
                {c.noCollectBullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </div>
          </section>

          <section>
            <h2 class="text-lg font-semibold text-foreground">
              {c.analyticsHeading}
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>{c.analyticsIntro}</p>
              <p>{c.analyticsListLead}</p>
              <ul class="list-disc space-y-1 pl-6">
                {
                  c.analyticsBullets.map((bullet) => (
                    <li>
                      <strong class="text-foreground">{bullet.term}:</strong> {bullet.detail}
                    </li>
                  ))
                }
              </ul>
              <p class="text-sm">{c.analyticsNote}</p>
            </div>
          </section>

          <section>
            <h2 class="text-lg font-semibold text-foreground">
              {c.linksHeading}
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>{c.linksLead}</p>
              <ul class="list-disc space-y-1 pl-6">
                {
                  c.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-primary underline decoration-primary/30 underline-offset-[3px] hover:decoration-primary"
                      >
                        {link.label}
                      </a>{" "}
                      {link.note}
                    </li>
                  ))
                }
              </ul>
              <p>{c.linksOutro}</p>
            </div>
          </section>

          {
            isEnglish ? (
              <>
                <section>
                  <h2 class="text-lg font-semibold text-foreground">{c.gdpr.heading}</h2>
                  <div class="mt-3 space-y-2 leading-relaxed">
                    <p>
                      {c.gdpr.introLead}
                      <strong class="text-foreground">{c.gdpr.introStrong}</strong>
                      {c.gdpr.introRest}
                    </p>
                    <ul class="list-disc space-y-1 pl-6">
                      {c.gdpr.bullets.map((bullet) => (
                        <li>
                          <strong class="text-foreground">{bullet.term}:</strong> {bullet.detail}
                        </li>
                      ))}
                    </ul>
                    <p>
                      <strong class="text-foreground">{c.gdpr.basisLead}</strong>
                      {c.gdpr.basisRest}
                    </p>
                  </div>
                </section>

                <section>
                  <h2 class="text-lg font-semibold text-foreground">{c.arco.heading}</h2>
                  <div class="mt-3 space-y-2 leading-relaxed">
                    <p>
                      {c.arco.introLead}
                      <strong class="text-foreground">{c.arco.law1}</strong>
                      {c.arco.law1Note}
                      {c.arco.mid}
                      <strong class="text-foreground">{c.arco.law2}</strong>
                      {c.arco.law2Note}
                    </p>
                    <ul class="list-disc space-y-1 pl-6">
                      {c.arco.bullets.map((bullet) => (
                        <li>
                          <strong class="text-foreground">{bullet.term}:</strong> {bullet.detail}
                        </li>
                      ))}
                    </ul>
                    <p>{c.arco.outro}</p>
                  </div>
                </section>
              </>
            ) : (
              <>
                <section>
                  <h2 class="text-lg font-semibold text-foreground">{c.arco.heading}</h2>
                  <div class="mt-3 space-y-2 leading-relaxed">
                    <p>
                      {c.arco.introLead}
                      <strong class="text-foreground">{c.arco.law1}</strong>
                      {c.arco.law1Note}
                      {c.arco.mid}
                      <strong class="text-foreground">{c.arco.law2}</strong>
                      {c.arco.law2Note}
                    </p>
                    <ul class="list-disc space-y-1 pl-6">
                      {c.arco.bullets.map((bullet) => (
                        <li>
                          <strong class="text-foreground">{bullet.term}:</strong> {bullet.detail}
                        </li>
                      ))}
                    </ul>
                    <p>{c.arco.outro}</p>
                  </div>
                </section>

                <section>
                  <h2 class="text-lg font-semibold text-foreground">{c.gdpr.heading}</h2>
                  <div class="mt-3 space-y-2 leading-relaxed">
                    <p>
                      {c.gdpr.introLead}
                      <strong class="text-foreground">{c.gdpr.introStrong}</strong>
                      {c.gdpr.introRest}
                    </p>
                    <ul class="list-disc space-y-1 pl-6">
                      {c.gdpr.bullets.map((bullet) => (
                        <li>
                          <strong class="text-foreground">{bullet.term}:</strong> {bullet.detail}
                        </li>
                      ))}
                    </ul>
                    <p>
                      <strong class="text-foreground">{c.gdpr.basisLead}</strong>
                      {c.gdpr.basisRest}
                    </p>
                  </div>
                </section>
              </>
            )
          }

          <section>
            <h2 class="text-lg font-semibold text-foreground">
              {c.changesHeading}
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>{c.changesP1}</p>
              <p>{c.changesP2}</p>
            </div>
          </section>

          <section>
            <h2 class="text-lg font-semibold text-foreground">
              {c.contactHeading}
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>{c.contactP1}</p>
              <p>
                <a
                  href={`mailto:${personalInfo.email}`}
                  class="font-medium text-primary underline decoration-primary/30 underline-offset-[3px] hover:decoration-primary"
                >
                  {personalInfo.email}
                </a>
              </p>
              <p class="text-sm">{c.contactNote}</p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
</Layout>
