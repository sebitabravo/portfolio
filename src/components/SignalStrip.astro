---
import type { Locale } from "@/lib/i18n"
import { getTranslations } from "@/lib/i18n"
import { canonicalTechnologies } from "@/lib/data"

interface Props {
  locale?: Locale
}

const { locale = 'es' } = Astro.props
const t = getTranslations(locale)
const technologies = [...canonicalTechnologies]
const repeatedTechnologies = [...technologies, ...technologies]
const label = t.signal.label
const technologyCount = String(technologies.length).padStart(2, '0')
---

<div
  class="signal-strip"
  data-animate
  role="region"
  aria-label={label}
  data-signal-pause={t.signal.pause}
  data-signal-resume={t.signal.resume}
>
  <div class="signal-strip-inner">
    <div class="signal-strip-label">
      <span class="signal-strip-dot" aria-hidden="true"></span>
      <span>{label}</span>
    </div>
    <div class="signal-marquee-window" aria-hidden="true">
      <div class="signal-marquee">
        {repeatedTechnologies.map((technology, index) => (
          <span class="signal-tech" data-duplicate={index >= technologies.length ? 'true' : undefined}>
            <span class="signal-tech-mark">✳</span>
            {technology}
          </span>
        ))}
      </div>
    </div>
    <div class="signal-strip-actions">
      <span class="signal-strip-index" aria-hidden="true">{technologyCount} / {technologyCount}</span>
      <button
        type="button"
        class="signal-marquee-toggle focus-ring"
        data-signal-toggle
        aria-pressed="false"
        aria-label={t.signal.pause}
      >
        <span aria-hidden="true">Ⅱ</span>
        <span class="sr-only">{t.signal.pause}</span>
      </button>
    </div>
  </div>
</div>

<style>
  .signal-strip {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--hero-line);
    border-bottom: 1px solid var(--hero-line);
    background: hsl(var(--surface-soft) / 0.76);
    box-shadow: 0 12px 30px rgb(45 42 105 / 0.04);
    backdrop-filter: blur(12px) saturate(1.08);
  }

  .signal-strip-inner {
    display: grid;
    max-width: 1280px;
    min-height: 4.25rem;
    margin: 0 auto;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding: 0 1.25rem;
  }

  .signal-strip-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .signal-strip-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: hsl(var(--primary));
    box-shadow: 0 0 0 4px hsl(var(--primary) / 0.12);
  }

  .signal-marquee-window {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .signal-marquee {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 1.7rem;
    animation: signal-marquee 32s linear infinite;
  }

  .signal-marquee-window:hover .signal-marquee,
  .signal-marquee-window:focus-within .signal-marquee,
  .signal-strip.is-paused .signal-marquee {
    animation-play-state: paused;
  }

  .signal-tech {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: hsl(var(--foreground) / 0.78);
    font-family: var(--font-jetbrains-mono), monospace;
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .signal-strip-label,
  .signal-strip-index,
  .signal-tech {
    font-family: var(--font-jetbrains-mono), ui-monospace, monospace;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .signal-tech-mark {
    color: hsl(var(--primary));
    font-size: 0.75rem;
  }

  .signal-strip-index {
    color: var(--hero-faint);
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .signal-strip-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .signal-marquee-toggle {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid hsl(var(--border));
    border-radius: 0.45rem;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--card) / 0.5);
    font-family: var(--font-jetbrains-mono), monospace;
    font-size: 0.68rem;
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .signal-marquee-toggle:hover {
    border-color: hsl(var(--primary) / 0.55);
    color: hsl(var(--primary));
    background: hsl(var(--muted));
  }

  @keyframes signal-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-marquee {
      animation: none;
    }

    .signal-marquee-window {
      overflow-x: auto;
      mask-image: none;
    }

    .signal-marquee {
      width: max-content;
      flex-wrap: nowrap;
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .signal-strip-inner {
      min-height: 3.7rem;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.65rem;
      padding: 0 1rem;
    }

    .signal-strip-index {
      display: none;
    }

    .signal-strip-label {
      font-size: 0.68rem;
      white-space: normal;
    }

    .signal-marquee {
      gap: 1rem;
    }

    .signal-tech {
      font-size: 0.68rem;
    }
  }
</style>

<script>
  const setupSignalStrip = () => {
    const strip = document.querySelector<HTMLElement>('.signal-strip')
    const toggle = strip?.querySelector<HTMLButtonElement>('[data-signal-toggle]')
    if (!strip || !toggle || toggle.dataset.bound === 'true') return

    toggle.dataset.bound = 'true'
    toggle.addEventListener('click', () => {
      const paused = strip.classList.toggle('is-paused')
      const label = paused ? strip.dataset.signalResume : strip.dataset.signalPause
      toggle.setAttribute('aria-pressed', String(paused))
      if (label) toggle.setAttribute('aria-label', label)
      const srText = toggle.querySelector('.sr-only')
      if (srText && label) srText.textContent = label
      const icon = toggle.querySelector('[aria-hidden="true"]')
      if (icon) icon.textContent = paused ? '▶' : 'Ⅱ'
    })
  }

  setupSignalStrip()
  document.addEventListener('astro:page-load', setupSignalStrip)
</script>
