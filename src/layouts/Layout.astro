---
import { Font, getImage } from "astro:assets"
import { SEO } from "astro-seo"

import "@/styles/global.css"

import Footer from "@/components/Footer.astro"
import Header from "@/components/Header.astro"
import { siteConfig } from "@/lib/config"
import { personalInfo, social } from "@/lib/data"
import type { Locale } from "@/lib/i18n"
import { buildLayoutJsonLd } from "@/lib/seo-structured-data"
import perfilImage from "@/assets/perfil.jpeg"

interface Props {
  title?: string
  description?: string
  image?: string
  locale?: Locale
  noindex?: boolean
  canonicalUrl?: string
  alternates?: Array<{ hreflang: string; href: string }>
}

const {
  title = siteConfig.title,
  description: pageDescription,
  image,
  locale = 'es',
  noindex = false,
  canonicalUrl,
  alternates = [],
} = Astro.props

const description = pageDescription ?? (locale === 'en' ? personalInfo.descriptionEn : personalInfo.description)

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en' || Astro.url.pathname === '/en/'
const heroPortrait = isHome
  ? await getImage({ src: perfilImage, width: 320, height: 320, format: "webp", quality: 90 })
  : undefined

const profileUrl = locale === "es" ? "https://sebita.dev/" : "https://sebita.dev/en/"
const canonical = canonicalUrl ?? profileUrl
// Static PNG fallback: social crawlers (X/Facebook/LinkedIn/WhatsApp) do
// not render SVG og:images, so the default card is the checked-in
// public/og/<locale>.png (1200x630, regenerated with pnpm generate:og).
// Pages with their own photography (blog posts) keep passing `image`.
const staticOgImage = new URL(
  `/og/${locale}.png`,
  "https://sebita.dev",
).toString()
const seoImage = image ?? staticOgImage
const sameAsProfiles = [social.github, social.linkedin].filter(
  (url): url is string => Boolean(url),
)

const jsonLdString = buildLayoutJsonLd({
  title,
  siteName: siteConfig.title,
  description,
  canonical,
  locale,
  profileUrl,
  personName: personalInfo.name,
  jobTitle: personalInfo.title,
  email: personalInfo.email,
  imageUrl: new URL(perfilImage.src, "https://sebita.dev").toString(),
  sameAs: sameAsProfiles,
  noindex,
})
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {heroPortrait && (
      <link rel="preload" as="image" href={heroPortrait.src} fetchpriority="high" />
    )}
    <Font cssVariable="--font-manrope" />
    <Font cssVariable="--font-syne" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    {alternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: seoImage,
        },
      }}
      twitter={{
        card: "summary_large_image",
        creator: "@sebitabravo",
        site: "@sebitabravo",
        title: title,
        description: description,
        image: seoImage,
      }}
      extend={{
        meta: [
          {
            name: "twitter:image:alt",
            content: title,
          },
          {
            property: "og:image:alt",
            content: title,
          },
          {
            property: "og:image:width",
            content: "1200",
          },
          {
            property: "og:image:height",
            content: "630",
          },
          {
            property: "og:url",
            content: canonical,
          },
          {
            property: "og:locale",
            content: locale === "es" ? "es-CL" : "en-US",
          },
          {
            name: "author",
            content: personalInfo.name,
          },
        ],
        link: [],
      }}
    />

    <script is:inline type="application/ld+json" set:html={jsonLdString}></script>

    <!-- Theme bootstrap stays inline by design: it must run synchronously in
      <head> before first paint to avoid a flash of the wrong theme. An
      external or bundled (deferred) script runs after parsing, too late. -->
    <script is:inline>
      (function() {
        function getThemePreference() {
          if (typeof localStorage !== 'undefined') {
            const stored = localStorage.getItem('theme');
            if (stored === 'dark' || stored === 'light' || stored === 'system') {
              return stored;
            }
          }
          return 'system';
        }
        function applyTheme(theme) {
          const effectiveTheme = theme === 'system'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : theme;
          if (effectiveTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        const theme = getThemePreference();
        applyTheme(theme);
      })();
    </script>

  </head>
  <body class="bg-background text-foreground" data-page={isHome ? 'home' : 'inner'}>
    <a href="#main-content" class="skip-link">
      {locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>
    <div class="reading-progress" aria-hidden="true">
      <span data-reading-progress></span>
    </div>
    <Header locale={locale} home={isHome} />
    <slot />
    <Footer locale={locale} />
    <script>
      import { initScrollReveal } from "@/scripts/scroll-reveal"

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initScrollReveal, { once: true })
      } else {
        initScrollReveal()
      }
      document.addEventListener("astro:after-swap", initScrollReveal)
    </script>
    <script>
      import { initReadingProgress } from "@/scripts/reading-progress"

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initReadingProgress, { once: true })
      } else {
        initReadingProgress()
      }
      document.addEventListener("astro:after-swap", initReadingProgress)
    </script>
  </body>
</html>
