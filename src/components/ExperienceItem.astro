---
import { formatMonthYear } from "@/lib/utils"
import { getTranslations, type Locale } from "@/lib/i18n"
import type { WorkExperience } from "@/lib/data"

interface Props extends WorkExperience {
  locale?: Locale
}

const {
  company,
  position,
  description,
  startDate,
  endDate,
  current,
  skills,
  url,
  highlights = [],
  locale = "es",
} = Astro.props
const t = getTranslations(locale)

const datetime = (date: Date): string => date.toISOString().slice(0, 10)
const monthYear = (date: Date): string => formatMonthYear(date, locale).toLowerCase()

// La convención del data layer: el último highlight es el caso publicado y `url` su destino.
const caseHighlight = highlights.find((highlight) => /caso|case/i.test(highlight.label)) ?? highlights.at(-1)
const evidence = caseHighlight ? highlights.filter((highlight) => highlight !== caseHighlight) : highlights
const externalUrl = url?.startsWith("http")
---

<article>
  <h3>{company}</h3>
  <p>
    {
      current ? (
        t.work.currently
      ) : (
        <>
          <time datetime={datetime(startDate)}>{monthYear(startDate)}</time> –{" "}
          <time datetime={datetime(endDate ?? startDate)}>{monthYear(endDate ?? startDate)}</time>
        </>
      )
    }
  </p>
  <p>{position}</p>
  <p>{description}</p>
  {skills.length > 0 && <p>{skills.join(", ")}</p>}
  {
    evidence.length > 0 && (
      <p aria-label={t.work.evidenceLabel}>
        {evidence.map((highlight, i) => (
          <>
            {i > 0 && " · "}
            <span>{highlight.label}</span> {highlight.value}
          </>
        ))}
      </p>
    )
  }
  {
    url && (
      <p>
        <a href={url} target={externalUrl ? "_blank" : undefined} rel={externalUrl ? "noopener noreferrer" : undefined}>
          {t.work.viewCaseStudy}
          {caseHighlight && `: ${caseHighlight.value}`}
        </a>
      </p>
    )
  }
</article>
