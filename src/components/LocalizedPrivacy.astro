---
import Layout from "@/layouts/Layout.astro"
import { personalInfo } from "@/lib/data"
import { createStaticAlternates, type Locale } from "@/lib/i18n"

interface Props {
  locale: Locale
}

interface PrivacyTermBullet {
  term: string
  detail: string
}

interface PrivacyExternalLink {
  href: string
  label: string
  note: string
}

interface PrivacyArcoCopy {
  heading: string
  introLead: string
  law1: string
  law1Note: string
  mid: string
  law2: string
  law2Note: string
  bullets: PrivacyTermBullet[]
  outro: string
}

interface PrivacyGdprCopy {
  heading: string
  introLead: string
  introStrong: string
  introRest: string
  bullets: PrivacyTermBullet[]
  basisLead: string
  basisRest: string
}

interface PrivacyLocaleCopy {
  lastUpdate: string
  title: string
  description: string
  heading: string
  updatedLabel: string
  controllerHeading: string
  controllerCountry: string
  emailLead: string
  siteLead: string
  siteRest: string
  noCollectHeading: string
  noCollectLeadA: string
  noCollectLeadStrong: string
  noCollectLeadB: string
  noCollectListLead: string
  noCollectBullets: string[]
  analyticsHeading: string
  analyticsIntro: string
  analyticsListLead: string
  analyticsBullets: PrivacyTermBullet[]
  analyticsNote: string
  linksHeading: string
  linksLead: string
  links: PrivacyExternalLink[]
  linksOutro: string
  arco: PrivacyArcoCopy
  gdpr: PrivacyGdprCopy
  changesHeading: string
  changesP1: string
  changesP2: string
  contactHeading: string
  contactP1: string
  contactNote: string
}

const PRIVACY_COPY: Record<Locale, PrivacyLocaleCopy> = {
  es: {
    lastUpdate: "25 de septiembre de 2026",
    title: "Política de Privacidad — Sebastian Bravo",
    description:
      "Política de privacidad de sebita.dev. Sebastian Bravo no recolecta datos personales. Sitio estático sin analítica ni seguimiento. Información sobre derechos ARCO y GDPR.",
    heading: "Política de Privacidad",
    updatedLabel: "Última actualización:",
    controllerHeading: "1. Responsable del Tratamiento",
    controllerCountry: "Chile",
    emailLead: "Correo electrónico:",
    siteLead: "Este sitio web (",
    siteRest:
      ") es un portfolio personal de carácter informativo y profesional. No representa una empresa ni una organización formal.",
    noCollectHeading: "2. Datos que NO Recolectamos",
    noCollectLeadA: "Este sitio web es ",
    noCollectLeadStrong: "100% estático",
    noCollectLeadB:
      ". No tiene formularios de contacto, no utiliza cookies propias, no tiene bases de datos ni almacena información de visitantes en el servidor.",
