{
  "ci": {
    "collect": {
      "url": [
        "https://sebita.dev",
        "https://sebita.dev/en"
      ],
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": [
          "canonical",
          "robots-txt"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.90
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.90
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
