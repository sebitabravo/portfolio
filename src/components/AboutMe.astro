---
import { getAboutMe } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import { homeSectionFragment } from "@/lib/home-sections"

interface Props {
  locale?: Locale
}

const { locale = 'es' } = Astro.props
const aboutMe = getAboutMe(locale)
const t = getTranslations(locale)
const contactId = homeSectionFragment(locale, 'contact')
---

<div class="about-layout grid grid-cols-1 md:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] gap-[clamp(2rem,6vw,5rem)] items-start">
  <article data-animate data-animate-delay="1" class="about-copy flex max-w-[45rem] flex-col gap-4 text-foreground/86 text-base leading-[1.65]">
    <p class="about-lede text-foreground text-[clamp(1.08rem,2vw,1.3rem)] leading-[1.5]">{aboutMe.intro}</p>
    <p>{aboutMe.personal}</p>
    <p class="about-signature text-hero-accent-strong font-code text-[0.92rem] font-semibold tracking-[-0.01em]">{aboutMe.signature}</p>

    <div class="about-interests mt-4 pt-5 border-t border-hero-line">
      <h3 class="mb-[0.8rem] text-xl leading-[1.1] tracking-[-0.04em]">{aboutMe.interestsTitle}</h3>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-[0.55rem]">
        {aboutMe.interests.map((interest) => (
          <li class="flex items-baseline gap-[0.55rem] text-foreground/78 text-[0.9rem]">
            <span aria-hidden="true" class="size-[0.38rem] flex-none rounded-full bg-hero-accent shadow-interest-dot"></span>
            {interest}
          </li>
        ))}
      </ul>
    </div>
  </article>

  <div data-animate data-animate-delay="2" class="about-focus section-card flex flex-col gap-[0.8rem] p-[clamp(1.35rem,3vw,2rem)]">
    <p class="about-focus-index text-hero-accent font-code text-[0.68rem] tracking-[0.12em] uppercase">ABOUT / {locale.toUpperCase()}</p>
    <h3 class="mb-[0.8rem] text-xl leading-[1.1] tracking-[-0.04em]">{t.about.focusTitle}</h3>
    <p class="text-foreground/82 text-[0.95rem] leading-[1.6]">{aboutMe.lookingFor}</p>
    <a href={contactId} class="about-cta focus-ring inline-flex min-h-[2.75rem] w-fit items-center gap-[0.55rem] rounded-[0.55rem] border border-primary/55 px-[0.85rem] py-[0.6rem] text-primary-foreground bg-primary shadow-cta text-[0.78rem] font-bold transition-all duration-[180ms] ease-[ease] hover:-translate-y-0.5 hover:bg-primary/90 hover:shadow-cta-hover">
      <span>{t.about.contactCta}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</div>
