---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import type { Locale } from "@/lib/i18n"
import { formatDate } from "@/lib/utils"
import { articleTitleTransitionName } from "@/scripts/transitions"

interface Props {
  id: string
  title: string
  description: string
  publishDate: Date
  tags: string[]
  locale: Locale
  contentLocale: Locale
  fallbackLabel?: string
  image?: ImageMetadata
  animateDelay?: number
}

const {
  id,
  title,
  description,
  publishDate,
  tags,
  locale,
  contentLocale,
  fallbackLabel,
  image,
  animateDelay = 1,
} = Astro.props
const prefix = locale === "es" ? "" : "/en"
const headingId = `post-title-${id}`
---

<article
  lang={contentLocale}
  class="group min-w-0"
  aria-labelledby={headingId}
  data-animate
  data-animate-delay={String(animateDelay)}
>
  <a href={`${prefix}/blog/${id}`} class="block focus-ring">
    {
      image && (
        <Image
          src={image}
          alt=""
          widths={[480, 800, 1200]}
          sizes="(min-width: 900px) 430px, (min-width: 768px) calc((100vw - 72px) / 2), calc(100vw - 32px)"
          width={800}
          height={450}
          class="mb-6 aspect-video w-full object-cover grayscale"
          loading="lazy"
          decoding="async"
        />
      )
    }
    <div class="mb-3 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
      <p class="font-text text-xs text-muted-foreground">{tags.slice(0, 3).join(" · ")}</p>
      <time lang={locale} datetime={publishDate.toISOString()} class="shrink-0 font-text text-xs text-muted-foreground">
        {formatDate(publishDate, locale)}
      </time>
    </div>
    <h2
      id={headingId}
      transition:name={articleTitleTransitionName(id)}
      class="mb-3 font-display text-2xl leading-tight font-medium tracking-[-0.03em] transition-colors group-focus-within:text-primary group-hover:text-primary"
    >
      {title}
    </h2>
    {
      fallbackLabel && (
        <p lang={locale} class="mb-2 text-xs font-medium text-primary">
          {fallbackLabel}
        </p>
      )
    }
    <p class="text-base leading-relaxed text-muted-foreground">{description}</p>
  </a>
</article>
