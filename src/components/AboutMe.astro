---
import ArrowUpRight from "@/components/icons/ArrowUpRight.astro"
import RetroTv from "@/components/RetroTv.astro"
import { getAboutMe } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import { homeSectionFragment } from "@/lib/home-sections"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const aboutMe = getAboutMe(locale)
const t = getTranslations(locale)
const contactId = homeSectionFragment(locale, "contact")
// Cada palabra recibe su índice para que el scroll la encienda en orden, sin JS.
const words = aboutMe.intro.split(/\s+/).filter(Boolean)
---

<div class="about-layout">
  <div class="about-media" data-animate data-animate-delay="1">
    <RetroTv locale={locale}>
      <p class="about-signature sticky-note">{aboutMe.signature}</p>
    </RetroTv>
  </div>

  <div class="about-copy">
    <p class="about-lede" data-reveal-words>
      {
        words.map((word, index) => (
          <span class="reveal-word" style={`--w:${index}`}>
            {word}{" "}
          </span>
        ))
      }
    </p>

    <ul class="about-facts">
      {t.about.facts.map((fact) => <li class="chip">{fact}</li>)}
    </ul>

    <div class="about-interests" data-animate>
      <h3 class="about-interests-title meta-label">{aboutMe.interestsTitle}</h3>
      <ul class="about-interest-list">
        {aboutMe.interests.map((interest) => <li>{interest}</li>)}
      </ul>
    </div>

    <div class="about-focus" data-animate>
      <h3 class="about-focus-title meta-label">
        <span class="status-dot" aria-hidden="true"></span>{t.about.focusTitle}
      </h3>
      <p>{aboutMe.lookingFor}</p>
      <a href={contactId} class="about-cta focus-ring">
        <span>{t.about.contactCta}</span>
        <ArrowUpRight class="btn-arrow size-4 shrink-0" />
      </a>
    </div>
  </div>
</div>
