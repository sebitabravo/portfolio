---
import { render, type CollectionEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import { personalInfo } from "@/lib/data"
import { getBlogImageUrl } from "@/lib/blog-image"
import { getProjectSocialImage } from "@/lib/portfolio-images"
import { createBlogAlternates } from "@/lib/blog-alternates"
import { getTranslations, type Locale } from "@/lib/i18n"
import { formatDate } from "@/lib/utils"
import { articleTitleTransitionName } from "@/scripts/transitions"

interface Props {
  locale: Locale
  post: CollectionEntry<"blog">
  isFallback?: boolean
  translationId?: string
}

const { locale, post, isFallback = false, translationId } = Astro.props
const { Content } = await render(post)
const isEnglish = locale === "en"
const t = getTranslations(locale)
const spanishUrl = `https://sebita.dev/blog/${post.id}`
const englishUrl = `https://sebita.dev/en/blog/${post.id}`
const canonicalUrl = isEnglish && !isFallback ? englishUrl : spanishUrl
const alternates = createBlogAlternates({ locale, postId: post.id, translationId, isFallback })
const optimizedImageUrl = await getBlogImageUrl(post.data.image)
const heroImage = getProjectSocialImage(post.data.image)
const heroImageWidth = heroImage && Math.min(heroImage.width, 1200)
const heroImageHeight = heroImage && heroImageWidth && Math.round(heroImage.height * heroImageWidth / heroImage.width)
const imageUrl = optimizedImageUrl && new URL(optimizedImageUrl, "https://sebita.dev").toString()
const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  ...(imageUrl && { image: imageUrl }),
  datePublished: post.data.publishDate.toISOString(),
  author: {
    "@type": "Person",
    name: personalInfo.name,
    url: "https://sebita.dev",
  },
  publisher: {
    "@type": "Organization",
    name: personalInfo.name,
  },
}).replace(/</g, "\\u003c")
const homePath = isEnglish ? "/en" : "/"
const blogPath = isEnglish ? "/en/blog" : "/blog"
---

<Layout
  title={`${post.data.title} - ${personalInfo.name}`}
  description={post.data.description}
  image={imageUrl}
  locale={locale}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
>
  <main id="main-content" class="mx-auto max-w-[780px] px-4 pt-24 pb-12 sm:pb-16 md:pt-28 lg:pb-20">
    <nav class="mb-8" aria-label={t.nav.breadcrumb}>
      <ol class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
        <li><a href={homePath} class="transition-colors hover:text-foreground">{t.nav.home}</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={blogPath} class="transition-colors hover:text-foreground">{t.blog.title}</a></li>
        <li aria-hidden="true">/</li>
        <li lang={isFallback ? "es" : undefined} class="font-medium text-foreground/80" aria-current="page">
          {post.data.title}
        </li>
      </ol>
    </nav>

    <article lang={isEnglish ? (isFallback ? "es" : "en") : undefined}>
      <header class="mb-10" data-animate>
        {
          isEnglish && isFallback && (
            <aside
              lang={locale}
              class="mb-6 text-base text-muted-foreground"
              role="note"
            >
              {t.blog.fallbackNotice}
            </aside>
          )
        }
        <h1
          transition:name={articleTitleTransitionName(post.id)}
          class="mb-6 font-display text-[clamp(2.75rem,6vw,5.375rem)] leading-[0.95] font-medium tracking-[-0.03em]"
        >
          {post.data.title}
        </h1>
        <p class="max-w-[65ch] text-base leading-relaxed text-muted-foreground sm:text-lg">
          {post.data.description}
        </p>
        <p class="mt-6 font-text text-xs text-muted-foreground">{post.data.tags.join(" · ")}</p>
        <time
          lang={locale}
          datetime={post.data.publishDate.toISOString()}
          class="mt-4 inline-block font-text text-xs text-muted-foreground"
        >
          {formatDate(post.data.publishDate, locale)}
        </time>
      </header>

      {
        optimizedImageUrl && heroImage && (
          <img
            src={optimizedImageUrl}
            alt={post.data.title}
            width={heroImageWidth}
            height={heroImageHeight}
            loading="eager"
            fetchpriority="high"
            class="mb-12 aspect-video w-full object-cover"
            data-animate
          />
        )
      }

      <div class="prose-custom">
        <Content />
      </div>
    </article>

    <footer class="mt-16 pt-8" data-animate>
      <nav class="flex flex-wrap items-center justify-between gap-4" aria-label={t.blog.postNavigation}>
        <a href={blogPath} class="text-xs text-primary hover:underline">
          {`← ${t.blog.back}`}
        </a>
        <a
          href={homePath}
          class="text-xs text-muted-foreground transition-colors hover:text-foreground"
        >
          {`${t.nav.home} →`}
        </a>
      </nav>
    </footer>
  </main>

  <script is:inline type="application/ld+json" set:html={articleJsonLd} />
</Layout>
