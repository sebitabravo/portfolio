    updatedLabel: "Last updated:",
    controllerHeading: "1. Data Controller",
    controllerCountry: "Chile",
    emailLead: "Email:",
    siteLead: "This website (",
    siteRest:
      ") is a personal portfolio site for informational and professional purposes. It does not represent a company or formal organization.",
    noCollectHeading: "2. Data We Do NOT Collect",
    noCollectLeadA: "This website is ",
    noCollectLeadStrong: "100% static",
    noCollectLeadB:
      ". It has no contact forms, does not use cookies, has no databases, and does not store any visitor information on the server.",
    noCollectListLead: "Specifically, we do NOT collect:",
    noCollectBullets: [
      "Names, email addresses, or contact information",
      "First-party session or persistent cookies",
      "Biometric, health, or special category data",
      "Financial or payment information",
      "Full IP addresses (not collected by this site)",
    ],
    analyticsHeading: "3. Analytics and Measurement",
    analyticsIntro:
      "This site uses no analytics or tracking tools. There are no tracking pixels, third-party measurement scripts, or A/B experiments: pages are static HTML served with no client-side instrumentation.",
    analyticsListLead: "Specifically:",
    analyticsBullets: [
      {
        term: "No analytics",
        detail: "no page views, events, or usage metrics are recorded.",
      },
      {
        term: "No identifiers",
        detail: "no visitor identifiers are generated or stored.",
      },
      {
        term: "No third-party measurement",
        detail: "no analytics script loads in the browser.",
      },
    ],
    analyticsNote:
      "If any measurement is ever introduced, it will be cookie-free and aggregate-only, and this policy will be updated before it goes live.",
    linksHeading: "4. External Links",
    linksLead: "This site contains links to third-party platforms:",
    links: [
      {
        href: "https://github.com/sebitabravo",
        label: "GitHub",
        note: "— code repositories",
      },
      {
        href: "https://linkedin.com/in/sebitabravo",
        label: "LinkedIn",
        note: "— professional profile",
      },
      {
        href: "https://cal.com/sebitabravo/15min",
        label: "Cal.com",
        note: "— meeting scheduling",
      },
    ],
