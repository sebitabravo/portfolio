---
// Floating navigation: the home gets a theme-aware glass treatment, inner pages a surface fallback.
import { getTranslations, type Locale } from "@/lib/i18n"
import { homeSectionFragment, homeSectionIds } from "@/lib/home-sections"
import { social } from "@/lib/data"
import ThemeToggle from "./ThemeToggle.astro"
import LanguageToggle from "./LanguageToggle.astro"
import DropdownMenu from "./ui/DropdownMenu.astro"
import DownloadIcon from "./icons/Download.astro"
import LinkedInIcon from "./icons/LinkedIn.astro"

interface Props {
  locale?: Locale
  home?: boolean
}

const { locale = "es", home = false } = Astro.props
const t = getTranslations(locale)
const prefix = locale === "es" ? "" : "/en"

const ids = homeSectionIds[locale]
const mobileMenuId = `mobile-nav-${locale}`
const homeUrl = prefix || "/"
const contactUrl = `${homeUrl}${homeSectionFragment(locale, "contact")}`
const cvHref = "/cv/Sebastian_Bravo_CV.pdf"

const desktopNavItems = [
  { title: t.nav.blog, label: "blog", url: `${prefix}/blog` },
  { title: t.nav.projects, label: ids.projects, url: `${homeUrl}${homeSectionFragment(locale, "projects")}` },
  { title: t.nav.experience, label: ids.experience, url: `${homeUrl}${homeSectionFragment(locale, "experience")}` },
  { title: t.nav.formation, label: ids.education, url: `${homeUrl}${homeSectionFragment(locale, "education")}` },
]

const mobileNavItems = [
  { title: t.nav.home, label: "home", url: homeUrl },
  ...desktopNavItems,
  { title: t.nav.contact, label: ids.contact, url: contactUrl },
]
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/"
const isCurrentRoute = (url: string) => {
  if (url.includes("#")) return false
  const routePath = url.replace(/\/$/, "") || "/"
  return routePath === currentPath
}

// `scrolled:`/`dark:` below win over either branch by specificity, so only one is ever needed.
const navSurfaceClass = home
  ? "bg-nav-glass shadow-nav-home dark:unscrolled:border-nav-glass-border-dark dark:unscrolled:bg-nav-glass-dark dark:unscrolled:text-nav-glass-text-dark"
  : "bg-card/84 shadow-nav"
---

<header class="site-header pointer-events-none fixed inset-x-0 top-0 z-50" data-home={home ? "true" : "false"}>
  <div class="mx-auto max-w-[1200px] px-3 sm:px-4">
    <nav
      aria-label={t.nav.mainNavigation}
      class:list={[
        "site-nav pointer-events-auto mx-auto flex min-h-14 items-center justify-between gap-3 border border-border/85 px-3 py-2 text-sm font-medium text-foreground transition-all duration-300",
        "mt-2 rounded-[0.85rem] backdrop-blur-lg backdrop-saturate-[1.35] sm:mt-3 sm:rounded-2xl sm:px-4",
        "scrolled:border-border scrolled:bg-card/90 scrolled:shadow-nav-scrolled",
        "dark:border-border/90 dark:bg-card/90 dark:shadow-nav-dark",
        "dark-scrolled:border-border/90 dark-scrolled:shadow-nav-dark",
        navSurfaceClass,
        // `group` scopes the toggles' dark-mode override to home navs, matching the original ancestor selector.
        { "site-nav-home": home, group: home },
      ]}
    >
      <a
        href={homeUrl}
        class="brand-mark-link inline-flex shrink-0 items-center gap-[0.55rem] tracking-[-0.02em] focus-ring"
        aria-label={t.nav.brandHome}
      >
        <span
          class="brand-mark inline-flex size-[1.9rem] items-center justify-center rounded-[0.55rem] border border-current font-code text-[0.66rem] font-semibold tracking-[-0.08em]"
          aria-hidden="true">SB</span
        >
        <span class="hidden whitespace-nowrap sm:inline"
          >Sebastian <span class="brand-lastname text-primary">Bravo</span></span
        >
      </a>

      <div class="hidden items-center gap-1 md:flex">
        {
          desktopNavItems.map((link) => (
            <a
              class="nav-link relative rounded-lg px-3 py-2 focus-ring transition-colors duration-200 hover:bg-muted"
              data-section={link.label}
              href={link.url}
              aria-current={isCurrentRoute(link.url) ? "page" : undefined}
            >
              {link.title}
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-1.5 sm:gap-2">
        <a
          href={contactUrl}
          class="header-cta hidden items-center gap-2 rounded-lg bg-primary px-3 py-2 text-xs font-semibold text-primary-foreground focus-ring transition hover:-translate-y-px hover:shadow-header-cta-hover sm:inline-flex"
        >
          <span class="header-cta-dot size-[0.38rem] rounded-full bg-current shadow-header-cta-dot" aria-hidden="true"
          ></span>
          {t.nav.cta}
        </a>

        <a
          href={social.linkedin}
          target="_blank"
          rel="me noopener noreferrer"
          data-track-social="linkedin"
          class="header-social hidden items-center gap-1.5 rounded-lg border border-border/90 bg-card/45 px-2.5 py-2 text-xs font-semibold text-muted-foreground focus-ring transition hover:border-primary/55 hover:bg-primary/8 hover:text-primary lg:inline-flex"
          aria-label={t.nav.linkedin}
        >
          <LinkedInIcon class="size-3.5" />
          <span>{t.nav.linkedin}</span>
        </a>

        <a
          href={cvHref}
          target="_blank"
          rel="noopener noreferrer"
          data-track-cv={locale}
          class="header-resume hidden items-center gap-1.5 rounded-lg border border-border/90 bg-card/45 px-2.5 py-2 text-xs font-semibold text-muted-foreground focus-ring transition hover:border-primary/55 hover:bg-primary/8 hover:text-primary sm:inline-flex"
          aria-label={t.hero.downloadCv}
        >
          <DownloadIcon class="size-3.5" />
          <span>CV</span>
        </a>

        <div class="flex items-center gap-0.5 border-l border-current/15 pl-1.5 sm:gap-1 sm:pl-2">
          <ThemeToggle locale={locale} />
          <LanguageToggle locale={locale} />
        </div>

        <div class="md:hidden">
          <DropdownMenu id={mobileMenuId} triggerLabel={t.nav.menu}>
            <div class="flex min-w-52 flex-col gap-1 p-1">
              {
                mobileNavItems.map((link) => (
                  <a
                    href={link.url}
                    class="rounded-lg px-3 py-2.5 text-sm text-foreground/90 focus-ring transition-colors hover:bg-muted/70"
                    aria-current={isCurrentRoute(link.url) ? "page" : undefined}
                    target={link.url === cvHref ? "_blank" : undefined}
                    rel={link.url === cvHref ? "noopener noreferrer" : undefined}
                  >
                    {link.title}
                  </a>
                ))
              }
              <a
                href={social.linkedin}
                target="_blank"
                rel="me noopener noreferrer"
                data-track-social="linkedin"
                class="rounded-lg px-3 py-2.5 text-sm text-foreground/90 focus-ring transition-colors hover:bg-muted/70"
              >
                {t.nav.linkedin}
              </a>
              <a
                href={cvHref}
                target="_blank"
                rel="noopener noreferrer"
                data-track-cv={locale}
                class="rounded-lg px-3 py-2.5 text-sm text-foreground/90 focus-ring transition-colors hover:bg-muted/70"
              >
                {t.hero.downloadCv}
              </a>
            </div>
          </DropdownMenu>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  import { setupHeaderNav, teardownHeaderNav } from "@/scripts/header-nav"

  setupHeaderNav()
  document.addEventListener("astro:page-load", setupHeaderNav)
  document.addEventListener("astro:before-swap", teardownHeaderNav)
</script>
