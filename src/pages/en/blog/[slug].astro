---
import { getCollection } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import LocalizedBlogPost from "@/components/blog/LocalizedBlogPost.astro"
import { getBlogTranslationId } from '@/lib/blog-alternates'

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog')
  return posts
    .filter((p) => ['en', 'es'].includes(p.data.locale ?? 'es'))
    .map((p) => {
      const isFallback = (p.data.locale ?? 'es') !== 'en'
      return {
        params: { slug: p.id },
        props: {
          post: p,
          isFallback,
          translationId: isFallback ? undefined : getBlogTranslationId(p, posts),
        },
      }
    })
}) satisfies GetStaticPaths

const { post, isFallback, translationId } = Astro.props
---

<LocalizedBlogPost locale="en" post={post} isFallback={isFallback} translationId={translationId} />
