---
import { personalInfo, social } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import { homeSectionFragment } from "@/lib/home-sections"

interface Props {
  locale?: Locale
}

const { locale = "es" } = Astro.props
const t = getTranslations(locale)

const cvHref = "/cv/Sebastian_Bravo_CV.pdf"
---

<section aria-labelledby="name">
  <p>{t.hero.role.toLowerCase()}</p>
  <h1 id="name">{personalInfo.displayName}</h1>
  <p>{t.hero.intro}</p>
  {personalInfo.available && <p>{t.hero.available}</p>}
  <ul>
    <li><a href={`mailto:${personalInfo.email}`}>{personalInfo.email}</a></li>
    <li><a href={social.github} target="_blank" rel="me noopener noreferrer">github</a></li>
    <li><a href={social.linkedin} target="_blank" rel="me noopener noreferrer">linkedin</a></li>
  </ul>
  <p>
    <a href={homeSectionFragment(locale, "work")}>{t.hero.viewProjects}</a>
    <a href={cvHref} download>{t.hero.downloadCv}</a>
  </p>
</section>
