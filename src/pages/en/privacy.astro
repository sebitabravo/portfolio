---
/**
 * Privacy Policy — sebita.dev (English)
 *
 * Static personal portfolio site. Does not collect personal data directly.
 * Only analytics: Vercel Analytics (anonymized, cookie-free).
 */
import Layout from "@/layouts/Layout.astro"
import { personalInfo } from "@/lib/data"

const lastUpdate = "May 24, 2026"
const canonicalUrl = "https://sebita.dev/en/privacy/"
const title = "Privacy Policy — Sebastian Bravo"
const description =
  "Privacy policy for sebita.dev. Sebastian Bravo does not collect personal data. Information about Vercel Analytics, GDPR rights, and Chilean data protection law."
---

<Layout
  title={title}
  description={description}
  locale="en"
  canonicalUrl={canonicalUrl}
  alternates={[
    { hreflang: 'en', href: canonicalUrl },
    { hreflang: 'es', href: 'https://sebita.dev/privacy/' },
    { hreflang: 'x-default', href: 'https://sebita.dev/privacy/' },
  ]}
>
  <main id="main-content">
    <div class="px-4 md:px-6">
      <div class="mx-auto max-w-[720px] pt-20 md:pt-28 pb-16 md:pb-24">
        <!-- Header -->
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight">
          Privacy Policy
        </h1>
        <p class="mt-2 text-sm text-[hsl(var(--caption-color))]">
          Last updated: {lastUpdate}
        </p>

        <div class="mt-10 space-y-10 text-[hsl(var(--muted-foreground))]">
          <!-- 1. Data Controller -->
          <section>
            <h2 class="text-lg font-semibold text-foreground">
              1. Data Controller
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>
                <strong class="text-foreground">Sebastian Bravo</strong>
                <br />
                Chile
              </p>
              <p>
                Email:
                <a
                  href="mailto:{personalInfo.email}"
                  class="link-inline"
                >
                  {personalInfo.email}
                </a>
              </p>
              <p>
                This website (<a href="https://sebita.dev" class="link-inline">sebita.dev</a>)
                is a personal portfolio site for informational and professional
                purposes. It does not represent a company or formal
                organization.
              </p>
            </div>
          </section>

          <!-- 2. Data We Do NOT Collect -->
          <section>
            <h2 class="text-lg font-semibold text-foreground">
              2. Data We Do NOT Collect
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>
                This website is <strong class="text-foreground">100% static</strong>.
                It has no contact forms, does not use cookies, has no
                databases, and does not store any visitor information on the
                server.
              </p>
              <p>Specifically, we do NOT collect:</p>
              <ul class="list-disc pl-6 space-y-1">
                <li>Names, email addresses, or contact information</li>
                <li>First-party session or persistent cookies</li>
                <li>Biometric, health, or special category data</li>
                <li>Financial or payment information</li>
                <li>Full IP addresses (anonymized by Vercel)</li>
              </ul>
            </div>
          </section>

          <!-- 3. Vercel Analytics -->
          <section>
            <h2 class="text-lg font-semibold text-foreground">
              3. Vercel Analytics
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>
                This site uses
                <a
                  href="https://vercel.com/analytics"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-inline"
                >
                  Vercel Web Analytics
                </a>,
                a privacy-focused analytics tool that operates without cookies
                and without collecting personally identifiable information.
              </p>
              <p>Vercel Analytics features:</p>
              <ul class="list-disc pl-6 space-y-1">
                <li>
                  <strong class="text-foreground">Cookie-free:</strong> no
                  first-party or third-party cookies are used
                </li>
                <li>
                  <strong class="text-foreground">Anonymized IP:</strong> IP
                  addresses are anonymized before processing
                </li>
                <li>
                  <strong class="text-foreground">Aggregated data:</strong>
                  only aggregated metrics such as page views, country-level
                  geography, and device type are recorded
                </li>
                <li>
                  <strong class="text-foreground">No cross-site
                  tracking:</strong> users are not tracked across different
                  websites
                </li>
              </ul>
              <p class="text-sm">
                Vercel Analytics is disabled in development environments and
                only activates in production (sebita.dev).
              </p>
            </div>
          </section>

          <!-- 4. External Links -->
          <section>
            <h2 class="text-lg font-semibold text-foreground">
              4. External Links
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>This site contains links to third-party platforms:</p>
              <ul class="list-disc pl-6 space-y-1">
                <li>
                  <a
                    href="https://github.com/sebitabravo"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-inline"
                  >
                    GitHub
                  </a>
                  — code repositories
                </li>
                <li>
                  <a
                    href="https://linkedin.com/in/sebitabravo"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-inline"
                  >
                    LinkedIn
                  </a>
                  — professional profile
                </li>
                <li>
                  <a
                    href="https://cal.com/sebitabravo/15min"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-inline"
                  >
                    Cal.com
                  </a>
                  — meeting scheduling
                </li>
              </ul>
              <p>
                We have no control over the content or privacy practices of
                these external sites. We recommend reviewing their respective
                privacy policies when visiting them.
              </p>
            </div>
          </section>

          <!-- 5. GDPR Rights -->
          <section>
            <h2 class="text-lg font-semibold text-foreground">
              5. Your GDPR Rights (European Visitors)
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>
                If you are located in the European Economic Area (EEA), the
                <strong class="text-foreground"
                  >General Data Protection Regulation (GDPR)</strong
                >
                grants you the following rights:
              </p>
              <ul class="list-disc pl-6 space-y-1">
                <li>
                  <strong class="text-foreground">Access:</strong> request
                  information about what personal data we process
                </li>
                <li>
                  <strong class="text-foreground">Rectification:</strong>
                  request correction of inaccurate or incomplete data
                </li>
                <li>
                  <strong class="text-foreground">Erasure:</strong> request
                  deletion of your personal data
                </li>
                <li>
                  <strong class="text-foreground">Restriction:</strong>
                  restrict the processing of your data
                </li>
                <li>
                  <strong class="text-foreground">Portability:</strong>
                  receive your data in a structured, machine-readable format
                </li>
                <li>
                  <strong class="text-foreground">Objection:</strong> object
                  to the processing of your personal data
                </li>
                <li>
                  <strong class="text-foreground">Withdraw consent:</strong>
                  withdraw any consent given at any time
                </li>
                <li>
                  <strong class="text-foreground"
                    >Lodge a complaint:</strong
                  >
                  file a complaint with your local data protection authority
                </li>
              </ul>
              <p>
                <strong class="text-foreground">Legal basis:</strong> the only
                data processing performed by this site is Vercel Analytics,
                based on legitimate interest in measuring site performance,
                limited to anonymized and aggregated data that does not
                identify individual users.
              </p>
            </div>
          </section>

          <!-- 6. Chilean ARCO Rights -->
          <section>
            <h2 class="text-lg font-semibold text-foreground">
              6. Your ARCO Rights (Chile)
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>
                Chilean law protects your personal data. Under
                <strong class="text-foreground">Law 19.628</strong> (currently
                in force) and <strong class="text-foreground">Law 21.719</strong>
                (effective December 1, 2026), you have the following ARCO
                rights:
              </p>
              <ul class="list-disc pl-6 space-y-1">
                <li>
                  <strong class="text-foreground">Access:</strong> request
                  information about what personal data we are processing
                </li>
                <li>
                  <strong class="text-foreground">Rectification:</strong>
                  request correction of inaccurate or incomplete data
                </li>
                <li>
                  <strong class="text-foreground">Cancellation:</strong>
                  request deletion of your personal data
                </li>
                <li>
                  <strong class="text-foreground">Opposition:</strong> object
                  to the processing of your personal data
                </li>
              </ul>
              <p>
                Since this site does not actively collect personal data, we do
                not maintain visitor records that can be associated with an
                identified or identifiable person. If you believe your data
                has been processed in a manner contrary to law, please contact
                us at the email address in Section 1 and we will resolve your
                request promptly.
              </p>
            </div>
          </section>

          <!-- 7. Changes -->
          <section>
            <h2 class="text-lg font-semibold text-foreground">
              7. Changes to This Policy
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>
                This privacy policy may be updated to reflect changes in site
                functionality or applicable law. The "Last updated" date at
                the top of this page indicates when it was last modified.
              </p>
              <p>
                We recommend checking this page periodically if you are
                interested in how your privacy is protected.
              </p>
            </div>
          </section>

          <!-- 8. Contact -->
          <section>
            <h2 class="text-lg font-semibold text-foreground">
              8. Contact
            </h2>
            <div class="mt-3 space-y-2 leading-relaxed">
              <p>
                If you have questions about this privacy policy or wish to
                exercise your rights, you can contact me directly at:
              </p>
              <p>
                <a
                  href="mailto:{personalInfo.email}"
                  class="link-inline font-medium"
                >
                  {personalInfo.email}
                </a>
              </p>
              <p class="text-sm">
                I will respond promptly. I do not use this channel for
                commercial purposes nor share your email with third parties.
              </p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
</Layout>
