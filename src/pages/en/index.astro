---
/**
 * Sebastian Bravo - Frontend Developer (English Version)
 *
 * Superhuman-inspired landing:
 * Hero → Projects → Experience → Education → Certs → About → Contact
 */
import Layout from "@/layouts/Layout.astro"
import { personalInfo } from "@/lib/data"
import { getTranslations } from "@/lib/i18n"

const t = getTranslations('en')

// Components
import Hero from "@/components/Hero.astro"
import SignalStrip from "@/components/SignalStrip.astro"
import Experience from "@/components/Experience.astro"
import Projects from "@/components/Projects.astro"
import Education from "@/components/Education.astro"
import Certifications from "@/components/Certifications.astro"
import AboutMe from "@/components/AboutMe.astro"
import Contact from "@/components/Contact.astro"
import SectionBand from "@/components/SectionBand.astro"
import TitleSection from "@/components/TitleSection.astro"

// Icons
import BriefcaseIcon from "@/components/icons/Briefcase.astro"
import CodeIcon from "@/components/icons/Code.astro"
import GraduationCapIcon from "@/components/icons/GraduationCap.astro"
import CertificateIcon from "@/components/icons/Certificate.astro"
import ProfileCheckIcon from "@/components/icons/ProfileCheck.astro"
import MailIcon from "@/components/icons/Mail.astro"
---

<Layout
  title={`${personalInfo.name} — ${personalInfo.title}`}
  locale="en"
  canonicalUrl="https://sebita.dev/en/"
  alternates={[
    { hreflang: 'en', href: 'https://sebita.dev/en/' },
    { hreflang: 'es', href: 'https://sebita.dev' },
    { hreflang: 'x-default', href: 'https://sebita.dev' },
  ]}
>
  <main id="main-content">
  <Hero locale="en" />

  <div class="home-sections">
      <!-- Projects -->
      <SectionBand id="projects" headingId="projects-heading">
        <TitleSection id="projects-heading" index={1} total={6}>
          <CodeIcon class="size-6" />
          {t.projects.title}
        </TitleSection>
        <Projects locale="en" />
      </SectionBand>

      <!-- Stack as texture after project evidence -->
      <SignalStrip locale="en" />

      <!-- Experience -->
      <SectionBand id="experience" headingId="experience-heading" tone="tinted">
        <TitleSection id="experience-heading" index={2} total={6}>
          <BriefcaseIcon class="size-6" />
          {t.work.title}
        </TitleSection>
        <Experience locale="en" />
      </SectionBand>

      <!-- Education -->
      <SectionBand id="education" headingId="education-heading">
        <TitleSection id="education-heading" index={3} total={6}>
          <GraduationCapIcon class="size-6" />
          {t.education.title}
        </TitleSection>
        <Education locale="en" />
      </SectionBand>

      <!-- Certifications -->
      <SectionBand id="certifications" headingId="certifications-heading" tone="tinted" data-animate>
        <TitleSection id="certifications-heading" index={4} total={6}>
          <CertificateIcon class="size-6" />
          {t.certifications.title}
        </TitleSection>
        <Certifications locale="en" />
      </SectionBand>

      <!-- About -->
      <SectionBand id="about" headingId="about-heading">
        <TitleSection id="about-heading" index={5} total={6}>
          <ProfileCheckIcon class="size-6" />
          {t.about.title}
        </TitleSection>
        <AboutMe locale="en" />
      </SectionBand>

      <!-- Contact -->
      <SectionBand id="contact" headingId="contact-heading">
        <TitleSection id="contact-heading" index={6} total={6}>
          <MailIcon class="size-6" />
          {t.nav.contact}
        </TitleSection>
        <Contact locale="en" />
      </SectionBand>
  </div>
  </main>
</Layout>
