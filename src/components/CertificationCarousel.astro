---
import { Picture } from "astro:assets"
import type { CarouselCertification } from "@/types"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  certifications: CarouselCertification[]
  locale?: Locale
}

const { certifications, locale = 'es' } = Astro.props
const t = getTranslations(locale)

// Duplicate the array for seamless infinite scroll
const duplicatedCerts = [...certifications, ...certifications]
---

<div class="cert-carousel-container group/carousel relative w-full overflow-hidden py-8" id="certCarouselContainer" role="region" aria-label={t.certifications.carouselLabel}>
  <button
    class="cert-nav-btn cert-nav-prev absolute top-1/2 left-2 -translate-y-1/2 z-10 flex size-11 items-center justify-center rounded-full border border-border bg-card/92 text-foreground cursor-pointer opacity-70 backdrop-blur-[6px] transition-[opacity,background-color,transform] duration-300 hover:bg-card hover:border-primary hover:text-primary hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary focus-visible:opacity-100 active:scale-[0.92] group-hover/carousel:opacity-100"
    id="certNavPrev"
    aria-label={t.certifications.previous}
    type="button"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  </button>

  <div class="cert-carousel-wrapper scrollbar-hidden overflow-x-auto" id="certCarouselWrapper">
    <div class="cert-carousel flex w-fit gap-6 md:gap-8" id="certCarousel">
      {duplicatedCerts.map((cert, index) => {
        const { name, organization, logo, pdfUrl, category } = cert.data
        const isDuplicate = index >= certifications.length

        return (
          <a
            href={pdfUrl ?? undefined}
            target="_blank"
            rel="noopener noreferrer"
            class="cert-item group/item flex flex-col items-center gap-3 min-w-[140px] max-w-40 md:min-w-40 md:max-w-[200px] py-4 px-3 md:py-6 md:px-4 bg-card border border-border rounded-2xl no-underline outline-none cursor-pointer transition-all duration-300 hover:-translate-y-1.5 hover:scale-[1.03] hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary focus-visible:border-primary"
            title={pdfUrl ? `${name} - ${organization}` : name}
            aria-hidden={isDuplicate ? "true" : undefined}
            tabindex={isDuplicate ? "-1" : pdfUrl ? undefined : "-1"}
            data-duplicate={isDuplicate ? "true" : undefined}
            role={pdfUrl ? undefined : "presentation"}
          >
            {logo ? (
              <div class="cert-logo-wrapper flex size-16 md:size-20 items-center justify-center rounded-lg bg-background p-2 transition-transform duration-300 group-hover/item:scale-110 group-hover/item:rotate-2">
                <Picture src={logo} formats={["avif"]} fallbackFormat="webp" alt={organization} class="cert-logo size-full object-contain" width={80} height={80} densities={[1, 2]} fit="contain" loading="lazy" decoding="async" />
              </div>
            ) : (
              <div class="cert-placeholder flex size-16 md:size-20 items-center justify-center rounded-lg transition-transform duration-300 group-hover/item:scale-110 group-hover/item:rotate-2">
                <svg class="cert-icon size-10 md:size-12 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
            )}
            <span class="cert-name text-[0.8rem] md:text-sm font-semibold text-center text-foreground leading-[1.3]">{name}</span>
            <span class="cert-org text-[0.7rem] md:text-xs font-medium text-center text-muted-foreground leading-[1.2]">{organization}</span>
            {category === 'professional' && (
              <span class="cert-badge cert-badge-pro text-[0.65rem] font-semibold py-[0.15rem] px-2 rounded-full uppercase tracking-wider">{t.certifications.professional}</span>
            )}
            {category === 'academic' && (
              <span class="cert-badge cert-badge-acad text-[0.65rem] font-semibold py-[0.15rem] px-2 rounded-full uppercase tracking-wider bg-muted text-muted-foreground border border-border">{t.certifications.academic}</span>
            )}
          </a>
        )
      })}
    </div>
  </div>

  <button
    class="cert-nav-btn cert-nav-next absolute top-1/2 right-2 -translate-y-1/2 z-10 flex size-11 items-center justify-center rounded-full border border-border bg-card/92 text-foreground cursor-pointer opacity-70 backdrop-blur-[6px] transition-[opacity,background-color,transform] duration-300 hover:bg-card hover:border-primary hover:text-primary hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary focus-visible:opacity-100 active:scale-[0.92] group-hover/carousel:opacity-100"
    id="certNavNext"
    aria-label={t.certifications.next}
    type="button"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  </button>
</div>

<style>
  .cert-carousel-container {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  .cert-nav-btn {
    /* Lightning CSS does not auto-prefix Tailwind's composited backdrop-filter variable chain */
    -webkit-backdrop-filter: blur(6px);
  }

  .cert-item:hover {
    /* primary-tinted glow has no matching card-shadow token */
    box-shadow: 0 10px 30px -10px hsl(var(--primary) / 0.3);
  }

  .cert-placeholder {
    /* two-stop generative gradient, kept as-is per migration rule */
    background: linear-gradient(135deg, hsl(var(--primary) / 0.1), hsl(var(--secondary) / 0.1));
  }

  .cert-badge-pro {
    /* professional badge greens have no existing theme token */
    background: hsl(144 37% 35% / 0.12);
    color: hsl(144 45% 32%);
    border: 1px solid hsl(144 37% 35% / 0.25);
  }

  /* Reduced motion: static grid with every certification */
  @media (prefers-reduced-motion: reduce) {
    .cert-carousel-container {
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .cert-carousel-wrapper {
      overflow: visible;
      width: 100%;
    }

    .cert-carousel {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }

    .cert-item {
      animation: none;
      min-width: 140px;
    }

    .cert-item[data-duplicate="true"] {
      display: none;
    }

    .cert-nav-btn {
      display: none;
    }
  }
</style>

<script>
  let certCleanup: (() => void) | null = null

  function initCertCarousel() {
    // Clear rAF and listeners from a previous navigation
    certCleanup?.()

    const container = document.getElementById('certCarouselContainer')
    const wrapper = document.getElementById('certCarouselWrapper')
    const carousel = document.getElementById('certCarousel')
    const prevBtn = document.getElementById('certNavPrev')
    const nextBtn = document.getElementById('certNavNext')

    if (!container || !wrapper || !carousel || !prevBtn || !nextBtn) return

    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)')
    const ac = new AbortController()
    const { signal } = ac

    let animationId: number | null = null
    let lastTime = 0
    let scrollPosition = wrapper.scrollLeft
    let isInViewport = false
    const scrollSpeed = 40 // px per second
    const navScrollAmount = 350
    let scrollEndPending = false

    function isHovered() {
      return container!.matches(':hover')
    }

    function autoScroll(timestamp: number) {
      if (!lastTime) lastTime = timestamp
      const delta = (timestamp - lastTime) / 1000
      lastTime = timestamp

      if (!isHovered() && !container!.contains(document.activeElement)) {
        const w = wrapper!
        scrollPosition += scrollSpeed * delta
        w.scrollLeft = scrollPosition
        const halfWidth = w.scrollWidth / 2
        if (w.scrollLeft >= halfWidth) {
          w.scrollLeft = 0
          scrollPosition = w.scrollLeft
        }
      }

      animationId = requestAnimationFrame(autoScroll)
    }

    function startAutoScroll() {
      if (signal.aborted || animationId || !isInViewport || isHovered() || container!.contains(document.activeElement) || document.visibilityState === 'hidden' || motionPreference.matches) return
      lastTime = 0
      scrollPosition = wrapper!.scrollLeft
      animationId = requestAnimationFrame(autoScroll)
    }

    function stopAutoScroll() {
      if (animationId) {
        cancelAnimationFrame(animationId)
        animationId = null
      }
      scrollPosition = wrapper!.scrollLeft
    }

    function handleMotionChange() {
      if (motionPreference.matches) stopAutoScroll()
      else startAutoScroll()
    }
    motionPreference.addEventListener('change', handleMotionChange, { signal })

    prevBtn.addEventListener('click', () => {
      wrapper!.scrollBy({ left: -navScrollAmount, behavior: 'smooth' })
    }, { signal })

    nextBtn.addEventListener('click', () => {
      const w = wrapper!
      const halfWidth = w.scrollWidth / 2
      if (w.scrollLeft + navScrollAmount >= halfWidth && !scrollEndPending) {
        scrollEndPending = true
        w.addEventListener('scrollend', () => {
          w.scrollLeft = w.scrollLeft - halfWidth
          scrollEndPending = false
        }, { once: true, signal })
      }
      w.scrollBy({ left: navScrollAmount, behavior: 'smooth' })
    }, { signal })

    container.addEventListener('mouseenter', stopAutoScroll, { signal })
    container.addEventListener('mouseleave', startAutoScroll, { signal })
    container.addEventListener('focusin', stopAutoScroll, { signal })
    // Let focus settle before checking whether it moved to another descendant.
    container.addEventListener('focusout', () => queueMicrotask(startAutoScroll), { signal })

    function handleVisibilityChange() {
      if (document.visibilityState === 'hidden') {
        stopAutoScroll()
      } else if (!isHovered()) {
        startAutoScroll()
      }
    }
    document.addEventListener('visibilitychange', handleVisibilityChange, { signal })

    const intersectionObserver = new IntersectionObserver(([entry]) => {
      isInViewport = entry?.isIntersecting ?? false
      if (isInViewport) {
        startAutoScroll()
      } else {
        stopAutoScroll()
      }
    })
    intersectionObserver.observe(container)

    // Register cleanup for the next navigation
    certCleanup = () => {
      ac.abort()
      intersectionObserver.disconnect()
      if (animationId) {
        cancelAnimationFrame(animationId)
        animationId = null
      }
    }
  }

  document.addEventListener('DOMContentLoaded', initCertCarousel)
  document.addEventListener('astro:page-load', initCertCarousel)
</script>
