---
// El cuerpo MDX pasa por el pipeline existente sin reestructurar el contenido.
import { getCollection, render, type CollectionEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import { personalInfo } from "@/lib/data"
import { getBlogImageUrl } from "@/lib/blog-image"
import { getProjectSocialImage } from "@/lib/portfolio-images"
import { createBlogAlternates } from "@/lib/blog-alternates"
import { getTranslations, type Locale } from "@/lib/i18n"
import { formatDate, formatMonthYear } from "@/lib/utils"

interface Props {
  locale: Locale
  post: CollectionEntry<"blog">
  isFallback?: boolean
  translationId?: string
}

const HIDDEN_POST_SLUG = "rapido-sur-erp-mantenimiento-flotas"
const READING_WORDS_PER_MINUTE = 220

const { locale, post, isFallback = false, translationId } = Astro.props
const { Content, headings } = await render(post)
const isEnglish = locale === "en"
const t = getTranslations(locale)
const spanishUrl = `https://sebita.dev/blog/${post.id}`
const englishUrl = `https://sebita.dev/en/blog/${post.id}`
const canonicalUrl = isEnglish && !isFallback ? englishUrl : spanishUrl
const alternates = createBlogAlternates({ locale, postId: post.id, translationId, isFallback })
const optimizedImageUrl = await getBlogImageUrl(post.data.image)
const heroImage = getProjectSocialImage(post.data.image)
const heroImageWidth = heroImage && Math.min(heroImage.width, 1200)
const heroImageHeight = heroImage && heroImageWidth && Math.round((heroImage.height * heroImageWidth) / heroImage.width)
const imageUrl = optimizedImageUrl && new URL(optimizedImageUrl, "https://sebita.dev").toString()
const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  ...(imageUrl && { image: imageUrl }),
  datePublished: post.data.publishDate.toISOString(),
  author: {
    "@type": "Person",
    name: personalInfo.name,
    url: "https://sebita.dev",
  },
  publisher: {
    "@type": "Organization",
    name: personalInfo.name,
  },
}).replace(/</g, "\\u003c")
const homePath = isEnglish ? "/en" : "/"
const blogPath = isEnglish ? "/en/blog" : "/blog"
const prefix = isEnglish ? "/en" : ""
const toc = headings.filter((heading) => heading.depth === 2)
const readingMinutes = Math.max(
  1,
  Math.round((post.body ?? "").split(/\s+/).filter(Boolean).length / READING_WORDS_PER_MINUTE),
)
const visiblePosts = (await getCollection("blog"))
  .filter((p) => (isEnglish ? ["en", "es"].includes(p.data.locale ?? "es") : (p.data.locale ?? "es") === "es"))
  .filter((p) => p.id !== HIDDEN_POST_SLUG)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
const currentIndex = visiblePosts.findIndex((p) => p.id === post.id)
const newer = currentIndex > 0 ? visiblePosts[currentIndex - 1] : undefined
const older = currentIndex >= 0 && currentIndex < visiblePosts.length - 1 ? visiblePosts[currentIndex + 1] : undefined
---

<Layout
  title={`${post.data.title} - ${personalInfo.name}`}
  description={post.data.description}
  image={imageUrl}
  locale={locale}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
>
  <main id="main-content">
    <article lang={isEnglish ? (isFallback ? "es" : "en") : undefined}>
      <header>
        <nav aria-label={t.nav.breadcrumb}>
          <ol>
            <li><a href={homePath}>{t.nav.home}</a></li>
            <li><a href={blogPath}>{t.blog.title}</a></li>
            <li lang={isFallback ? "es" : undefined} aria-current="page">{post.data.title}</li>
          </ol>
        </nav>
        <h1>{post.data.title}</h1>
        <p>
          <time lang={locale} datetime={post.data.publishDate.toISOString()}>
            {formatDate(post.data.publishDate, locale)}
          </time>
          · {readingMinutes}
          {t.blog.readingTime} · {post.data.tags.join(", ")}
        </p>
        {
          isEnglish && isFallback && (
            <aside lang={locale} role="note">
              {t.blog.fallbackNotice}
            </aside>
          )
        }
        {
          optimizedImageUrl && heroImage && (
            <img
              src={optimizedImageUrl}
              alt={post.data.title}
              width={heroImageWidth}
              height={heroImageHeight}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          )
        }
      </header>
      <section aria-label={t.blog.articleBodyLabel}>
        {
          toc.length > 0 && (
            <nav aria-label={t.blog.tocTitle}>
              <h2>{t.blog.tocTitle}</h2>
              <ul>
                {toc.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <Content />
      </section>
      <nav aria-label={t.blog.postNavigation}>
        {
          (newer || older) && (
            <ul>
              {newer && (
                <li>
                  {t.blog.newer}: <a href={`${prefix}/blog/${newer.id}`}>{newer.data.title}</a>{" "}
                  <time datetime={newer.data.publishDate.toISOString().slice(0, 10)}>
                    {formatMonthYear(newer.data.publishDate, locale)}
                  </time>
                </li>
              )}
              {older && (
                <li>
                  {t.blog.older}: <a href={`${prefix}/blog/${older.id}`}>{older.data.title}</a>{" "}
                  <time datetime={older.data.publishDate.toISOString().slice(0, 10)}>
                    {formatMonthYear(older.data.publishDate, locale)}
                  </time>
                </li>
              )}
            </ul>
          )
        }
        <a href={blogPath}>{`← ${t.blog.back}`}</a>
        <a href={homePath}>{`${t.nav.home} →`}</a>
      </nav>
    </article>
  </main>

  <script is:inline type="application/ld+json" set:html={articleJsonLd} />
</Layout>
