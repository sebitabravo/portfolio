---
import Layout from "@/layouts/Layout.astro"
import Button from "@/components/ui/Button.astro"
import { personalInfo } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
const homeUrl = locale === "es" ? "/" : "/en"
---

<Layout
  title={`404 | ${personalInfo.name}`}
  description={t.error404.description}
  locale={locale}
  canonicalUrl={locale === "es" ? "https://sebita.dev/404" : "https://sebita.dev/en/404"}
  noindex
>
  <main id="main-content" class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center gap-6 px-4 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted-foreground">Error 404</p>
    <h1 class="text-4xl font-bold text-foreground md:text-5xl">{t.error404.heading}</h1>
    <p class="max-w-xl text-foreground/80">{t.error404.message}</p>
    <Button href={homeUrl} variant="default" size="lg">{t.error404.backHome}</Button>
  </main>
</Layout>
