---
import { Picture } from "astro:assets"
import type { CarouselCertification } from "@/types"
import { getTranslations, type Locale } from "@/lib/i18n"

interface Props {
  certifications: CarouselCertification[]
  locale?: Locale
}

const { certifications, locale = "es" } = Astro.props
const t = getTranslations(locale)

// Duplicate the array for seamless infinite scroll
const duplicatedCerts = [...certifications, ...certifications]
---

<div
  class="cert-carousel-container relative w-full overflow-hidden py-8"
  id="certCarouselContainer"
  role="region"
  aria-label={t.certifications.carouselLabel}
>
  <button
    class="cert-nav-btn cert-nav-prev absolute top-1/2 left-2 z-10 flex h-11 w-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-border bg-card/92 text-foreground opacity-70"
    id="certNavPrev"
    aria-label={t.certifications.previous}
    type="button"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg
    >
  </button>

  <div class="cert-carousel-wrapper scrollbar-hidden overflow-x-auto" id="certCarouselWrapper">
    <div class="cert-carousel flex w-fit gap-6 md:gap-8" id="certCarousel">
      {
        duplicatedCerts.map((cert, index) => {
          const { name, organization, logo, pdfUrl, category } = cert.data
          const isDuplicate = index >= certifications.length

          return (
            <a
              href={pdfUrl ?? undefined}
              target="_blank"
              rel="noopener noreferrer"
              class="cert-item flex max-w-[160px] min-w-[140px] cursor-pointer flex-col items-center gap-3 rounded-2xl border border-border bg-card px-3 py-4 no-underline outline-none md:max-w-[200px] md:min-w-[160px] md:px-4 md:py-6"
              title={pdfUrl ? `${name} - ${organization}` : name}
              aria-hidden={isDuplicate ? "true" : undefined}
              tabindex={isDuplicate ? "-1" : pdfUrl ? undefined : "-1"}
              data-duplicate={isDuplicate ? "true" : undefined}
              role={pdfUrl ? undefined : "presentation"}
            >
              {logo ? (
                <div class="cert-logo-wrapper flex h-16 w-16 items-center justify-center rounded-lg bg-background p-2 md:h-20 md:w-20">
                  <Picture
                    src={logo}
                    formats={["avif"]}
                    fallbackFormat="webp"
                    alt={organization}
                    class="cert-logo h-full w-full object-contain"
                    width={80}
                    height={80}
                    densities={[1, 2]}
                    fit="contain"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : (
                <div class="cert-placeholder flex h-16 w-16 items-center justify-center rounded-lg md:h-20 md:w-20">
                  <svg
                    class="cert-icon h-10 w-10 text-primary md:h-12 md:w-12"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                </div>
              )}
              <span class="cert-name text-center text-[0.8rem] leading-[1.3] font-semibold text-foreground md:text-sm">
                {name}
              </span>
              <span class="cert-org text-center text-[0.7rem] leading-[1.2] font-medium text-muted-foreground md:text-xs">
                {organization}
              </span>
              {category === "professional" && (
                <span class="cert-badge cert-badge-pro rounded-full border border-cert-pro-border bg-cert-pro-bg px-2 py-[0.15rem] text-[0.65rem] font-semibold tracking-[0.05em] text-cert-pro-text uppercase">
                  {t.certifications.professional}
                </span>
              )}
              {category === "academic" && (
                <span class="cert-badge cert-badge-acad rounded-full border border-border bg-muted px-2 py-[0.15rem] text-[0.65rem] font-semibold tracking-[0.05em] text-muted-foreground uppercase">
                  {t.certifications.academic}
                </span>
              )}
            </a>
          )
        })
      }
    </div>
  </div>

  <button
    class="cert-nav-btn cert-nav-next absolute top-1/2 right-2 z-10 flex h-11 w-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-border bg-card/92 text-foreground opacity-70"
    id="certNavNext"
    aria-label={t.certifications.next}
    type="button"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg
    >
  </button>
</div>

<style>
  /* Edge fade masks stay scoped: they shape this carousel only. */
  .cert-carousel-container {
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  /* Layout sizing lives in utilities above; interaction visuals stay scoped. */
  .cert-item {
    transition: all 0.3s ease;
  }

  .cert-item:hover {
    transform: translateY(-6px) scale(1.03);
    border-color: hsl(var(--primary));
    box-shadow: 0 10px 30px -10px hsl(var(--primary) / 0.3);
  }

  .cert-item:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
    border-color: hsl(var(--primary));
  }

  .cert-logo-wrapper {
    transition: transform 0.3s ease;
  }

  .cert-placeholder {
    background: linear-gradient(135deg, hsl(var(--primary) / 0.1), hsl(var(--secondary) / 0.1));
    transition: transform 0.3s ease;
  }

  .cert-item:hover .cert-logo-wrapper,
  .cert-item:hover .cert-placeholder {
    transform: scale(1.1) rotate(2deg);
  }

  .cert-nav-btn {
    transition:
      opacity 0.3s ease,
      background 0.2s ease,
      transform 0.2s ease;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .cert-nav-btn:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
    opacity: 1;
  }

  .cert-nav-btn:hover {
    background: hsl(var(--card));
    border-color: hsl(var(--primary));
    color: hsl(var(--primary));
    opacity: 1;
  }

  .cert-carousel-container:hover .cert-nav-btn {
    opacity: 1;
  }

  .cert-nav-btn:active {
    transform: translateY(-50%) scale(0.92);
  }

  /* Reduced motion: static grid with every certification */
  @media (prefers-reduced-motion: reduce) {
    .cert-carousel-container {
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .cert-carousel-wrapper {
      overflow: visible;
      width: 100%;
    }

    .cert-carousel {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }

    .cert-item {
      animation: none;
      min-width: 140px;
    }

    .cert-item[data-duplicate="true"] {
      display: none;
    }

    .cert-nav-btn {
      display: none;
    }
  }
</style>

<script>
  import { initCertCarousel } from "@/scripts/cert-carousel"

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCertCarousel, { once: true })
  } else {
    initCertCarousel()
  }
  document.addEventListener("astro:page-load", initCertCarousel)
</script>
