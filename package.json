{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "sharp"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "rm -rf dist && astro check && bun run verify:limits && bun run build:static && bun run verify:bundle && bun run verify:csp",
    "build:ci": "rm -rf dist && bun run verify:limits && bun run build:static && bun run verify:bundle && bun run verify:csp",
    "build:static": "env -u VERCEL -u PUBLIC_VERCEL_OBSERVABILITY_BASEPATH -u PUBLIC_VERCEL_OBSERVABILITY_CLIENT_CONFIG astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:links": "bun scripts/validate-project-links.ts",
    "generate:og": "bun scripts/generate-og-images.ts",
    "verify:bundle": "bun scripts/check-bundle-size.ts",
    "verify:csp": "bun scripts/verify-csp-hashes.ts",
    "update:csp": "bun scripts/update-csp-hashes.ts",
    "update:csp:write": "bun scripts/update-csp-hashes.ts --write",
    "verify:limits": "bun scripts/check-source-limits.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.4.7",
    "astro-seo": "^1.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "3.2.6",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "fast-uri": ">=4.2.3",
    "ajv": ">=8.18.0",
    "yaml": ">=2.8.3",
    "devalue": "5.9.3",
    "vite": ">=8.2.4",
    "picomatch": ">=4.0.4",
    "js-yaml": "4.3.2",
    "nanoid": ">=3.3.18",
    "postcss": ">=8.5.23",
    "svgo": ">=4.1.0",
    "http-cache-semantics": ">=4.3.0",
    "smol-toml": ">=1.9.0",
    "source-map-js": ">=1.2.2",
    "undici": ">=8.12.2",
    "zod": ">=4.6.6"
  }
}
