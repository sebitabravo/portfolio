---
// Hero: a recruiter-readable first viewport with one clear message and a cinematic visual layer.
import { Image } from "astro:assets"
import { personalInfo } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import profileImage from "@/assets/perfil.jpeg"
import MailIcon from "./icons/Mail.astro"

interface Props {
  locale?: Locale
}

const { locale = 'es' } = Astro.props
const t = getTranslations(locale)
const contactUrl = locale === 'es' ? '#contacto' : '#contact'
const heroTitleId = `hero-title-${locale}`
---

<section class="hero-gradient w-full overflow-hidden" aria-labelledby={heroTitleId} data-portfolio-motion>
  <div class="hero-ambient hero-ambient-one" aria-hidden="true"></div>
  <div class="hero-ambient hero-ambient-two" aria-hidden="true"></div>

  <div class="container-custom hero-inner">
    <div class="hero-layout">
      <div class="hero-copy">
        <div class="hero-kicker hero-reveal hero-reveal-1">
          <span>{t.hero.greeting}</span>
          <span class="hero-kicker-line" aria-hidden="true"></span>
        </div>

        <h1 id={heroTitleId} class="hero-title hero-reveal hero-reveal-2">
          <span class="hero-title-name">Sebastian</span>
          <span class="hero-title-name hero-title-accent text-gradient">Bravo</span>
          <span class="hero-title-role"><span aria-hidden="true">· </span>{personalInfo.title}</span>
        </h1>

        <p class="hero-role hero-reveal hero-reveal-3">{t.hero.specialization}</p>

        <p class="hero-lede hero-reveal hero-reveal-4">{t.hero.intro}</p>

        <p class="hero-proof hero-reveal hero-reveal-5">
          <span class="hero-proof-mark" aria-hidden="true">↳</span>
          {t.hero.proof}
        </p>

        <div class="hero-actions hero-reveal hero-reveal-6">
          <a href={contactUrl} class="btn-primary hero-btn-primary focus-ring" aria-label={t.hero.contact}>
            <MailIcon class="size-4" />
            <span>{t.hero.contact}</span>
            <span class="hero-btn-arrow" aria-hidden="true">↗</span>
          </a>
        </div>

        <ul class="hero-meta hero-reveal hero-reveal-7" aria-label={t.hero.metaLabel}>
          {personalInfo.available && (
            <li class="hero-meta-status">
              <span class="hero-meta-pulse" aria-hidden="true"></span>
              {t.hero.available}
            </li>
          )}
          <li class="hero-meta-item">{t.hero.language}</li>
          <li class="hero-meta-item">{t.hero.roleLocation}</li>
          <li class="hero-meta-item">{t.hero.level}</li>
        </ul>
      </div>

      <div class="hero-art hero-reveal hero-reveal-3" aria-hidden="true">
        <div class="hero-art-frame">
          <div class="hero-art-grid"></div>
          <canvas class="hero-webgl" data-hero-webgl aria-hidden="true"></canvas>
          <div class="hero-art-crosshair hero-art-crosshair-top"></div>
          <div class="hero-art-crosshair hero-art-crosshair-bottom"></div>
          <div class="hero-orbit hero-orbit-one"></div>
          <div class="hero-orbit hero-orbit-two"></div>
          <div class="hero-orbit-dot hero-orbit-dot-one"></div>
          <div class="hero-orbit-dot hero-orbit-dot-two"></div>
          <div class="hero-portrait-shell">
            <Image
              src={profileImage}
              alt=""
              width={320}
              height={320}
              sizes="(max-width: 767px) 210px, (max-width: 1024px) 280px, 320px"
              format="webp"
              quality={90}
              loading="eager"
              fetchpriority="high"
              class="hero-portrait"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Fallback de contrato: si el modulo de motion no logra cargar (gates de
  // red, parse lento del chunk de three.js, browser sin soporte), el estado
  // pasa a fallback en vez de quedar en loading indefinidamente. Inline a
  // proposito: no depende de imports dinamicos ni de APIs opcionales.
  ;(() => {
    const root = document.querySelector("[data-portfolio-motion]")
    const canvas = root?.querySelector("[data-hero-webgl]")
    if (!root) return
    window.setTimeout(() => {
      if (root.dataset.motionStatus === "loading") root.dataset.motionStatus = "fallback"
      if (canvas?.dataset.webglStatus === "pending") canvas.dataset.webglStatus = "fallback"
    }, 3000)
  })()
</script>

<script>
  import { trackEvent } from "@/lib/analytics"
  import { setupPortfolioMotion, teardownPortfolioMotion } from "@/scripts/portfolio-motion"

  const setupPortfolioTracking = () => {
    document.querySelectorAll<HTMLElement>('[data-track-social]').forEach((el) => {
      if (el.dataset.trackBound === 'true') return
      el.dataset.trackBound = 'true'
      el.addEventListener('click', () => {
        trackEvent({ name: 'social_click', props: { platform: el.dataset.trackSocial ?? '' } })
      })
    })

    document.querySelectorAll<HTMLElement>('[data-track-cv]').forEach((el) => {
      if (el.dataset.trackBound === 'true') return
      el.dataset.trackBound = 'true'
      el.addEventListener('click', () => {
        trackEvent({ name: 'cv_download', props: { locale: el.dataset.trackCv ?? '' } })
      })
    })
  }

  setupPortfolioTracking()
  setupPortfolioMotion()
  document.addEventListener('astro:page-load', setupPortfolioTracking)
  document.addEventListener('astro:page-load', setupPortfolioMotion)
  document.addEventListener('astro:before-swap', teardownPortfolioMotion)
</script>
