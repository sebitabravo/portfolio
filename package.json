{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "rm -rf dist && astro check && pnpm verify:limits && astro build && pnpm verify:csp",
    "build:ci": "rm -rf dist && pnpm verify:limits && astro build && pnpm verify:csp",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:links": "pnpm exec tsx scripts/validate-project-links.ts",
    "verify:csp": "pnpm exec tsx scripts/verify-csp-hashes.ts",
    "verify:limits": "pnpm exec tsx scripts/check-source-limits.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.2.2",
    "astro-seo": "^1.1.0",
    "clsx": "^2.1.1",
    "gsap": "3.15.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.55.0",
    "@types/three": "0.185.1",
    "@vitest/coverage-v8": "3.2.6",
    "happy-dom": "20.11.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.5",
      "ajv": ">=8.18.0",
      "yaml": ">=2.8.3",
      "devalue": "5.8.1",
      "rollup": ">=4.59.0",
      "vite": ">=7.3.5",
      "picomatch": ">=4.0.4",
      "esbuild": ">=0.28.1",
      "js-yaml": ">=4.3.1",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.23",
      "svgo": ">=4.0.2"
    },
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "auditConfig": {
      "ignoreCves": []
    }
  }
}
