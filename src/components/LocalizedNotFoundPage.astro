---
import Layout from "@/layouts/Layout.astro"
import { personalInfo } from "@/lib/data"
import { getTranslations, type Locale } from "@/lib/i18n"
import { homeSectionFragment } from "@/lib/home-sections"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
const homeUrl = locale === "es" ? "/" : "/en"
const blogUrl = `${homeUrl}blog`
---

<Layout
  title={`404 | ${personalInfo.name}`}
  description={t.error404.description}
  locale={locale}
  canonicalUrl={locale === "es" ? "https://sebita.dev/404" : "https://sebita.dev/en/404"}
  noindex
>
  <main id="main-content">
    <nav aria-label={t.nav.breadcrumb}>
      <ol>
        <li><a href={homeUrl}>{t.nav.home}</a></li>
        <li aria-current="page">{t.error404.crumb}</li>
      </ol>
    </nav>
    <h1>{t.error404.heading}</h1>
    <p>{t.error404.message}</p>
    <p>
      <a href={homeUrl}>{t.error404.backHome}</a>
      <a href={blogUrl}>{t.error404.viewBlog}</a>
    </p>
    <ul>
      <li><a href={`${homeUrl}${homeSectionFragment(locale, "work")}`}>{t.nav.projects}</a></li>
      <li><a href={`${homeUrl}${homeSectionFragment(locale, "contact")}`}>{t.nav.contact}</a></li>
      <li><a href={`${homeUrl}links`}>{t.nav.links}</a></li>
    </ul>
  </main>
</Layout>
